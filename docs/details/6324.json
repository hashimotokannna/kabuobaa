化・注目開示などの注目銘柄のみ、毎晩の実行で場中の5分足を取得して分析します）。</div><div class=\"spwrap\"><div class=\"nhead\">値動きと長期支持帯<span class=\"spbtns\"><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, '1')\">1年</button><button type=\"button\" class=\"spbtn on\" onclick=\"spSwap(this, '3')\">3年</button><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, '10')\">10年</button><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, 'all')\">全期間(27年)</button></span></div><div class=\"spark spv\" data-sp=\"1\" style=\"display:none\"><svg viewBox=\"0 0 320 110\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:100%; height:auto; background:#fffdf6; border-radius:8px;\"><rect x=\"0\" y=\"84.5\" width=\"320\" height=\"2.5\" fill=\"#c62f2f\" opacity=\"0.12\"/><polyline points=\"4.0,97.2 9.1,93.3 14.2,89.1 19.3,80.9 24.5,79.8 29.6,82.1 34.7,83.5 39.8,82.9 44.9,82.9 50.0,79.6 55.1,79.5 60.3,83.7 65.4,85.4 70.5,84.5 75.6,78.6 80.7,80.9 85.8,69.9 91.0,70.4 96.1,80.0 101.2,74.7 106.3,75.7 111.4,76.7 116.5,82.0 121.6,80.0 126.8,75.4 131.9,71.8 137.0,73.9 142.1,61.3 147.2,45.7 152.3,36.4 157.4,43.7 162.6,26.5 167.7,36.3 172.8,35.6 177.9,43.7 183.0,27.6 188.1,26.8 193.2,27.3 198.4,12.8 203.5,26.1 208.6,35.1 213.7,39.5 218.8,58.4 223.9,39.9 229.0,46.0 234.2,44.2 239.3,55.0 244.4,53.9 249.5,60.0 254.6,55.0 259.7,53.2 264.9,48.3 270.0,45.0 275.1,42.3 280.2,48.1 285.3,59.6 290.4,65.9 295.5,57.2 300.7,65.1 305.8,66.2 310.9,71.7 316.0,81.1\" fill=\"none\" stroke=\"#1c1c1e\" stroke-width=\"1.6\"/><path d=\"M 4.0 109.2 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 4.0 109.2 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 29.6 94.1 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 65.4 97.4 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 116.5 94.0 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><circle cx=\"316.0\" cy=\"81.1\" r=\"4\" fill=\"#1c1c1e\"/></svg></div><div class=\"spark spv\" data-sp=\"3\" style=\"display:\"><svg viewBox=\"0 0 320 110\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:1