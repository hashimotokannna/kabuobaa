み、毎晩の実行で場中の5分足を取得して分析します）。</div><div class=\"spwrap\"><div class=\"nhead\">値動きと長期支持帯<span class=\"spbtns\"><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, '1')\">1年</button><button type=\"button\" class=\"spbtn on\" onclick=\"spSwap(this, '3')\">3年</button><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, '10')\">10年</button><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, 'all')\">全期間(13年)</button></span></div><div class=\"spark spv\" data-sp=\"1\" style=\"display:none\"><svg viewBox=\"0 0 320 110\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:100%; height:auto; background:#fffdf6; border-radius:8px;\"><polyline points=\"4.0,88.4 9.1,84.8 14.2,77.8 19.3,74.8 24.5,78.8 29.6,78.8 34.7,75.8 39.8,73.5 44.9,72.5 50.0,72.5 55.1,66.9 60.3,71.0 65.4,71.5 70.5,87.4 75.6,74.5 80.7,67.5 85.8,68.2 91.0,71.2 96.1,55.6 101.2,68.0 106.3,73.8 111.4,76.8 116.5,84.6 121.6,97.2 126.8,87.4 131.9,81.1 137.0,72.5 142.1,76.0 147.2,80.1 152.3,72.7 157.4,74.5 162.6,72.7 167.7,66.7 172.8,75.3 177.9,68.7 183.0,69.7 188.1,61.9 193.2,71.2 198.4,70.7 203.5,63.9 208.6,63.4 213.7,56.4 218.8,57.4 223.9,55.6 229.0,41.5 234.2,41.5 239.3,38.2 244.4,34.4 249.5,30.7 254.6,30.9 259.7,36.5 264.9,42.0 270.0,26.1 275.1,30.7 280.2,28.9 285.3,22.8 290.4,24.6 295.5,27.4 300.7,35.2 305.8,32.7 310.9,23.8 316.0,12.8\" fill=\"none\" stroke=\"#1c1c1e\" stroke-width=\"1.6\"/><circle cx=\"316.0\" cy=\"12.8\" r=\"4\" fill=\"#1c1c1e\"/></svg></div><div class=\"spark spv\" data-sp=\"3\" style=\"display:\"><svg viewBox=\"0 0 320 110\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:100%; height:auto; background:#fffdf6; border-radius:8px;\"><polyline points=\"4.0,85.3 6.1,88.8 8.3,87.2 10.4,83.3 12.5,84.2 14.7,81.1 16.8,81.3 19.0,77.3 21.1,77.3 23.2,80.4 25.4,79.2 27.5,82.6 29.6,79.1 31.8,81.1 33.9,75.6 36.1,70.6 38.2,76.5 40.3,80.6 42.5,83.0 44.6,81.8 46.7,86.1 48.9,88.1 51.0,89.1 53.2,87.6 55.3,86.3 57.4,87.5 59.6,89.5 61.7,90.4 63.8,85.3 66.0,88.4 68.1,89.0 70.2,83.3