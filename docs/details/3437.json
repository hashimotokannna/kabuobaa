）</div><div class=\"discnote\">この銘柄は本日の分析対象外です（今夜の厳選・出尽くしサイン・レーティング変化・注目開示などの注目銘柄のみ、毎晩の実行で場中の5分足を取得して分析します）。</div><div class=\"spwrap\"><div class=\"nhead\">値動きと長期支持帯<span class=\"spbtns\"><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, '1')\">1年</button><button type=\"button\" class=\"spbtn on\" onclick=\"spSwap(this, '3')\">3年</button><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, '10')\">10年</button><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, 'all')\">全期間(20年)</button></span></div><div class=\"spark spv\" data-sp=\"1\" style=\"display:none\"><svg viewBox=\"0 0 320 110\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:100%; height:auto; background:#fffdf6; border-radius:8px;\"><rect x=\"0\" y=\"91.8\" width=\"320\" height=\"5.400000000000006\" fill=\"#c62f2f\" opacity=\"0.12\"/><polyline points=\"4.0,61.2 9.1,70.5 14.2,68.1 19.3,58.8 24.5,58.5 29.6,12.8 34.7,41.2 39.8,44.9 44.9,33.5 50.0,35.6 55.1,33.8 60.3,28.5 65.4,20.2 70.5,25.4 75.6,29.1 80.7,37.2 85.8,36.9 91.0,40.0 96.1,46.2 101.2,53.0 106.3,55.7 111.4,58.0 116.5,58.2 121.6,64.8 126.8,64.7 131.9,51.4 137.0,53.6 142.1,49.9 147.2,49.2 152.3,42.1 157.4,52.6 162.6,73.1 167.7,70.5 172.8,70.8 177.9,71.0 183.0,77.5 188.1,76.1 193.2,77.0 198.4,76.1 203.5,78.9 208.6,76.9 213.7,75.5 218.8,72.3 223.9,73.6 229.0,68.5 234.2,77.6 239.3,71.5 244.4,71.5 249.5,71.9 254.6,73.6 259.7,75.1 264.9,77.1 270.0,76.3 275.1,73.7 280.2,79.4 285.3,81.4 290.4,81.7 295.5,80.8 300.7,83.1 305.8,83.6 310.9,84.6 316.0,78.1\" fill=\"none\" stroke=\"#1c1c1e\" stroke-width=\"1.6\"/><path d=\"M 4.0 73.2 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 4.0 73.2 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 4.0 73.2 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 4.0 73.2 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 4.0 73.2 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 4.0 73.2 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 4.0 73.2 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><circle cx=\"316.0\"