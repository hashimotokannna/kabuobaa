の5分足を取得して分析します）。</div><div class=\"spwrap\"><div class=\"nhead\">値動きと長期支持帯<span class=\"spbtns\"><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, '1')\">1年</button><button type=\"button\" class=\"spbtn on\" onclick=\"spSwap(this, '3')\">3年</button><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, '10')\">10年</button><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, 'all')\">全期間(26年)</button></span></div><div class=\"spark spv\" data-sp=\"1\" style=\"display:none\"><svg viewBox=\"0 0 320 110\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:100%; height:auto; background:#fffdf6; border-radius:8px;\"><rect x=\"0\" y=\"68.0\" width=\"320\" height=\"15.200000000000003\" fill=\"#c62f2f\" opacity=\"0.12\"/><polyline points=\"4.0,54.7 9.1,52.2 14.2,45.9 19.3,30.3 24.5,52.1 29.6,56.4 34.7,27.3 39.8,38.5 44.9,36.9 50.0,35.2 55.1,49.9 60.3,42.4 65.4,31.4 70.5,24.8 75.6,25.6 80.7,20.5 85.8,12.8 91.0,25.0 96.1,32.9 101.2,36.0 106.3,27.9 111.4,26.8 116.5,38.6 121.6,45.2 126.8,28.1 131.9,36.7 137.0,35.7 142.1,38.2 147.2,47.8 152.3,52.7 157.4,47.9 162.6,55.9 167.7,55.4 172.8,64.2 177.9,70.8 183.0,74.2 188.1,75.8 193.2,76.2 198.4,79.4 203.5,97.2 208.6,86.3 213.7,84.0 218.8,78.7 223.9,91.3 229.0,90.1 234.2,82.0 239.3,75.1 244.4,73.0 249.5,79.7 254.6,53.3 259.7,63.0 264.9,54.0 270.0,69.7 275.1,59.9 280.2,52.1 285.3,61.3 290.4,63.1 295.5,67.5 300.7,66.7 305.8,83.9 310.9,86.7 316.0,77.9\" fill=\"none\" stroke=\"#1c1c1e\" stroke-width=\"1.6\"/><path d=\"M 4.0 66.7 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 4.0 66.7 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 183.0 86.2 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 249.5 91.7 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 270.0 81.7 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><circle cx=\"316.0\" cy=\"77.9\" r=\"4\" fill=\"#1c1c1e\"/></svg></div><div class=\"spark spv\" data-sp=\"3\" style=\"display:\"><svg viewBox=\"0 0 320 110\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:100%; heig