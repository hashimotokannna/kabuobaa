=\"left:35.0%; width:15.0%; background:#f5e6b3\"></div><div class=\"mz\" style=\"left:50.0%; width:50.0%; background:#f2c4a8\"></div><div class=\"mpin\" style=\"left:27.9%\"></div></div><span class=\"mv num\">2.8%</span></div><div class=\"mrow\"><span class=\"ml\">HV(年率変動)</span><div class=\"mtrack\"><div class=\"mz\" style=\"left:0.0%; width:20.8%; background:#b9dcc0\"></div><div class=\"mz\" style=\"left:20.8%; width:12.5%; background:#eeeae0\"></div><div class=\"mz\" style=\"left:33.3%; width:16.7%; background:#f5e6b3\"></div><div class=\"mz\" style=\"left:50.0%; width:50.0%; background:#f2c4a8\"></div><div class=\"mpin\" style=\"left:20.1%\"></div></div><span class=\"mv num\">24%</span></div><div class=\"mrow\"><span class=\"ml\">OBV(20日)</span><div class=\"mtrack\"><div class=\"mz\" style=\"left:0.0%; width:40.0%; background:#f2c4a8\"></div><div class=\"mz\" style=\"left:40.0%; width:10.0%; background:#f5e6b3\"></div><div class=\"mz\" style=\"left:50.0%; width:10.0%; background:#eeeae0\"></div><div class=\"mz\" style=\"left:60.0%; width:40.0%; background:#b9dcc0\"></div><div class=\"mpin\" style=\"left:42.6%\"></div></div><span class=\"mv num\">-7%</span></div><div class=\"mrow\"><span class=\"ml\">自己資本比率</span><div class=\"mtrack\"><div class=\"mz\" style=\"left:0.0%; width:20.0%; background:#f2c4a8\"></div><div class=\"mz\" style=\"left:20.0%; width:15.0%; background:#f5e6b3\"></div><div class=\"mz\" style=\"left:35.0%; width:15.0%; background:#eeeae0\"></div><div class=\"mz\" style=\"left:50.0%; width:50.0%; background:#b9dcc0\"></div><div class=\"mpin\" style=\"left:64.2%\"></div></div><span class=\"mv num\">64%</span></div><div class=\"mrow\"><span class=\"ml\">営業利益率</span><div class=\"mtrack\"><div class=\"mz\" style=\"left:0.0%; width:25.0%; background:#f2c4a8\"></div><div class=\"mz\" style=\"left:25.0%; width:12.5%; background:#f5e6b3\"></div><div class=\"mz\" style=\"left:37.5%; width:12.5%; background:#eeeae0\"></div><div class=\"mz\" style=\"left:50.0%; width:50.0%; background:#b9dcc0\"></div><div class=\"mpin\" style=\"left:57.0%\"></div></div><span class=\"mv num\">12.8%</span></div><div class=\"mrow\"><span class=\"ml\">ROA</span><div class=\"mtrack\"><div class=\"mz\" style=\"left:0.0%; width:20.0%; background:#f2c4a8\"></div><div class=\"mz\" style=\"left:20.0%; width:8.0%; background:#f5e6b3\"></div><div class=\"mz\" style=\"left:28.0%; width:12.0%; background:#eeeae0\"></div><div class=\"mz\" style=\"left:40.0%; width:60.0%; background:#b9dcc0\"></div><div class=\"mpin\" style=\"left:25.6%\"></div></div><span class=\"mv num\">1.4%</span></div><div class=\"mrow\"><span class=\"ml\">配当性向</span><div class=\"mtrack\"><div class=\"mz\" style=\"left:0.0%; width:20.0%; background:#eeeae0\"></div><div class=\"mz\" style=\"left:20.0%; width:20.0%; background:#b9dcc0\"></div><div class=\"mz\" style=\"left:40.0%; width:26.7%; background:#f5e6b3\"></div><div class=\"mz\" style=\"left:66.7%; width:33.3%; background:#f2c4a8\"></div><div class=\"mpin\" style=\"left:64.3%\"></div></div><span class=\"mv num\">96%</span></div><div class=\"mrow\"><span class=\"ml\">PEG</span><div class=\"mtrack\"><div class=\"mz\" style=\"left:0.0%; width:20.0%; background:#c9dcf3\"></div><div class=\"mz\" style=\"left:20.0%; width:20.0%; background:#b9dcc0\"></div><div class=\"mz\" style=\"left:40.0%; width:20.0%; background:#f5e6b3\"></div><div class=\"mz\" style=\"left:60.0%; width:40.0%; background:#f2c4a8\"></div><div class=\"mpin\" style=\"left:3.4%\"></div></div><span class=\"mv num\">0.17</span></div></div><div class=\"discnote\">ピンが現在値。PER・PBRなど価値系は「標準」が最も安心、割安は魅力だが「割安の罠」の確認が必要。RSI・ボリンジャーなど行きすぎ系は売られすぎ側が押し目買いに有利。読み方は「指標の読み方」ページへ。</div><div class=\"nhead\">候補33位 ・ スコア 157点</div><div class=\"reason\">・直近20日高値から −8.4%（安さの主基準 +64点・8%で頭打ち）</div><div class=\"reason\">・普段の値段（20日平均）より 4.1%安い（+16点）</div><div class=\"reason\">・下げはやや急だが崩落型ではない（+5点）</div><div class=\"reason\">・日々の値動きが±1.5%と穏やかで読みやすい（+10点）</div><div class=\"reason\">・200日平均線より上での下げ＝上昇トレンド中の一時的な押し目（+20点）</div><div class=\"reason\">・1年高値からの下落 −9% で長期トレンド健全（+12点）</div><div class=\"reason\">・過去1年、同じ買い方で 1回 利確ライン（+5%）に到達（+5点）</div><div class=\"reason\">・利確まで平均 104営業日と資金拘束が長め。短期回転スタイルでは機会損失（−5点）</div><div class=\"reason\">・ただし直近の仮想買いが塩漬け中（−15点）</div><div class=\"reason\">・長期支持帯 3,609円付近は過去6回試されており、今回で7回目。支持線は試されるほど割れやすい（−5点・警戒）</div><div class=\"reason\">・50日線が200日線の上（ゴールデンクロス継続中の長期上昇形 +10点）</div><div class=\"reason\">・RSI(14)=31 でやや売られすぎ（+5点）</div><div class=\"reason\">・スローストキャス 17 の売られすぎ圏（+4点）</div><div class=\"reason\">・ADX 26・−DI優勢＝下降トレンドに勢い（−4点）</div><div class=\"reason\">・PBR 1.16倍と資産に対して割安圏。下値が固くなりやすい（+6点）</div><div class=\"reason\">・ROE 2.1%と収益力が弱い（−5点）</div><div class=\"reason\">・時価総額2,577億円の中大型で値動きが安定しやすい（+3点）</div><div class=\"reason\">・自己資本比率64%と財務が厚く倒産リスクが低い（+4点）</div><div class=\"reason\">・営業利益率12.8%と本業の稼ぐ力が高い（+3点）</div><div class=\"reason\">・PEG 0.17倍＝成長率に対して株価が割安（+4点）</div><div class=\"reason\">・夜間ギャップ（翌朝の窓開け）平均±0.7%と小さく、夜に決めた指値が翌朝も有効に働きやすい（+8点）</div><div class=\"reason\">・1日平均 15億円の売買があり注文が通りやすい（+12点）</div><div class=\"nhead\">減点方式: 全体564位（−22点）</div><div class=\"hit\"><span class=\"sev sevB\">重い</span>ROE 2.1%と稼ぐ力が弱い<span class=\"num hp\">−12</span></div><div class=\"hit\"><span class=\"sev sevC\">軽い</span>利確まで平均104日と資金拘束が長い<span class=\"num hp\">−5</span></div><div class=\"hit\"><span class=\"sev sevC\">軽い</span>直近の仮想買いが塩漬け中<span class=\"num hp\">−5</span></div><div class=\"nhead\">TOB素地スコア: 26点（全体2,584位）</div><div class=\"reason\">・PBR 1.16倍 ＝ 1倍をわずかに超える程度（+4）</div><div class=\"reason\">・自己資本比率 64% ＝ 財務が厚く買収後の余力大（+8）</div><div class=\"reason\">・厚い資本にROE 2.1% ＝ 資本を活かせていない（アクティビスト誘因）（+6）</div><div class=\"reason\">・営業利益率 12.8% ＝ 本業の稼ぐ力あり（+8）</div><div class=\"discnote\">買収・非公開化されやすい「体質」の順位で、発生の予測ではありません。全体像と注意点は上部タブの「TOB素地」ページへ。</div><div class=\"nhead\">業績の推移（通期実績の推移・決算短信より）</div><div class=\"finchart\"><svg viewBox=\"0 0 340 150\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:100%; height:auto; background:#fffdf6; bord