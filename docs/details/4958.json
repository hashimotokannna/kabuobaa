\"nhead\">板・売買フローの推定（AI）</div><div class=\"discnote\">この銘柄は本日の分析対象外です（今夜の厳選・出尽くしサイン・レーティング変化・注目開示などの注目銘柄のみ、毎晩の実行で場中の5分足を取得して分析します）。</div><div class=\"spwrap\"><div class=\"nhead\">値動きと長期支持帯<span class=\"spbtns\"><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, '1')\">1年</button><button type=\"button\" class=\"spbtn on\" onclick=\"spSwap(this, '3')\">3年</button><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, '10')\">10年</button><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, 'all')\">全期間(26年)</button></span></div><div class=\"spark spv\" data-sp=\"1\" style=\"display:none\"><svg viewBox=\"0 0 320 110\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:100%; height:auto; background:#fffdf6; border-radius:8px;\"><rect x=\"0\" y=\"61.7\" width=\"320\" height=\"21.799999999999997\" fill=\"#c62f2f\" opacity=\"0.12\"/><polyline points=\"4.0,94.9 9.1,97.2 14.2,93.9 19.3,90.0 24.5,95.7 29.6,84.3 34.7,92.6 39.8,90.8 44.9,89.4 50.0,81.2 55.1,79.6 60.3,86.0 65.4,76.8 70.5,76.4 75.6,74.0 80.7,81.5 85.8,79.9 91.0,92.0 96.1,78.3 101.2,79.9 106.3,72.5 111.4,79.9 116.5,79.9 121.6,78.9 126.8,90.3 131.9,84.9 137.0,79.4 142.1,71.7 147.2,71.9 152.3,76.8 157.4,74.2 162.6,69.2 167.7,59.0 172.8,48.8 177.9,53.1 183.0,55.8 188.1,56.3 193.2,52.5 198.4,44.5 203.5,40.7 208.6,40.7 213.7,41.8 218.8,36.9 223.9,39.1 229.0,34.3 234.2,32.6 239.3,36.9 244.4,31.6 249.5,29.4 254.6,26.2 259.7,25.7 264.9,25.1 270.0,32.6 275.1,39.6 280.2,12.8 285.3,14.9 290.4,26.2 295.5,28.9 300.7,19.2 305.8,20.3 310.9,16.0 316.0,24.6\" fill=\"none\" stroke=\"#1c1c1e\" stroke-width=\"1.6\"/><path d=\"M 4.0 106.9 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 4.0 106.9 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 4.0 106.9 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 4.0 106.9 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 4.0 106.9 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 4.0 106.9 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 4.0 106.9 l 5 8 l -10 0 z\" fill=\"