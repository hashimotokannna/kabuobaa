、毎晩の実行で場中の5分足を取得して分析します）。</div><div class=\"spwrap\"><div class=\"nhead\">値動きと長期支持帯<span class=\"spbtns\"><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, '1')\">1年</button><button type=\"button\" class=\"spbtn on\" onclick=\"spSwap(this, '3')\">3年</button><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, '10')\">10年</button><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, 'all')\">全期間(25年)</button></span></div><div class=\"spark spv\" data-sp=\"1\" style=\"display:none\"><svg viewBox=\"0 0 320 110\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:100%; height:auto; background:#fffdf6; border-radius:8px;\"><polyline points=\"4.0,94.1 9.1,90.3 14.2,93.6 19.3,97.2 24.5,96.9 29.6,95.4 34.7,94.3 39.8,88.6 44.9,87.3 50.0,87.2 55.1,85.3 60.3,86.6 65.4,85.9 70.5,87.0 75.6,83.5 80.7,78.2 85.8,74.5 91.0,72.5 96.1,70.1 101.2,70.1 106.3,65.5 111.4,65.5 116.5,61.5 121.6,63.0 126.8,65.4 131.9,55.8 137.0,59.7 142.1,62.6 147.2,59.7 152.3,50.5 157.4,62.1 162.6,56.9 167.7,60.0 172.8,56.0 177.9,58.9 183.0,61.7 188.1,66.8 193.2,66.3 198.4,57.1 203.5,57.8 208.6,56.2 213.7,64.1 218.8,61.5 223.9,61.3 229.0,58.6 234.2,60.0 239.3,54.0 244.4,53.1 249.5,36.0 254.6,31.6 259.7,32.2 264.9,45.7 270.0,38.0 275.1,32.4 280.2,35.1 285.3,28.3 290.4,12.8 295.5,16.8 300.7,18.4 305.8,19.4 310.9,23.0 316.0,32.2\" fill=\"none\" stroke=\"#1c1c1e\" stroke-width=\"1.6\"/><circle cx=\"316.0\" cy=\"32.2\" r=\"4\" fill=\"#1c1c1e\"/></svg></div><div class=\"spark spv\" data-sp=\"3\" style=\"display:\"><svg viewBox=\"0 0 320 110\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:100%; height:auto; background:#fffdf6; border-radius:8px;\"><polyline points=\"4.0,68.0 6.1,84.9 8.3,82.5 10.4,84.1 12.5,86.7 14.7,85.9 16.8,85.9 19.0,85.9 21.1,86.4 23.2,87.1 25.4,88.1 27.5,91.7 29.6,93.2 31.8,86.9 33.9,81.9 36.1,79.5 38.2,74.4 40.3,72.2 42.5,70.4 44.6,68.9 46.7,70.4 48.9,70.4 51.0,70.0 53.2,66.9 55.3,68.0 57.4,76.5 59.6,75.7 61.7,79.0 63.8,75.0 66.0,77.2 68.1,76.7 70.2,75.4 