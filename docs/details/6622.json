グ変化・注目開示などの注目銘柄のみ、毎晩の実行で場中の5分足を取得して分析します）。</div><div class=\"spwrap\"><div class=\"nhead\">値動きと長期支持帯<span class=\"spbtns\"><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, '1')\">1年</button><button type=\"button\" class=\"spbtn on\" onclick=\"spSwap(this, '3')\">3年</button><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, '10')\">10年</button><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, 'all')\">全期間(26年)</button></span></div><div class=\"spark spv\" data-sp=\"1\" style=\"display:none\"><svg viewBox=\"0 0 320 110\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:100%; height:auto; background:#fffdf6; border-radius:8px;\"><rect x=\"0\" y=\"94.9\" width=\"320\" height=\"2.299999999999997\" fill=\"#c62f2f\" opacity=\"0.12\"/><polyline points=\"4.0,79.8 9.1,83.6 14.2,89.5 19.3,91.6 24.5,92.2 29.6,89.2 34.7,83.1 39.8,85.3 44.9,85.1 50.0,80.7 55.1,77.3 60.3,76.2 65.4,68.9 70.5,67.8 75.6,69.7 80.7,69.8 85.8,58.6 91.0,56.5 96.1,49.5 101.2,48.4 106.3,59.0 111.4,62.8 116.5,65.5 121.6,67.7 126.8,70.9 131.9,67.5 137.0,57.3 142.1,53.0 147.2,52.1 152.3,47.1 157.4,31.5 162.6,22.9 167.7,39.3 172.8,32.0 177.9,39.2 183.0,39.9 188.1,47.4 193.2,36.4 198.4,12.8 203.5,21.1 208.6,29.8 213.7,47.0 218.8,44.6 223.9,48.6 229.0,48.2 234.2,54.3 239.3,51.8 244.4,52.9 249.5,59.8 254.6,60.7 259.7,61.1 264.9,65.6 270.0,66.5 275.1,64.9 280.2,60.7 285.3,55.8 290.4,47.0 295.5,47.0 300.7,66.3 305.8,72.6 310.9,67.4 316.0,87.9\" fill=\"none\" stroke=\"#1c1c1e\" stroke-width=\"1.6\"/><path d=\"M 4.0 91.8 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 4.0 91.8 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 4.0 91.8 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 19.3 103.6 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><circle cx=\"316.0\" cy=\"87.9\" r=\"4\" fill=\"#1c1c1e\"/></svg></div><div class=\"spark spv\" data-sp=\"3\" style=\"display:\"><svg viewBox=\"0 0 320 110\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:100%; height:auto; background:#fffdf6; border-