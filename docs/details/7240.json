ckground:#b9dcc0\"></div><div class=\"mz\" style=\"left:20.0%; width:10.0%; background:#f5e6b3\"></div><div class=\"mz\" style=\"left:30.0%; width:40.0%; background:#eeeae0\"></div><div class=\"mz\" style=\"left:70.0%; width:10.0%; background:#f5e6b3\"></div><div class=\"mz\" style=\"left:80.0%; width:20.0%; background:#f2c4a8\"></div><div class=\"mpin\" style=\"left:72.5%\"></div></div><span class=\"mv num\">72</span></div><div class=\"mrow\"><span class=\"ml\">MFI</span><div class=\"mtrack\"><div class=\"mz\" style=\"left:0.0%; width:20.0%; background:#b9dcc0\"></div><div class=\"mz\" style=\"left:20.0%; width:10.0%; background:#f5e6b3\"></div><div class=\"mz\" style=\"left:30.0%; width:40.0%; background:#eeeae0\"></div><div class=\"mz\" style=\"left:70.0%; width:10.0%; background:#f5e6b3\"></div><div class=\"mz\" style=\"left:80.0%; width:20.0%; background:#f2c4a8\"></div><div class=\"mpin\" style=\"left:37.7%\"></div></div><span class=\"mv num\">38</span></div><div class=\"mrow\"><span class=\"ml\">ADX(トレンド強さ)</span><div class=\"mtrack\"><div class=\"mz\" style=\"left:0.0%; width:33.3%; background:#eeeae0\"></div><div class=\"mz\" style=\"left:33.3%; width:8.3%; background:#f5e6b3\"></div><div class=\"mz\" style=\"left:41.7%; width:58.3%; background:#b9dcc0\"></div><div class=\"mpin\" style=\"left:22.8%\"></div></div><span class=\"mv num\">14↑</span></div><div class=\"mrow\"><span class=\"ml\">一目・雲</span><div class=\"mtrack\"><div class=\"mz\" style=\"left:0.0%; width:33.3%; background:#f2c4a8\"></div><div class=\"mz\" style=\"left:33.3%; width:33.3%; background:#f5e6b3\"></div><div class=\"mz\" style=\"left:66.7%; width:33.3%; background:#b9dcc0\"></div><div class=\"mpin\" style=\"left:83.3%\"></div></div><span class=\"mv num\">雲の上</span></div><div class=\"mrow\"><span class=\"ml\">ATR(日々の値幅)</span><div class=\"mtrack\"><div class=\"mz\" style=\"left:0.0%; width:20.0%; background:#b9dcc0\"></div><div class=\"mz\" style=\"left:20.0%; width:15.0%; background:#eee