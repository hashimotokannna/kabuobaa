, '3')\">3年</button><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, '10')\">10年</button><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, 'all')\">全期間(26年)</button></span></div><div class=\"spark spv\" data-sp=\"1\" style=\"display:none\"><svg viewBox=\"0 0 320 110\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:100%; height:auto; background:#fffdf6; border-radius:8px;\"><polyline points=\"4.0,29.2 9.1,29.5 14.2,26.1 19.3,25.6 24.5,20.6 29.6,18.0 34.7,12.8 39.8,42.8 44.9,39.9 50.0,36.3 55.1,32.2 60.3,37.3 65.4,35.8 70.5,22.3 75.6,14.5 80.7,20.0 85.8,20.5 91.0,25.6 96.1,35.6 101.2,38.3 106.3,36.5 111.4,25.2 116.5,57.2 121.6,62.2 126.8,68.3 131.9,69.0 137.0,73.6 142.1,77.8 147.2,78.3 152.3,76.0 157.4,74.4 162.6,74.0 167.7,58.3 172.8,67.2 177.9,75.0 183.0,74.4 188.1,70.8 193.2,76.6 198.4,77.1 203.5,70.4 208.6,79.1 213.7,79.4 218.8,77.0 223.9,88.7 229.0,76.3 234.2,71.2 239.3,65.3 244.4,63.9 249.5,66.5 254.6,57.0 259.7,59.0 264.9,51.8 270.0,71.0 275.1,70.2 280.2,70.8 285.3,82.2 290.4,80.2 295.5,80.7 300.7,86.3 305.8,93.4 310.9,97.2 316.0,97.1\" fill=\"none\" stroke=\"#1c1c1e\" stroke-width=\"1.6\"/><circle cx=\"316.0\" cy=\"97.1\" r=\"4\" fill=\"#1c1c1e\"/></svg></div><div class=\"spark spv\" data-sp=\"3\" style=\"display:\"><svg viewBox=\"0 0 320 110\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:100%; height:auto; background:#fffdf6; border-radius:8px;\"><polyline points=\"4.0,96.0 6.1,89.0 8.3,94.2 10.4,96.8 12.5,97.0 14.7,97.1 16.8,97.2 19.0,92.8 21.1,95.2 23.2,91.0 25.4,92.5 27.5,94.4 29.6,85.0 31.8,80.1 33.9,80.6 36.1,74.9 38.2,83.8 40.3,86.3 42.5,56.6 44.6,60.1 46.7,51.6 48.9,52.2 51.0,46.8 53.2,44.2 55.3,45.5 57.4,39.7 59.6,55.3 61.7,61.0 63.8,63.4 66.0,54.6 68.1,52.8 70.2,55.2 72.4,48.6 74.5,48.7 76.7,57.7 78.8,51.3 80.9,44.9 83.1,40.4 85.2,37.0 87.3,38.6 89.5,40.1 91.6,66.9 93.8,43.7 95.9,30.0 98.0,16.6 100.2,21.1 102.3,33.5 104.4,27.7 106.6,27.2 108.7,36.2 110.8,30.1 113.0,29.5 115.1,37.1 117.3,35.6 119.4,29.9 121.5,42.3 