得して分析します）。</div><div class=\"spwrap\"><div class=\"nhead\">値動きと長期支持帯<span class=\"spbtns\"><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, '1')\">1年</button><button type=\"button\" class=\"spbtn on\" onclick=\"spSwap(this, '3')\">3年</button><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, '10')\">10年</button><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, 'all')\">全期間(26年)</button></span></div><div class=\"spark spv\" data-sp=\"1\" style=\"display:none\"><svg viewBox=\"0 0 320 110\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:100%; height:auto; background:#fffdf6; border-radius:8px;\"><rect x=\"0\" y=\"73.2\" width=\"320\" height=\"13.899999999999991\" fill=\"#c62f2f\" opacity=\"0.12\"/><polyline points=\"4.0,60.3 9.1,61.7 14.2,55.8 19.3,59.8 24.5,54.6 29.6,37.0 34.7,42.6 39.8,37.2 44.9,35.1 50.0,32.3 55.1,12.8 60.3,28.8 65.4,23.3 70.5,24.8 75.6,33.0 80.7,36.8 85.8,39.1 91.0,38.9 96.1,29.9 101.2,17.2 106.3,33.2 111.4,39.8 116.5,47.6 121.6,51.6 126.8,60.5 131.9,61.2 137.0,61.7 142.1,69.7 147.2,63.6 152.3,69.7 157.4,73.2 162.6,71.4 167.7,77.5 172.8,77.5 177.9,80.8 183.0,94.7 188.1,97.2 193.2,95.6 198.4,85.7 203.5,53.5 208.6,80.1 213.7,81.2 218.8,75.6 223.9,66.6 229.0,69.5 234.2,62.9 239.3,63.6 244.4,59.4 249.5,60.5 254.6,59.1 259.7,44.8 264.9,47.4 270.0,52.3 275.1,57.0 280.2,42.9 285.3,46.6 290.4,45.5 295.5,48.8 300.7,57.0 305.8,59.8 310.9,49.9 316.0,51.1\" fill=\"none\" stroke=\"#1c1c1e\" stroke-width=\"1.6\"/><path d=\"M 4.0 72.3 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 4.0 72.3 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 4.0 72.3 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 4.0 72.3 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 4.0 72.3 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 4.0 72.3 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 4.0 72.3 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 234.2 74.9 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><circle cx=\"316.0\" cy=\"51.1\" r=\"4\" fill=\"#1c1c1e\"/