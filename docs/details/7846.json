します）。</div><div class=\"spwrap\"><div class=\"nhead\">値動きと長期支持帯<span class=\"spbtns\"><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, '1')\">1年</button><button type=\"button\" class=\"spbtn on\" onclick=\"spSwap(this, '3')\">3年</button><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, '10')\">10年</button><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, 'all')\">全期間(25年)</button></span></div><div class=\"spark spv\" data-sp=\"1\" style=\"display:none\"><svg viewBox=\"0 0 320 110\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:100%; height:auto; background:#fffdf6; border-radius:8px;\"><polyline points=\"4.0,92.8 9.1,91.3 14.2,86.6 19.3,85.1 24.5,87.9 29.6,89.5 34.7,90.2 39.8,88.7 44.9,93.6 50.0,93.5 55.1,89.4 60.3,89.7 65.4,87.3 70.5,80.4 75.6,87.5 80.7,85.9 85.8,85.1 91.0,83.9 96.1,76.0 101.2,87.5 106.3,81.3 111.4,81.5 116.5,78.1 121.6,84.1 126.8,77.8 131.9,71.8 137.0,84.3 142.1,77.4 147.2,86.2 152.3,95.4 157.4,97.2 162.6,93.3 167.7,85.1 172.8,90.2 177.9,80.5 183.0,78.6 188.1,83.0 193.2,84.3 198.4,83.1 203.5,87.3 208.6,94.8 213.7,82.0 218.8,80.1 223.9,80.3 229.0,81.7 234.2,79.9 239.3,75.9 244.4,79.1 249.5,74.6 254.6,68.2 259.7,60.9 264.9,59.4 270.0,60.6 275.1,55.7 280.2,59.3 285.3,30.3 290.4,33.3 295.5,40.4 300.7,26.1 305.8,12.8 310.9,21.9 316.0,26.8\" fill=\"none\" stroke=\"#1c1c1e\" stroke-width=\"1.6\"/><circle cx=\"316.0\" cy=\"26.8\" r=\"4\" fill=\"#1c1c1e\"/></svg></div><div class=\"spark spv\" data-sp=\"3\" style=\"display:\"><svg viewBox=\"0 0 320 110\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:100%; height:auto; background:#fffdf6; border-radius:8px;\"><polyline points=\"4.0,66.0 6.1,53.1 8.3,57.7 10.4,49.7 12.5,46.8 14.7,49.5 16.8,51.2 19.0,52.3 21.1,70.1 23.2,70.6 25.4,69.6 27.5,72.4 29.6,73.1 31.8,83.0 33.9,80.9 36.1,82.5 38.2,81.8 40.3,83.8 42.5,83.1 44.6,83.1 46.7,87.3 48.9,97.2 51.0,89.0 53.2,89.3 55.3,95.2 57.4,94.8 59.6,91.4 61.7,87.6 63.8,81.7 66.0,83.0 68.1,82.1 70.2,80.3 72.4,76.9 74.5,78.8 