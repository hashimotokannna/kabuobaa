eae0\"></div><div class=\"mz\" style=\"left:33.3%; width:16.7%; background:#f5e6b3\"></div><div class=\"mz\" style=\"left:50.0%; width:50.0%; background:#f2c4a8\"></div><div class=\"mpin\" style=\"left:14.3%\"></div></div><span class=\"mv num\">17%</span></div><div class=\"mrow\"><span class=\"ml\">OBV(20日)</span><div class=\"mtrack\"><div class=\"mz\" style=\"left:0.0%; width:40.0%; background:#f2c4a8\"></div><div class=\"mz\" style=\"left:40.0%; width:10.0%; background:#f5e6b3\"></div><div class=\"mz\" style=\"left:50.0%; width:10.0%; background:#eeeae0\"></div><div class=\"mz\" style=\"left:60.0%; width:40.0%; background:#b9dcc0\"></div><div class=\"mpin\" style=\"left:40.6%\"></div></div><span class=\"mv num\">-9%</span></div><div class=\"mrow\"><span class=\"ml\">自己資本比率</span><div class=\"mtrack\"><div class=\"mz\" style=\"left:0.0%; width:20.0%; background:#f2c4a8\"></div><div class=\"mz\" style=\"left:20.0%; width:15.0%; background:#f5e6b3\"></div><div class=\"mz\" style=\"left:35.0%; width:15.0%; background:#eeeae0\"></div><div class=\"mz\" style=\"left:50.0%; width:50.0%; background:#b9dcc0\"></div><div class=\"mpin\" style=\"left:73.3%\"></div></div><span class=\"mv num\">73%</span></div><div class=\"mrow\"><span class=\"ml\">営業利益率</span><div class=\"mtrack\"><div class=\"mz\" style=\"left:0.0%; width:25.0%; background:#f2c4a8\"></div><div class=\"mz\" style=\"left:25.0%; width:12.5%; background:#f5e6b3\"></div><div class=\"mz\" style=\"left:37.5%; width:12.5%; background:#eeeae0\"></div><div class=\"mz\" style=\"left:50.0%; width:50.0%; background:#b9dcc0\"></div><div class=\"mpin\" style=\"left:21.7%\"></div></div><span class=\"mv num\">-1.3%</span></div><div class=\"mrow\"><span class=\"ml\">ROA</span><div class=\"mtrack\"><div class=\"mz\" style=\"left:0.0%; width:20.0%; background:#f2c4a8\"></div><div class=\"mz\" style=\"left:20.0%; width:8.0%; background:#f5e6b3\"></div><div class=\"mz\" style=\"left:28.0%; width:12.0%; background:#eeeae0\"></div><div class=\"mz\" style=\"left:40.0%; width:60.0%; background:#b9dcc0\"></div><div class=\"mpin\" style=\"left:20.0%\"></div></div><span class=\"mv num\">-0.0%</span></div></div><div class=\"discnote\">ピンが現在値。PER・PBRなど価値系は「標準」が最も安心、割安は魅力だが「割安の罠」の確認が必要。RSI・ボリンジャーなど行きすぎ系は売られすぎ側が押し目買いに有利。読み方は「指標の読み方」ページへ。</div><div class=\"nhead\">スコア 34点（候補圏外）</div><div class=\"reason\">・直近20日高値から −2.2%（安さの主基準 +17点・8%で頭打ち）</div><div class=\"reason\">・下げの大半が特定の1日に集中（急落型・加点なし）</div><div class=\"reason\">・日々の値動きが±1.1%と穏やかで読みやすい（+10点）</div><div class=\"reason\">・1年高値からの下落 −15% で長期トレンド健全（+12点）</div><div class=\"reason\">・過去1年、同じ買い方で 1回 利確ライン（+5%）に到達（+5点）</div><div class=\"reason\">・利確まで平均 8営業日（+8点）</div><div class=\"reason\">・ただし直近の仮想買いが塩漬け中（−15点）</div><div class=\"reason\">・長期支持帯 2,057円付近は過去9回試されており、今回で10回目。支持線は試されるほど割れやすい（−5点・警戒）</div><div class=\"reason\">・50日線が200日線の下（長期は調整形・加点なし）</div><div class=\"reason\">・MACDが直近5日以内に買い転換（下げの勢いが尽きた定番シグナル +8点）</div><div class=\"reason\">・ADX 32・−DI優勢＝下降トレンドに勢い（−4点）</div><div class=\"reason\">・一目均衡表の雲の下（中期は弱い −3点）</div><div class=\"reason\">・ATR 1.7%と日々の値幅が小さく、損切り幅を狭く置ける（+3点）</div><div class=\"reason\">・赤字（PERマイナス）。業績不振の銘柄は下げても戻りが鈍い（−20点）</div><div class=\"reason\">・PBR 0.55倍と資産に対して割安圏。下値が固くなりやすい（+6点）</div><div class=\"reason\">・配当利回り3.2%。配当が下値を支えやすい（+5点）</div><div class=\"reason\">・自己資本比率73%と財務が厚く倒産リスクが低い（+4点）</div><div class=\"reason\">・営業赤字（営業利益率-1.3%）（−5点）</div><div class=\"reason\">・夜間ギャップ（翌朝の窓開け）平均±0.5%と小さく、夜に決めた指値が翌朝も有効に働きやすい（+8点）</div><div class=\"nhead\">減点方式: 全体2,772位（−69点）</div><div class=\"hit\"><span class=\"sev sevA\">致命</span>赤字（PERマイナス）<span class=\"num hp\">−30</span></div><div class=\"hit\"><span class=\"sev sevB\">重い</span>50日線が200日線の下（長期は調整形）<span class=\"num hp\">−10</span></div><div class=\"hit\"><span class=\"sev sevB\">重い</span>売買代金が1日1億円未満（約定しにくい）<span class=\"num hp\">−10</span></div><div class=\"hit\"><span class=\"sev sevB\">重い</span>長期支持帯を10回目に試す位置（割れやすい）<span class=\"num hp\">−8</span></div><div class=\"hit\"><span class=\"sev sevC\">軽い</span>下げが1日に集中（崩落型）<span class=\"num hp\">−6</span></div><div class=\"hit\"><span class=\"sev sevC\">軽い</span>直近の仮想買いが塩漬け中<span class=\"num hp\">−5</span></div><div class=\"nhead\">TOB素地スコア: 57点（全体429位）</div><div class=\"reason\">・PBR 0.55倍 ＝ 解散価値の6割未満（最重要の割安シグナル）（+22）</div><div class=\"reason\">・時価総額 174億円 ＝ TOB・MBOの主戦場サイズ（+15）</div><div class=\"reason\">・自己資本比率 73% ＝ ほぼ無借金のため込み体質（+12）</div><div class=\"reason\">・厚い資本にROE -0.1% ＝ 資本を活かせていない（アクティビスト誘因）（+6）</div><div class=\"reason\">・営業赤字 ＝ 事業目的の買収対象になりにくい（-12）</div><div class=\"reason\">・株価は1年レンジの下位25%に放置（+6）</div><div class=\"reason\">・売買代金が薄く市場の目が届きにくい（+4）</div><div class=\"reason\">・プライムでPBR1倍割れ ＝ 東証の改善要請が直撃（+4）</div><div class=\"discnote\">買収・非公開化されやすい「体質」の順位で、発生の予測ではありません。全体像と注意点は上部タブの「TOB素地」ページへ。</div><div class=\"nhead\">業績の推移（通期実績の推移・決算短信より）</div><div class=\"finchart\"><svg viewBox=\"0 0 340 150\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:100%; height:auto; background:#fffdf6; border-radius:8px;\"><rect x=\"55.5\" y=\"22.5\" width=\"34.0\" height=\"107.5\" rx=\"2\" fill=\"#cfe0f5\"><title>23/3期 売上高 315億円</title></rect><rect x=\"120.5\" y=\"17.2\" width=\"34.0\" height=\"112.8\" rx=\"2\" fill=\"#cfe0f5\"><title>24/3期 売上高 330億円</title></rect><rect x=\"185.5\" y=\"34.8\" width=\"34.0\" height=\"95.2\" rx=\"2\" fill=\"#cfe0f5\"><title>25/3期 売上高 279億円</title></rect><rect x=\"250.5\" y=\"35.9\" width=\"34.0\" height=\"94.1\" rx=\"2\" fill=\"#cfe0f5\"><title>26/3期 売上高 275億円</title></rect><polyline points=\"72.5,45.0 137.5,17.4 202.5,76.3 267.5,76.1\" fill=\"none\" stroke=\"#c9661f\" stroke-width=\"1.8\"/><circle cx=\"72.5\" cy=\"45.0\" r=\"2.4\" fill=\"#c9661f\"><title>23/3期 営業利益 25億円</title></circle><circle cx=\"137.5\" cy=\"17.4\" r=\"2.4\" fill=\"#c9661f\"><title>24/3期 営業利益 33億円</title></circle><circle cx=\"202.5\" cy=\"76.3\" r=\"2.4\" fill=\"#c9661f\"><title>25/3期 営業利益 16億円</title></circle><circle cx=\"267.5\" cy=\"76.1\" r=\"2.4\" fill=\"#c9661f\"><title>26/3期 営業利益 16億円</title></circl