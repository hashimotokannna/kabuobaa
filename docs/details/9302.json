><div class=\"spwrap\"><div class=\"nhead\">値動きと長期支持帯<span class=\"spbtns\"><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, '1')\">1年</button><button type=\"button\" class=\"spbtn on\" onclick=\"spSwap(this, '3')\">3年</button><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, '10')\">10年</button><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, 'all')\">全期間(26年)</button></span></div><div class=\"spark spv\" data-sp=\"1\" style=\"display:none\"><svg viewBox=\"0 0 320 110\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:100%; height:auto; background:#fffdf6; border-radius:8px;\"><rect x=\"0\" y=\"90.0\" width=\"320\" height=\"3.700000000000003\" fill=\"#c62f2f\" opacity=\"0.12\"/><polyline points=\"4.0,35.2 9.1,49.6 14.2,47.1 19.3,38.8 24.5,26.9 29.6,41.9 34.7,41.0 39.8,36.5 44.9,42.7 50.0,44.6 55.1,42.1 60.3,44.8 65.4,48.7 70.5,51.4 75.6,60.6 80.7,59.0 85.8,40.1 91.0,49.1 96.1,69.9 101.2,50.3 106.3,51.9 111.4,44.2 116.5,33.5 121.6,29.1 126.8,28.4 131.9,19.8 137.0,17.5 142.1,12.8 147.2,32.5 152.3,40.3 157.4,38.0 162.6,39.2 167.7,37.3 172.8,34.0 177.9,42.3 183.0,42.8 188.1,41.6 193.2,42.2 198.4,49.0 203.5,69.6 208.6,64.4 213.7,67.9 218.8,62.2 223.9,59.7 229.0,55.6 234.2,59.7 239.3,87.8 244.4,79.5 249.5,80.4 254.6,80.6 259.7,78.0 264.9,79.6 270.0,78.8 275.1,74.7 280.2,76.8 285.3,86.3 290.4,83.7 295.5,79.8 300.7,83.8 305.8,82.8 310.9,85.9 316.0,97.2\" fill=\"none\" stroke=\"#1c1c1e\" stroke-width=\"1.6\"/><path d=\"M 239.3 99.8 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 285.3 98.3 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><circle cx=\"316.0\" cy=\"97.2\" r=\"4\" fill=\"#1c1c1e\"/></svg></div><div class=\"spark spv\" data-sp=\"3\" style=\"display:\"><svg viewBox=\"0 0 320 110\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:100%; height:auto; background:#fffdf6; border-radius:8px;\"><rect x=\"0\" y=\"45.3\" width=\"320\" height=\"2\" fill=\"#c62f2f\" opacity=\"0.12\"/><polyline points=\"4.0,96.1 6.1,94.4 8.3,92.6 10.4,92.5 12