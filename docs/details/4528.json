・レーティング変化・注目開示などの注目銘柄のみ、毎晩の実行で場中の5分足を取得して分析します）。</div><div class=\"spwrap\"><div class=\"nhead\">値動きと長期支持帯<span class=\"spbtns\"><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, '1')\">1年</button><button type=\"button\" class=\"spbtn on\" onclick=\"spSwap(this, '3')\">3年</button><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, '10')\">10年</button><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, 'all')\">全期間(26年)</button></span></div><div class=\"spark spv\" data-sp=\"1\" style=\"display:none\"><svg viewBox=\"0 0 320 110\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:100%; height:auto; background:#fffdf6; border-radius:8px;\"><rect x=\"0\" y=\"58.9\" width=\"320\" height=\"9.500000000000007\" fill=\"#c62f2f\" opacity=\"0.12\"/><polyline points=\"4.0,97.2 9.1,95.1 14.2,88.7 19.3,89.1 24.5,85.2 29.6,79.2 34.7,76.0 39.8,72.9 44.9,63.2 50.0,61.5 55.1,63.9 60.3,56.8 65.4,54.6 70.5,54.3 75.6,57.4 80.7,53.6 85.8,46.8 91.0,49.4 96.1,46.6 101.2,45.1 106.3,29.8 111.4,26.0 116.5,20.5 121.6,12.8 126.8,27.6 131.9,28.6 137.0,39.4 142.1,40.7 147.2,27.1 152.3,19.0 157.4,22.5 162.6,27.2 167.7,35.3 172.8,43.8 177.9,44.8 183.0,30.1 188.1,23.3 193.2,31.6 198.4,39.0 203.5,53.2 208.6,50.2 213.7,53.6 218.8,47.5 223.9,40.6 229.0,37.0 234.2,31.3 239.3,33.3 244.4,41.0 249.5,36.0 254.6,27.3 259.7,44.7 264.9,34.1 270.0,35.1 275.1,31.4 280.2,30.6 285.3,29.3 290.4,33.6 295.5,41.8 300.7,36.9 305.8,42.2 310.9,47.4 316.0,49.2\" fill=\"none\" stroke=\"#1c1c1e\" stroke-width=\"1.6\"/><path d=\"M 4.0 109.2 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 4.0 109.2 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 4.0 109.2 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 4.0 109.2 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 80.7 65.6 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 203.5 65.2 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><circle cx=\"316.0\" cy=\"49.2\" r=\"4\" fill=\"#1c1c1e\"/></svg></div><div class=\"spark spv\" data-sp=\"3\" style=\"display:\"><