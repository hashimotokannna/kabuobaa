厳選・出尽くしサイン・レーティング変化・注目開示などの注目銘柄のみ、毎晩の実行で場中の5分足を取得して分析します）。</div><div class=\"spwrap\"><div class=\"nhead\">値動きと長期支持帯<span class=\"spbtns\"><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, '1')\">1年</button><button type=\"button\" class=\"spbtn on\" onclick=\"spSwap(this, '3')\">3年</button><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, '10')\">10年</button><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, 'all')\">全期間(19年)</button></span></div><div class=\"spark spv\" data-sp=\"1\" style=\"display:none\"><svg viewBox=\"0 0 320 110\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:100%; height:auto; background:#fffdf6; border-radius:8px;\"><rect x=\"0\" y=\"68.9\" width=\"320\" height=\"19.0\" fill=\"#c62f2f\" opacity=\"0.12\"/><polyline points=\"4.0,58.2 9.1,65.9 14.2,53.1 19.3,50.1 24.5,60.6 29.6,44.9 34.7,61.4 39.8,63.4 44.9,49.6 50.0,57.3 55.1,54.6 60.3,55.6 65.4,54.6 70.5,53.1 75.6,61.8 80.7,81.7 85.8,70.0 91.0,55.2 96.1,51.2 101.2,29.1 106.3,23.8 111.4,12.8 116.5,24.8 121.6,41.7 126.8,68.7 131.9,64.6 137.0,61.2 142.1,57.6 147.2,68.7 152.3,79.6 157.4,87.9 162.6,88.4 167.7,80.3 172.8,81.5 177.9,90.1 183.0,82.6 188.1,94.0 193.2,93.7 198.4,97.2 203.5,92.9 208.6,95.9 213.7,88.6 218.8,78.1 223.9,75.1 229.0,80.9 234.2,71.1 239.3,57.8 244.4,49.6 249.5,50.9 254.6,55.0 259.7,47.5 264.9,39.2 270.0,52.2 275.1,62.9 280.2,55.0 285.3,54.4 290.4,60.3 295.5,57.4 300.7,55.6 305.8,46.2 310.9,40.0 316.0,29.8\" fill=\"none\" stroke=\"#1c1c1e\" stroke-width=\"1.6\"/><path d=\"M 4.0 70.2 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 4.0 70.2 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 9.1 77.9 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 39.8 75.4 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 80.7 93.7 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 131.9 76.6 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 229.0 92.9 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 290.4 72.3 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><circle cx=\"316.0