><div class=\"nhead\">板・売買フローの推定（AI）</div><div class=\"discnote\">この銘柄は本日の分析対象外です（今夜の厳選・出尽くしサイン・レーティング変化・注目開示などの注目銘柄のみ、毎晩の実行で場中の5分足を取得して分析します）。</div><div class=\"spwrap\"><div class=\"nhead\">値動きと長期支持帯<span class=\"spbtns\"><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, '1')\">1年</button><button type=\"button\" class=\"spbtn on\" onclick=\"spSwap(this, '3')\">3年</button><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, '10')\">10年</button><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, 'all')\">全期間(27年)</button></span></div><div class=\"spark spv\" data-sp=\"1\" style=\"display:none\"><svg viewBox=\"0 0 320 110\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:100%; height:auto; background:#fffdf6; border-radius:8px;\"><rect x=\"0\" y=\"67.2\" width=\"320\" height=\"3.299999999999997\" fill=\"#c62f2f\" opacity=\"0.12\"/><polyline points=\"4.0,95.4 9.1,93.0 14.2,97.2 19.3,92.5 24.5,95.5 29.6,94.2 34.7,96.1 39.8,92.9 44.9,90.8 50.0,87.4 55.1,82.1 60.3,79.0 65.4,84.2 70.5,88.0 75.6,86.2 80.7,56.7 85.8,57.7 91.0,45.6 96.1,32.4 101.2,44.5 106.3,56.1 111.4,55.0 116.5,62.8 121.6,64.9 126.8,48.7 131.9,42.7 137.0,28.7 142.1,27.0 147.2,29.8 152.3,28.1 157.4,39.0 162.6,51.0 167.7,35.7 172.8,25.7 177.9,30.2 183.0,49.4 188.1,42.3 193.2,28.7 198.4,12.8 203.5,27.6 208.6,24.1 213.7,34.4 218.8,33.3 223.9,34.2 229.0,55.1 234.2,56.8 239.3,46.8 244.4,59.8 249.5,55.8 254.6,50.8 259.7,55.0 264.9,64.9 270.0,54.0 275.1,58.2 280.2,59.2 285.3,63.4 290.4,66.2 295.5,66.2 300.7,68.0 305.8,73.4 310.9,75.8 316.0,69.5\" fill=\"none\" stroke=\"#1c1c1e\" stroke-width=\"1.6\"/><path d=\"M 116.5 74.8 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 264.9 76.9 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><circle cx=\"316.0\" cy=\"69.5\" r=\"4\" fill=\"#1c1c1e\"/></svg></div><div class=\"spark spv\" data-sp=\"3\" style=\"display:\"><svg viewBox=\"0 0 320 110\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:100%; height:auto; background:#fffdf6; border-radius:8px;