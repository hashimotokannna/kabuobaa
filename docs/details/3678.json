目開示などの注目銘柄のみ、毎晩の実行で場中の5分足を取得して分析します）。</div><div class=\"spwrap\"><div class=\"nhead\">値動きと長期支持帯<span class=\"spbtns\"><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, '1')\">1年</button><button type=\"button\" class=\"spbtn on\" onclick=\"spSwap(this, '3')\">3年</button><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, '10')\">10年</button><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, 'all')\">全期間(13年)</button></span></div><div class=\"spark spv\" data-sp=\"1\" style=\"display:none\"><svg viewBox=\"0 0 320 110\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:100%; height:auto; background:#fffdf6; border-radius:8px;\"><rect x=\"0\" y=\"89.9\" width=\"320\" height=\"5.5\" fill=\"#c62f2f\" opacity=\"0.12\"/><polyline points=\"4.0,18.5 9.1,20.7 14.2,19.9 19.3,19.9 24.5,12.8 29.6,24.1 34.7,27.8 39.8,22.6 44.9,19.5 50.0,14.2 55.1,18.7 60.3,15.9 65.4,33.3 70.5,35.1 75.6,39.5 80.7,37.6 85.8,37.7 91.0,38.6 96.1,37.2 101.2,35.7 106.3,29.8 111.4,25.4 116.5,35.7 121.6,39.2 126.8,47.9 131.9,42.4 137.0,43.4 142.1,70.1 147.2,75.6 152.3,83.9 157.4,87.7 162.6,89.9 167.7,88.2 172.8,90.5 177.9,82.2 183.0,80.6 188.1,79.6 193.2,82.9 198.4,82.4 203.5,84.0 208.6,79.0 213.7,73.7 218.8,77.3 223.9,84.2 229.0,82.5 234.2,82.4 239.3,91.0 244.4,80.3 249.5,85.0 254.6,81.6 259.7,80.7 264.9,86.4 270.0,88.2 275.1,88.6 280.2,89.0 285.3,95.4 290.4,97.2 295.5,95.0 300.7,79.4 305.8,79.6 310.9,86.4 316.0,94.8\" fill=\"none\" stroke=\"#1c1c1e\" stroke-width=\"1.6\"/><path d=\"M 4.0 30.5 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 4.0 30.5 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 167.7 100.2 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 239.3 103.0 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><circle cx=\"316.0\" cy=\"94.8\" r=\"4\" fill=\"#1c1c1e\"/></svg></div><div class=\"spark spv\" data-sp=\"3\" style=\"display:\"><svg viewBox=\"0 0 320 110\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:100%; height:auto; background:#fffdf6; border-radius:8px;\"><