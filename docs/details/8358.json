ap\"><div class=\"nhead\">値動きと長期支持帯<span class=\"spbtns\"><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, '1')\">1年</button><button type=\"button\" class=\"spbtn on\" onclick=\"spSwap(this, '3')\">3年</button><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, '10')\">10年</button><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, 'all')\">全期間(26年)</button></span></div><div class=\"spark spv\" data-sp=\"1\" style=\"display:none\"><svg viewBox=\"0 0 320 110\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:100%; height:auto; background:#fffdf6; border-radius:8px;\"><polyline points=\"4.0,91.6 9.1,93.6 14.2,93.7 19.3,92.4 24.5,90.8 29.6,95.2 34.7,97.2 39.8,94.1 44.9,94.6 50.0,92.0 55.1,92.0 60.3,92.5 65.4,90.3 70.5,84.8 75.6,85.9 80.7,85.0 85.8,82.9 91.0,82.4 96.1,83.6 101.2,80.0 106.3,76.7 111.4,71.4 116.5,68.2 121.6,71.5 126.8,66.6 131.9,59.2 137.0,64.3 142.1,60.9 147.2,65.4 152.3,69.6 157.4,72.6 162.6,68.7 167.7,65.0 172.8,67.8 177.9,60.5 183.0,52.5 188.1,49.8 193.2,55.0 198.4,47.6 203.5,55.4 208.6,48.8 213.7,48.7 218.8,46.7 223.9,53.2 229.0,52.7 234.2,50.6 239.3,46.3 244.4,45.5 249.5,45.0 254.6,37.7 259.7,33.0 264.9,25.6 270.0,28.9 275.1,30.7 280.2,32.8 285.3,27.0 290.4,18.1 295.5,21.9 300.7,15.4 305.8,12.8 310.9,14.4 316.0,23.1\" fill=\"none\" stroke=\"#1c1c1e\" stroke-width=\"1.6\"/><circle cx=\"316.0\" cy=\"23.1\" r=\"4\" fill=\"#1c1c1e\"/></svg></div><div class=\"spark spv\" data-sp=\"3\" style=\"display:\"><svg viewBox=\"0 0 320 110\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:100%; height:auto; background:#fffdf6; border-radius:8px;\"><polyline points=\"4.0,96.8 6.1,96.2 8.3,96.1 10.4,96.1 12.5,96.1 14.7,97.2 16.8,96.8 19.0,96.2 21.1,95.7 23.2,95.1 25.4,93.4 27.5,92.4 29.6,91.3 31.8,90.9 33.9,91.4 36.1,91.5 38.2,89.9 40.3,87.8 42.5,88.5 44.6,88.3 46.7,90.4 48.9,92.6 51.0,91.5 53.2,90.3 55.3,88.8 57.4,88.5 59.6,87.4 61.7,88.3 63.8,84.5 66.0,83.7 68.1,85.1 70.2,84.8 72.4,82.7 74.5,85.5 76.7,85.2 78.8,81.2 80.9,81.