自動で表示されます。</div><div class=\"nhead\">板・売買フローの推定（AI）</div><div class=\"discnote\">この銘柄は本日の分析対象外です（今夜の厳選・出尽くしサイン・レーティング変化・注目開示などの注目銘柄のみ、毎晩の実行で場中の5分足を取得して分析します）。</div><div class=\"spwrap\"><div class=\"nhead\">値動きと長期支持帯<span class=\"spbtns\"><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, '1')\">1年</button><button type=\"button\" class=\"spbtn on\" onclick=\"spSwap(this, '3')\">3年</button><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, '10')\">10年</button><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, 'all')\">全期間(26年)</button></span></div><div class=\"spark spv\" data-sp=\"1\" style=\"display:none\"><svg viewBox=\"0 0 320 110\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:100%; height:auto; background:#fffdf6; border-radius:8px;\"><polyline points=\"4.0,87.4 9.1,87.5 14.2,96.7 19.3,92.0 24.5,93.9 29.6,93.6 34.7,97.1 39.8,97.2 44.9,94.3 50.0,94.7 55.1,91.7 60.3,79.9 65.4,75.7 70.5,77.6 75.6,72.1 80.7,73.8 85.8,70.6 91.0,68.9 96.1,61.6 101.2,50.2 106.3,52.5 111.4,62.4 116.5,53.7 121.6,48.5 126.8,45.0 131.9,42.1 137.0,30.4 142.1,46.6 147.2,44.8 152.3,55.1 157.4,58.9 162.6,61.4 167.7,50.2 172.8,39.5 177.9,43.8 183.0,46.2 188.1,56.5 193.2,51.5 198.4,45.3 203.5,34.7 208.6,40.8 213.7,40.2 218.8,41.6 223.9,38.8 229.0,33.5 234.2,37.1 239.3,38.9 244.4,35.2 249.5,29.4 254.6,31.3 259.7,22.9 264.9,19.9 270.0,28.7 275.1,17.9 280.2,12.8 285.3,18.0 290.4,19.7 295.5,15.7 300.7,16.5 305.8,22.9 310.9,18.7 316.0,13.0\" fill=\"none\" stroke=\"#1c1c1e\" stroke-width=\"1.6\"/><circle cx=\"316.0\" cy=\"13.0\" r=\"4\" fill=\"#1c1c1e\"/></svg></div><div class=\"spark spv\" data-sp=\"3\" style=\"display:\"><svg viewBox=\"0 0 320 110\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:100%; height:auto; background:#fffdf6; border-radius:8px;\"><polyline points=\"4.0,82.8 6.1,82.9 8.3,97.2 10.4,84.4 12.5,86.4 14.7,92.5 16.8,81.2 19.0,81.9 21.1,86.4 23.2,86.9 25.4,81.2 27.5,82.1 29.6,90.4 31.8,86.5 33.9,81.7 36.1,85.7 38.2,84.8 40.3,82.2 42.5,81