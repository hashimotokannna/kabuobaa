h:20.0%; background:#f2c4a8\"></div><div class=\"mpin\" style=\"left:90.3%\"></div></div><span class=\"mv num\">90</span></div><div class=\"mrow\"><span class=\"ml\">MFI</span><div class=\"mtrack\"><div class=\"mz\" style=\"left:0.0%; width:20.0%; background:#b9dcc0\"></div><div class=\"mz\" style=\"left:20.0%; width:10.0%; background:#f5e6b3\"></div><div class=\"mz\" style=\"left:30.0%; width:40.0%; background:#eeeae0\"></div><div class=\"mz\" style=\"left:70.0%; width:10.0%; background:#f5e6b3\"></div><div class=\"mz\" style=\"left:80.0%; width:20.0%; background:#f2c4a8\"></div><div class=\"mpin\" style=\"left:81.8%\"></div></div><span class=\"mv num\">82</span></div><div class=\"mrow\"><span class=\"ml\">ADX(トレンド強さ)</span><div class=\"mtrack\"><div class=\"mz\" style=\"left:0.0%; width:33.3%; background:#eeeae0\"></div><div class=\"mz\" style=\"left:33.3%; width:8.3%; background:#f5e6b3\"></div><div class=\"mz\" style=\"left:41.7%; width:58.3%; background:#b9dcc0\"></div><div class=\"mpin\" style=\"left:70.2%\"></div></div><span class=\"mv num\">42↑</span></div><div class=\"mrow\"><span class=\"ml\">一目・雲</span><div class=\"mtrack\"><div class=\"mz\" style=\"left:0.0%; width:33.3%; background:#f2c4a8\"></div><div class=\"mz\" style=\"left:33.3%; width:33.3%; background:#f5e6b3\"></div><div class=\"mz\" style=\"left:66.7%; width:33.3%; background:#b9dcc0\"></div><div class=\"mpin\" style=\"left:83.3%\"></div></div><span class=\"mv num\">雲の上</span></div><div class=\"mrow\"><span class=\"ml\">ATR(日々の値幅)</span><div class=\"mtrack\"><div class=\"mz\" style=\"left:0.0%; width:20.0%; background:#b9dcc0\"></div><div class=\"mz\" style=\"left:20.0%; width:15.0%; background:#eeeae0\"></div><div class=\"mz\" style=\"left:35.0%; width:15.0%; background:#f5e6b3\"></div><div class=\"mz\" style=\"left:50.0%; width:50.0%; background:#f2c4a8\"></div><div class=\"mpin\" style=\"left:26.9%\"></div></div><span class=\"mv num\">2.7%</span></div><div class=\"mrow\"><span class=\"ml\">HV(年率変動)</span><div class=\"mtrack\"><div class=\"mz\" style=\"left:0.0%; width:20.8%; background:#b9dcc0\"></div><div class=\"mz\" style=\"left:20.8%; width:12.5%; background:#eeeae0\"></div><div class=\"mz\" style=\"left:33.3%; width:16.7%; background:#f5e6b3\"></div><div class=\"mz\" style=\"left:50.0%; width:50.0%; background:#f2c4a8\"></div><div class=\"mpin\" style=\"left:20.4%\"></div></div><span class=\"mv num\">24%</span></div><div class=\"mrow\"><span class=\"ml\">OBV(20日)</span><div class=\"mtrack\"><div class=\"mz\" style=\"left:0.0%; width:40.0%; background:#f2c4a8\"></div><div class=\"mz\" style=\"left:40.0%; width:10.0%; background:#f5e6b3\"></div><div class=\"mz\" style=\"left:50.0%; width:10.0%; background:#eeeae0\"></div><div class=\"mz\" style=\"left:60.0%; width:40.0%; background:#b9dcc0\"></div><div class=\"mpin\" style=\"left:72.4%\"></div></div><span class=\"mv num\">+22%</span></div><div class=\"mrow\"><span class=\"ml\">自己資本比率</span><div class=\"mtrack\"><div class=\"mz\" style=\"left:0.0%; width:20.0%; background:#f2c4a8\"></div><div class=\"mz\" style=\"left:20.0%; width:15.0%; background:#f5e6b3\"></div><div class=\"mz\" style=\"left:35.0%; width:15.0%; background:#eeeae0\"></div><div class=\"mz\" style=\"left:50.0%; width:50.0%; background:#b9dcc0\"></div><div class=\"mpin\" style=\"left:79.3%\"></div></div><span class=\"mv num\">79%</span></div><div class=\"mrow\"><span class=\"ml\">営業利益率</span><div class=\"mtrack\"><div class=\"mz\" style=\"left:0.0%; width:25.0%; background:#f2c4a8\"></div><div class=\"mz\" style=\"left:25.0%; width:12.5%; background:#f5e6b3\"></div><div class=\"mz\" style=\"left:37.5%; width:12.5%; background:#eeeae0\"></div><div class=\"mz\" style=\"left:50.0%; width:50.0%; background:#b9dcc0\"></div><div class=\"mpin\" style=\"left:25.2%\"></div></div><span class=\"mv num\">0.1%</span></div><div class=\"mrow\"><span class=\"ml\">ROA</span><div class=\"mtrack\"><div class=\"mz\" style=\"left:0.0%; width:20.0%; background:#f2c4a8\"></div><div class=\"mz\" style=\"left:20.0%; width:8.0%; background:#f5e6b3\"></div><div class=\"mz\" style=\"left:28.0%; width:12.0%; background:#eeeae0\"></div><div class=\"mz\" style=\"left:40.0%; width:60.0%; background:#b9dcc0\"></div><div class=\"mpin\" style=\"left:40.8%\"></div></div><span class=\"mv num\">5.2%</span></div><div class=\"mrow\"><span class=\"ml\">配当性向</span><div class=\"mtrack\"><div class=\"mz\" style=\"left:0.0%; width:20.0%; background:#eeeae0\"></div><div class=\"mz\" style=\"left:20.0%; width:20.0%; background:#b9dcc0\"></div><div class=\"mz\" style=\"left:40.0%; width:26.7%; background:#f5e6b3\"></div><div class=\"mz\" style=\"left:66.7%; width:33.3%; background:#f2c4a8\"></div><div class=\"mpin\" style=\"left:25.9%\"></div></div><span class=\"mv num\">39%</span></div></div><div class=\"discnote\">ピンが現在値。PER・PBRなど価値系は「標準」が最も安心、割安は魅力だが「割安の罠」の確認が必要。RSI・ボリンジャーなど行きすぎ系は売られすぎ側が押し目買いに有利。読み方は「指標の読み方」ページへ。</div><div class=\"nhead\">スコア 170点（候補圏外）</div><div class=\"reason\">・直近20日高値から −1.2%（安さの主基準 +10点・8%で頭打ち）</div><div class=\"reason\">・下げの大半が特定の1日に集中（急落型・加点なし）</div><div class=\"reason\">・日々の値動きが±1.6%と穏やかで読みやすい（+10点）</div><div class=\"reason\">・200日平均線より上での下げ＝上昇トレンド中の一時的な押し目（+20点）</div><div class=\"reason\">・1年高値からの下落 −1% で長期トレンド健全（+12点）</div><div class=\"reason\">・過去1年、同じ買い方で 10回 利確ライン（+5%）に到達（+50点）</div><div class=\"reason\">・利確まで平均 12営業日（+8点）</div><div class=\"reason\">・50日線が200日線の上（ゴールデンクロス継続中の長期上昇形 +10点）</div><div class=\"reason\">・MACDがシグナル線の上で上向き（+4点）</div><div class=\"reason\">・ADX 42・+DI優勢＝上昇トレンドに勢いがある中の押し目（+4点）</div><div class=\"reason\">・一目均衡表の雲の上（中期の地合いは良好 +4点）</div><div class=\"reason\">・OBVが上向き＝下げの中でも買い集めの気配（+3点）</div><div class=\"reason\">・PER 14.1倍と利益に対して妥当〜割安の水準（+8点）</div><div class=\"reason\">・PBR 0.91倍と資産に対して割安圏。下値が固くなりやすい（+6点）</div><div class=\"reason\">・自己資本比率79%と財務が厚く倒産リスクが低い（+4点）</div><div class=\"reason\">・ROA 5.2%と資産効率が良い（+3点）</div><div class=\"reason\">・夜間ギャップ（翌朝の窓開け）平均±0.6%と小さく、夜に決めた指値が翌朝も有効に働きやすい（+8点）</di