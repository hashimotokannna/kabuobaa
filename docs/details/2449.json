kground:#eeeae0\"></div><div class=\"mz\" style=\"left:35.0%; width:15.0%; background:#f5e6b3\"></div><div class=\"mz\" style=\"left:50.0%; width:50.0%; background:#f2c4a8\"></div><div class=\"mpin\" style=\"left:40.8%\"></div></div><span class=\"mv num\">4.1%</span></div><div class=\"mrow\"><span class=\"ml\">HV(年率変動)</span><div class=\"mtrack\"><div class=\"mz\" style=\"left:0.0%; width:20.8%; background:#b9dcc0\"></div><div class=\"mz\" style=\"left:20.8%; width:12.5%; background:#eeeae0\"></div><div class=\"mz\" style=\"left:33.3%; width:16.7%; background:#f5e6b3\"></div><div class=\"mz\" style=\"left:50.0%; width:50.0%; background:#f2c4a8\"></div><div class=\"mpin\" style=\"left:38.4%\"></div></div><span class=\"mv num\">46%</span></div><div class=\"mrow\"><span class=\"ml\">OBV(20日)</span><div class=\"mtrack\"><div class=\"mz\" style=\"left:0.0%; width:40.0%; background:#f2c4a8\"></div><div class=\"mz\" style=\"left:40.0%; width:10.0%; background:#f5e6b3\"></div><div class=\"mz\" style=\"left:50.0%; width:10.0%; background:#eeeae0\"></div><div class=\"mz\" style=\"left:60.0%; width:40.0%; background:#b9dcc0\"></div><div class=\"mpin\" style=\"left:0.0%\"></div></div><span class=\"mv num\">-388%</span></div><div class=\"mrow\"><span class=\"ml\">自己資本比率</span><div class=\"mtrack\"><div class=\"mz\" style=\"left:0.0%; width:20.0%; background:#f2c4a8\"></div><div class=\"mz\" style=\"left:20.0%; width:15.0%; background:#f5e6b3\"></div><div class=\"mz\" style=\"left:35.0%; width:15.0%; background:#eeeae0\"></div><div class=\"mz\" style=\"left:50.0%; width:50.0%; background:#b9dcc0\"></div><div class=\"mpin\" style=\"left:79.0%\"></div></div><span class=\"mv num\">79%</span></div><div class=\"mrow\"><span class=\"ml\">営業利益率</span><div class=\"mtrack\"><div class=\"mz\" style=\"left:0.0%; width:25.0%; background:#f2c4a8\"></div><div class=\"mz\" style=\"left:25.0%; width:12.5%; background:#f5e6b3\"></div><div class=\"mz\" style=\"left:37.5%; width:12.5%; background:#