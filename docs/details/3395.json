37.5\" cy=\"107.8\" r=\"2.4\" fill=\"#7d55c7\"><title>24/3期 純利益 10億円</title></circle><circle cx=\"202.5\" cy=\"73.7\" r=\"2.4\" fill=\"#7d55c7\"><title>25/3期 純利益 25億円</title></circle><circle cx=\"267.5\" cy=\"70.1\" r=\"2.4\" fill=\"#7d55c7\"><title>26/3期 純利益 27億円</title></circle><text x=\"72.5\" y=\"144\" font-size=\"8.5\" fill=\"#a99a76\" text-anchor=\"middle\">23/3期</text><text x=\"137.5\" y=\"144\" font-size=\"8.5\" fill=\"#a99a76\" text-anchor=\"middle\">24/3期</text><text x=\"202.5\" y=\"144\" font-size=\"8.5\" fill=\"#a99a76\" text-anchor=\"middle\">25/3期</text><text x=\"267.5\" y=\"144\" font-size=\"8.5\" fill=\"#a99a76\" text-anchor=\"middle\">26/3期</text><text x=\"303\" y=\"25.2\" font-size=\"8\" fill=\"#7ba0cc\">884億</text><text x=\"303\" y=\"132\" font-size=\"8\" fill=\"#7ba0cc\">売上</text><text x=\"4\" y=\"25.2\" font-size=\"8\" fill=\"#8a6f4d\">51億</text><text x=\"4\" y=\"132\" font-size=\"8\" fill=\"#8a6f4d\">利益</text></svg></div><div class=\"finlg\"><span><i style=\"background:#cfe0f5\"></i>売上高（右軸）</span><span><i style=\"background:#c9661f\"></i>営業利益</span><span><i style=\"background:#178a5b\"></i>経常利益</span><span><i style=\"background:#7d55c7\"></i>純利益</span></div><div class=\"finrow finhead\"><span class=\"fp\"></span><span class=\"fc\">売上高</span><span class=\"fc\">営業利益</span><span class=\"fc\">純利益</span></div><div class=\"finrow\"><span class=\"fp\">26/3期</span><span class=\"fc\">884億円</span><span class=\"fc\">51億円</span><span class=\"fc\">27億円</span></div><div class=\"finrow\"><span class=\"fp\">25/3期</span><span class=\"fc\">709億円</span><span class=\"fc\">36億円</span><span class=\"fc\">25億円</span></div><div class=\"finrow\"><span class=\"fp\">24/3期</span><span class=\"fc\">646億円</span><span class=\"fc\">26億円</span><span class=\"fc\">10億円</span></div><div class=\"finrow\"><span class=\"fp\">23/3期</span><span class=\"fc\">578億円</span><span class=\"fc\">2億円</span><span class=\"fc\">4億円</span></div><div class=\"discnote\">グラフの棒・点にカーソルを合わせると数値が出ます。決算履歴は毎晩の実行で自動蓄積され、期間は時間とともに伸びていきます。古い年度はYahoo Financeの年次データで補完しています（この区間の経常利益は税引前利益で代用。決算短信の実測が入り次第、自動で置き換わります）。</div><div class=\"nhead\">ファンダメンタル指標</div><div class=\"fact\"><span>PER</span><span class=\"num\">20.1倍</span></div><div class=\"fact\"><span>PBR</span><span class=\"num\">1.71倍</span></div><div class=\"fact\"><span>ROE</span><span class=\"num\">8.5%</span></div><div class=\"fact\"><span>配当利回り</span><span class=\"num\">1.03%</span></div><div class=\"fact\"><span>時価総額</span><span class=\"num\">539億円</span></div><div class=\"nhead\">アナリスト・コンセンサス（証券会社レーティング）</div><div class=\"fact\"><span>平均評価（1=強気買い〜5=売り）</span><span class=\"num\"><b>1.0</b>（強気買い）</span></div><div class=\"fact\"><span>カバーするアナリスト数</span><span class=\"num\">1名</span></div><div class=\"fact\"><span>平均目標株価</span><span class=\"num\">3,300円 （現在値から <span class=\"plus\">+31.2%</span>）</span></div><div class=\"discnote\">出所はYahoo Finance（LSEG集計）のコンセンサス＝複数証券会社の平均で、MINKABU等の記事になる個別証券会社の発表が集計されたものです。目標株価はアナリストの「予想」であり保証ではありません。カバレッジのある銘柄（主に中大型株）のみ表示。レーティングは株価を動かす需給材料として「情報として知っておく」用途で、このシステムの採点には現時点で使っていません（変化イベントを蓄積し、効果を検証してから判断します）。</div><div class=\"nhead\">板・売買フローの推定（09/25の5分足・AI）</div><div class=\"fprof\"><div class=\"fpcol\"><div class=\"fpbar\" style=\"height:46px\"></div><span class=\"fplab\">9時</span></div><div class=\"fpcol\"><div class=\"fpbar\" style=\"height:15px\"></div><span class=\"fplab\"></span></div><div class=\"fpcol\"><div class=\"fpbar\" style=\"height:17px\"></div><span class=\"fplab\">10時</span></div><div class=\"fpcol\"><div class=\"fpbar\" style=\"height:11px\"></div><span class=\"fplab\"></span></div><div class=\"fpcol\"><div class=\"fpbar\" style=\"height:6px\"></div><span class=\"fplab\">11時</span></div><div class=\"fpcol\"><div class=\"fpbar\" style=\"height:20px\"></div><span class=\"fplab\">12時半</span></div><div class=\"fpcol\"><div class=\"fpbar\" style=\"height:7px\"></div><span class=\"fplab\"></span></div><div class=\"fpcol\"><div class=\"fpbar\" style=\"height:13px\"></div><span class=\"fplab\">13時半</span></div><div class=\"fpcol\"><div class=\"fpbar\" style=\"height:11px\"></div><span class=\"fplab\"></span></div><div class=\"fpcol\"><div class=\"fpbar\" style=\"height:19px\"></div><span class=\"fplab\">14時半</span></div><div class=\"fpcol\"><div class=\"fpbar\" style=\"height:27px\"></div><span class=\"fplab\">引け</span></div></div><div class=\"fplegend\">時間帯ごとの出来高（どの時間に売買が集中したか）</div><div class=\"fact\"><span>この日の値動き</span><span class=\"num\">+0.4%（値幅1.4%）</span></div><div class=\"fact\"><span>出来高（普段の日足平均との比）</span><span class=\"num\">0.8倍</span></div><div class=\"fact\"><span>終値とVWAP（1日の平均約定価格）の差</span><span class=\"num\">-0.45%</span></div><div class=\"fact\"><span>寄り30分／引け30分の出来高シェア</span><span class=\"num\">24% ／ 14%</span></div><div class=\"fsub\">裏にいそうな売買主体（機械推定・上位2件）</div><div class=\"factor\"><div class=\"factorh\">🎯 個人の短期資金（イナゴ・飛びつき買い）<span class=\"fconf\">一致度50・確度中</span></div><div class=\"exhwhy\">・瞬間的な出来高スパイク20倍（イナゴ的な集中）</div><div class=\"exhwhy\">・午前に高値→その後失速（買いが続かず利確に押される形）</div></div><div class=\"discnote\">リアルタイムの板（気配値・注文残）は取引所の有料データのため、場中の5分足の値動きと出来高の「形」から典型パターンとの一致度で推定しています。実際の注文主体を特定するものではありません。寄り集中＝個人の飛びつき、引け集中＋VWAP沿い＝機関の執行、出来高増なのに値幅が静か＝大口の仕込み、といった市場の経験則を採点式にしたものです。</div><div class=\"spwrap\"><div class=\"nhead\">値動きと長期支持帯<span class=\"spbtns\"><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, '1')\">1年</button><button type=\"button\" class=\"spbtn on\" onclick=\"spSwap(this, '3')\">3年</button><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, '10')\">10年</button><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, 'all')\">全期間(24年)</button></span></div><div class=\"spark spv\" data-sp=\"1\" style=\"display:none\"><svg viewBox=\"0 0 320 110\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:100%; height:auto; background:#fffdf6; border-radius:8px;\"><rect x=\"0\" y=\"88.8\" width=\"320\" height=\"8.400000000000006\" fill=\"#c62f2f\" opacity=\"0.12\"/><polyline points=\"4.0,4