柄は本日の分析対象外です（今夜の厳選・出尽くしサイン・レーティング変化・注目開示などの注目銘柄のみ、毎晩の実行で場中の5分足を取得して分析します）。</div><div class=\"spwrap\"><div class=\"nhead\">値動きと長期支持帯<span class=\"spbtns\"><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, '1')\">1年</button><button type=\"button\" class=\"spbtn on\" onclick=\"spSwap(this, '3')\">3年</button><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, '10')\">10年</button><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, 'all')\">全期間(26年)</button></span></div><div class=\"spark spv\" data-sp=\"1\" style=\"display:none\"><svg viewBox=\"0 0 320 110\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:100%; height:auto; background:#fffdf6; border-radius:8px;\"><polyline points=\"4.0,97.2 9.1,93.6 14.2,91.6 19.3,94.0 24.5,93.0 29.6,89.5 34.7,89.7 39.8,86.9 44.9,84.3 50.0,85.9 55.1,82.9 60.3,82.7 65.4,77.6 70.5,81.4 75.6,78.0 80.7,77.4 85.8,76.2 91.0,74.8 96.1,71.5 101.2,67.5 106.3,57.9 111.4,50.0 116.5,46.8 121.6,51.3 126.8,65.0 131.9,64.2 137.0,70.3 142.1,64.6 147.2,63.8 152.3,65.2 157.4,62.0 162.6,60.2 167.7,62.8 172.8,63.0 177.9,58.5 183.0,54.5 188.1,55.5 193.2,55.1 198.4,53.5 203.5,57.5 208.6,56.3 213.7,48.0 218.8,48.4 223.9,46.6 229.0,44.2 234.2,45.2 239.3,39.1 244.4,37.1 249.5,39.5 254.6,40.1 259.7,25.7 264.9,16.0 270.0,19.8 275.1,13.6 280.2,16.4 285.3,22.7 290.4,17.2 295.5,12.8 300.7,15.2 305.8,15.2 310.9,17.6 316.0,14.8\" fill=\"none\" stroke=\"#1c1c1e\" stroke-width=\"1.6\"/><circle cx=\"316.0\" cy=\"14.8\" r=\"4\" fill=\"#1c1c1e\"/></svg></div><div class=\"spark spv\" data-sp=\"3\" style=\"display:\"><svg viewBox=\"0 0 320 110\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:100%; height:auto; background:#fffdf6; border-radius:8px;\"><polyline points=\"4.0,97.0 6.1,96.3 8.3,95.9 10.4,92.9 12.5,95.5 14.7,92.2 16.8,91.4 19.0,90.9 21.1,92.0 23.2,90.3 25.4,91.0 27.5,91.5 29.6,89.4 31.8,90.2 33.9,87.5 36.1,87.3 38.2,87.7 40.3,83.6 42.5,83.8 44.6,86.2 46.7,85.6 48.9,84.4 51.0,79.7 53.2,83.9 55.3,80.5 57.4,83.5 59.6,83.8 6