柄は本日の分析対象外です（今夜の厳選・出尽くしサイン・レーティング変化・注目開示などの注目銘柄のみ、毎晩の実行で場中の5分足を取得して分析します）。</div><div class=\"spwrap\"><div class=\"nhead\">値動きと長期支持帯<span class=\"spbtns\"><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, '1')\">1年</button><button type=\"button\" class=\"spbtn on\" onclick=\"spSwap(this, '3')\">3年</button><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, '10')\">10年</button><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, 'all')\">全期間(26年)</button></span></div><div class=\"spark spv\" data-sp=\"1\" style=\"display:none\"><svg viewBox=\"0 0 320 110\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:100%; height:auto; background:#fffdf6; border-radius:8px;\"><polyline points=\"4.0,93.4 9.1,97.2 14.2,93.6 19.3,91.6 24.5,94.0 29.6,93.0 34.7,89.5 39.8,89.7 44.9,86.9 50.0,84.3 55.1,85.9 60.3,82.9 65.4,82.7 70.5,77.6 75.6,81.4 80.7,78.0 85.8,77.4 91.0,76.2 96.1,74.8 101.2,71.5 106.3,67.5 111.4,57.9 116.5,50.0 121.6,46.8 126.8,51.3 131.9,65.0 137.0,64.2 142.1,70.3 147.2,64.6 152.3,63.8 157.4,65.2 162.6,62.0 167.7,60.2 172.8,62.8 177.9,63.0 183.0,58.5 188.1,54.5 193.2,55.5 198.4,55.1 203.5,53.5 208.6,57.5 213.7,56.3 218.8,48.0 223.9,48.4 229.0,46.6 234.2,44.2 239.3,45.2 244.4,39.1 249.5,37.1 254.6,39.5 259.7,40.1 264.9,25.7 270.0,16.0 275.1,19.8 280.2,13.6 285.3,16.4 290.4,22.7 295.5,17.2 300.7,12.8 305.8,15.2 310.9,15.2 316.0,17.6\" fill=\"none\" stroke=\"#1c1c1e\" stroke-width=\"1.6\"/><circle cx=\"316.0\" cy=\"17.6\" r=\"4\" fill=\"#1c1c1e\"/></svg></div><div class=\"spark spv\" data-sp=\"3\" style=\"display:\"><svg viewBox=\"0 0 320 110\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:100%; height:auto; background:#fffdf6; border-radius:8px;\"><polyline points=\"4.0,97.2 6.1,88.8 8.3,89.6 10.4,90.6 12.5,86.6 14.7,87.7 16.8,84.9 19.0,84.8 21.1,86.2 23.2,83.8 25.4,83.5 27.5,85.9 29.6,84.4 31.8,84.0 33.9,82.2 36.1,82.9 38.2,80.6 40.3,80.8 42.5,77.2 44.6,76.9 46.7,81.2 48.9,79.3 51.0,78.0 53.2,74.6 55.3,76.2 57.4,74.2 59.6,77.8 6