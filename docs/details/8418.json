。</div><div class=\"spwrap\"><div class=\"nhead\">値動きと長期支持帯<span class=\"spbtns\"><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, '1')\">1年</button><button type=\"button\" class=\"spbtn on\" onclick=\"spSwap(this, '3')\">3年</button><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, '10')\">10年</button><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, 'all')\">全期間(26年)</button></span></div><div class=\"spark spv\" data-sp=\"1\" style=\"display:none\"><svg viewBox=\"0 0 320 110\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:100%; height:auto; background:#fffdf6; border-radius:8px;\"><polyline points=\"4.0,92.0 9.1,89.4 14.2,91.7 19.3,93.5 24.5,97.2 29.6,93.0 34.7,92.8 39.8,91.6 44.9,90.1 50.0,89.9 55.1,94.1 60.3,90.1 65.4,79.4 70.5,78.3 75.6,77.8 80.7,76.3 85.8,75.2 91.0,75.1 96.1,69.9 101.2,66.6 106.3,63.3 111.4,61.4 116.5,59.3 121.6,50.9 126.8,40.4 131.9,47.8 137.0,51.5 142.1,51.8 147.2,59.2 152.3,57.2 157.4,59.6 162.6,58.2 167.7,51.0 172.8,51.6 177.9,47.7 183.0,44.5 188.1,52.6 193.2,48.4 198.4,38.4 203.5,42.5 208.6,38.0 213.7,43.4 218.8,48.6 223.9,43.4 229.0,37.4 234.2,37.4 239.3,41.3 244.4,40.5 249.5,32.4 254.6,34.9 259.7,30.3 264.9,27.8 270.0,33.6 275.1,35.9 280.2,33.7 285.3,25.0 290.4,28.6 295.5,26.2 300.7,24.4 305.8,26.9 310.9,21.9 316.0,12.8\" fill=\"none\" stroke=\"#1c1c1e\" stroke-width=\"1.6\"/><circle cx=\"316.0\" cy=\"12.8\" r=\"4\" fill=\"#1c1c1e\"/></svg></div><div class=\"spark spv\" data-sp=\"3\" style=\"display:\"><svg viewBox=\"0 0 320 110\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:100%; height:auto; background:#fffdf6; border-radius:8px;\"><polyline points=\"4.0,90.4 6.1,91.8 8.3,92.7 10.4,93.0 12.5,94.2 14.7,94.2 16.8,90.8 19.0,94.6 21.1,94.4 23.2,92.7 25.4,93.9 27.5,91.4 29.6,93.9 31.8,97.2 33.9,95.3 36.1,93.2 38.2,92.5 40.3,90.2 42.5,89.2 44.6,88.2 46.7,88.1 48.9,84.9 51.0,83.5 53.2,77.9 55.3,83.8 57.4,81.1 59.6,85.1 61.7,84.0 63.8,81.9 66.0,82.2 68.1,81.6 70.2,81.9 72.4,75.7 74.5,73.9 76.7