・注目開示などの注目銘柄のみ、毎晩の実行で場中の5分足を取得して分析します）。</div><div class=\"spwrap\"><div class=\"nhead\">値動きと長期支持帯<span class=\"spbtns\"><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, '1')\">1年</button><button type=\"button\" class=\"spbtn on\" onclick=\"spSwap(this, '3')\">3年</button><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, '10')\">10年</button><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, 'all')\">全期間(27年)</button></span></div><div class=\"spark spv\" data-sp=\"1\" style=\"display:none\"><svg viewBox=\"0 0 320 110\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:100%; height:auto; background:#fffdf6; border-radius:8px;\"><rect x=\"0\" y=\"75.6\" width=\"320\" height=\"2.700000000000003\" fill=\"#c62f2f\" opacity=\"0.12\"/><polyline points=\"4.0,96.6 9.1,97.2 14.2,94.9 19.3,93.0 24.5,89.9 29.6,95.9 34.7,95.0 39.8,94.6 44.9,91.5 50.0,82.3 55.1,88.2 60.3,80.4 65.4,73.1 70.5,77.9 75.6,68.3 80.7,67.7 85.8,61.5 91.0,72.3 96.1,83.0 101.2,80.1 106.3,78.9 111.4,82.7 116.5,84.4 121.6,85.5 126.8,75.5 131.9,64.3 137.0,64.2 142.1,62.8 147.2,60.9 152.3,69.9 157.4,68.5 162.6,67.1 167.7,70.1 172.8,74.2 177.9,66.3 183.0,55.2 188.1,51.8 193.2,47.5 198.4,57.9 203.5,56.9 208.6,57.6 213.7,53.3 218.8,74.3 223.9,52.5 229.0,40.3 234.2,27.1 239.3,34.2 244.4,39.0 249.5,46.8 254.6,42.0 259.7,52.2 264.9,48.6 270.0,41.6 275.1,17.7 280.2,12.8 285.3,39.3 290.4,47.4 295.5,37.8 300.7,39.2 305.8,57.5 310.9,66.8 316.0,77.8\" fill=\"none\" stroke=\"#1c1c1e\" stroke-width=\"1.6\"/><path d=\"M 157.4 80.5 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 177.9 78.3 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 218.8 86.3 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><circle cx=\"316.0\" cy=\"77.8\" r=\"4\" fill=\"#1c1c1e\"/></svg></div><div class=\"spark spv\" data-sp=\"3\" style=\"display:\"><svg viewBox=\"0 0 320 110\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:100%; height:auto; background:#fffdf6; border-radius:8px;\"><rect x=\"0\" y=\"49.7\" width=\"320\" hei