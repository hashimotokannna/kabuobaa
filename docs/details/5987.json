4\" fill=\"#178a5b\"><title>23/6期 経常利益 2億円</title></circle><circle cx=\"256.7\" cy=\"65.5\" r=\"2.4\" fill=\"#178a5b\"><title>24/6期 経常利益 -2,317万円</title></circle><polyline points=\"83.3,31.8 170.0,21.0 256.7,130.0\" fill=\"none\" stroke=\"#7d55c7\" stroke-width=\"1.8\"/><circle cx=\"83.3\" cy=\"31.8\" r=\"2.4\" fill=\"#7d55c7\"><title>22/6期 純利益 2億円</title></circle><circle cx=\"170.0\" cy=\"21.0\" r=\"2.4\" fill=\"#7d55c7\"><title>23/6期 純利益 2億円</title></circle><circle cx=\"256.7\" cy=\"130.0\" r=\"2.4\" fill=\"#7d55c7\"><title>24/6期 純利益 -4億円</title></circle><text x=\"83.3\" y=\"144\" font-size=\"8.5\" fill=\"#a99a76\" text-anchor=\"middle\">22/6期</text><text x=\"170.0\" y=\"144\" font-size=\"8.5\" fill=\"#a99a76\" text-anchor=\"middle\">23/6期</text><text x=\"256.7\" y=\"144\" font-size=\"8.5\" fill=\"#a99a76\" text-anchor=\"middle\">24/6期</text><text x=\"303\" y=\"25.2\" font-size=\"8\" fill=\"#7ba0cc\">54億</text><text x=\"303\" y=\"132\" font-size=\"8\" fill=\"#7ba0cc\">売上</text><text x=\"4\" y=\"25.2\" font-size=\"8\" fill=\"#8a6f4d\">2億</text><text x=\"4\" y=\"132\" font-size=\"8\" fill=\"#8a6f4d\">利益</text></svg></div><div class=\"finlg\"><span><i style=\"background:#cfe0f5\"></i>売上高（右軸）</span><span><i style=\"background:#c9661f\"></i>営業利益</span><span><i style=\"background:#178a5b\"></i>経常利益</span><span><i style=\"background:#7d55c7\"></i>純利益</span></div><div class=\"finrow finhead\"><span class=\"fp\"></span><span class=\"fc\">売上高</span><span class=\"fc\">営業利益</span><span class=\"fc\">純利益</span></div><div class=\"finrow\"><span class=\"fp\">24/6期</span><span class=\"fc\">50億円</span><span class=\"fc\">5,598万円</span><span class=\"fc\">-4億円</span></div><div class=\"finrow\"><span class=\"fp\">23/6期</span><span class=\"fc\">54億円</span><span class=\"fc\">7,484万円</span><span class=\"fc\">2億円</span></div><div class=\"finrow\"><span class=\"fp\">22/6期</span><span class=\"fc\">53億円</span><span class=\"fc\">1億円</span><span class=\"fc\">2億円</span></div><div class=\"discnote\">グラフの棒・点にカーソルを合わせると数値が出ます。決算履歴は毎晩の実行で自動蓄積され、期間は時間とともに伸びていきます。古い年度はYahoo Financeの年次データで補完しています（この区間の経常利益は税引前利益で代用。決算短信の実測が入り次第、自動で置き換わります）。</div><div class=\"nhead\">ファンダメンタル指標</div><div class=\"fact\"><span>PER</span><span class=\"num\">8.6倍</span></div><div class=\"fact\"><span>PBR</span><span class=\"num\">0.49倍</span></div><div class=\"fact\"><span>ROE</span><span class=\"num\">5.7%</span></div><div class=\"fact\"><span>配当利回り</span><span class=\"num\">1.20%</span></div><div class=\"fact\"><span>時価総額</span><span class=\"num\">27億円</span></div><div class=\"nhead\">アナリスト・コンセンサス（証券会社レーティング）</div><div class=\"discnote\">この銘柄は現時点で<b>カバレッジ対象外</b>です（証券会社アナリストによる平均評価・平均目標株価の公表データがありません）。レーティングは主に中大型株が対象で、小型株はカバーされないことが多くあります。データが取得でき次第、ここに自動で表示されます。</div><div class=\"nhead\">板・売買フローの推定（09/24の5分足・AI）</div><div class=\"fprof\"><div class=\"fpcol\"><div class=\"fpbar\" style=\"height:3px\"></div><span class=\"fplab\">9時</span></div><div class=\"fpcol\"><div class=\"fpbar\" style=\"height:3px\"></div><span class=\"fplab\"></span></div><div class=\"fpcol\"><div class=\"fpbar\" style=\"height:46px\"></div><span class=\"fplab\">10時</span></div><div class=\"fpcol\"><div class=\"fpbar\" style=\"height:33px\"></div><span class=\"fplab\"></span></div><div class=\"fpcol\"><div class=\"fpbar\" style=\"height:7px\"></div><span class=\"fplab\">11時</span></div><div class=\"fpcol\"><div class=\"fpbar\" style=\"height:14px\"></div><span class=\"fplab\">12時半</span></div><div class=\"fpcol\"><div class=\"fpbar\" style=\"height:18px\"></div><span class=\"fplab\"></span></div><div class=\"fpcol\"><div class=\"fpbar\" style=\"height:3px\"></div><span class=\"fplab\">13時半</span></div><div class=\"fpcol\"><div class=\"fpbar\" style=\"height:4px\"></div><span class=\"fplab\"></span></div><div class=\"fpcol\"><div class=\"fpbar\" style=\"height:4px\"></div><span class=\"fplab\">14時半</span></div><div class=\"fpcol\"><div class=\"fpbar\" style=\"height:3px\"></div><span class=\"fplab\">引け</span></div></div><div class=\"fplegend\">時間帯ごとの出来高（どの時間に売買が集中したか）</div><div class=\"fact\"><span>この日の値動き</span><span class=\"num\">-15.7%（値幅17.5%）</span></div><div class=\"fact\"><span>出来高（普段の日足平均との比）</span><span class=\"num\">66.3倍</span></div><div class=\"fact\"><span>終値とVWAP（1日の平均約定価格）の差</span><span class=\"num\">-10.03%</span></div><div class=\"fact\"><span>寄り30分／引け30分の出来高シェア</span><span class=\"num\">0% ／ 1%</span></div><div class=\"fsub\">裏にいそうな売買主体（機械推定・上位2件）</div><div class=\"factor\"><div class=\"factorh\">🎯 個人の狼狽売り・損切り<span class=\"fconf\">一致度70・確度高</span></div><div class=\"exhwhy\">・日中-15.7%の下げ＋出来高66.3倍（損切りの投げが出た形）</div><div class=\"exhwhy\">・ほぼ安値引け（投げがまだ吸収されていない）</div></div><div class=\"factor\"><div class=\"factorh\">👤 個人の短期資金（イナゴ・飛びつき買い）<span class=\"fconf\">一致度65・確度中</span></div><div class=\"exhwhy\">・瞬間的な出来高スパイク37倍（イナゴ的な集中）</div><div class=\"exhwhy\">・午前に高値→その後失速（買いが続かず利確に押される形）</div><div class=\"exhwhy\">・出来高が普段の66.3倍に膨張</div></div><div class=\"discnote\">リアルタイムの板（気配値・注文残）は取引所の有料データのため、場中の5分足の値動きと出来高の「形」から典型パターンとの一致度で推定しています。実際の注文主体を特定するものではありません。寄り集中＝個人の飛びつき、引け集中＋VWAP沿い＝機関の執行、出来高増なのに値幅が静か＝大口の仕込み、といった市場の経験則を採点式にしたものです。</div><div class=\"spwrap\"><div class=\"nhead\">値動きと長期支持帯<span class=\"spbtns\"><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, '1')\">1年</button><button type=\"button\" class=\"spbtn on\" onclick=\"spSwap(this, '3')\">3年</button><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, '10')\">10年</button><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, 'all')\">全期間(27年)</button></span></div><div class=\"spark spv\" data-sp=\"1\" style=\"display:none\"><svg viewBox=\"0 0 320 110\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:100%; height:auto; background:#fffdf6; border-radius:8px;\"><rect x=\"0\" y=\"80.7\" width=\"320\" height=\"11.399999999999991\" fill=\"#c62f2f\" opacity=\"0.12\"/><polyline points=\"4.0,79.6 9.1,84.0 14.2,97.2 19.3,12.8 24.5,20.1 29.6,40.7 34.7,68.6 39.8,74.3 44.9,75.7 50.0,75.0 