5c7\"><title>23/3期 純利益 -13億円</title></circle><circle cx=\"137.5\" cy=\"107.5\" r=\"2.4\" fill=\"#7d55c7\"><title>24/3期 純利益 139億円</title></circle><circle cx=\"202.5\" cy=\"86.5\" r=\"2.4\" fill=\"#7d55c7\"><title>25/3期 純利益 280億円</title></circle><circle cx=\"267.5\" cy=\"70.4\" r=\"2.4\" fill=\"#7d55c7\"><title>26/3期 純利益 389億円</title></circle><text x=\"72.5\" y=\"144\" font-size=\"8.5\" fill=\"#a99a76\" text-anchor=\"middle\">23/3期</text><text x=\"137.5\" y=\"144\" font-size=\"8.5\" fill=\"#a99a76\" text-anchor=\"middle\">24/3期</text><text x=\"202.5\" y=\"144\" font-size=\"8.5\" fill=\"#a99a76\" text-anchor=\"middle\">25/3期</text><text x=\"267.5\" y=\"144\" font-size=\"8.5\" fill=\"#a99a76\" text-anchor=\"middle\">26/3期</text><text x=\"303\" y=\"25.2\" font-size=\"8\" fill=\"#7ba0cc\">1.18兆</text><text x=\"303\" y=\"132\" font-size=\"8\" fill=\"#7ba0cc\">売上</text><text x=\"4\" y=\"25.2\" font-size=\"8\" fill=\"#8a6f4d\">747億</text><text x=\"4\" y=\"132\" font-size=\"8\" fill=\"#8a6f4d\">利益</text></svg></div><div class=\"finlg\"><span><i style=\"background:#cfe0f5\"></i>売上高（右軸）</span><span><i style=\"background:#c9661f\"></i>営業利益</span><span><i style=\"background:#178a5b\"></i>経常利益</span><span><i style=\"background:#7d55c7\"></i>純利益</span></div><div class=\"finrow finhead\"><span class=\"fp\"></span><span class=\"fc\">売上高</span><span class=\"fc\">営業利益</span><span class=\"fc\">純利益</span></div><div class=\"finrow\"><span class=\"fp\">26/3期</span><span class=\"fc\">1.18兆円</span><span class=\"fc\">747億円</span><span class=\"fc\">389億円</span></div><div class=\"finrow\"><span class=\"fp\">25/3期</span><span class=\"fc\">9,988億円</span><span class=\"fc\">557億円</span><span class=\"fc\">280億円</span></div><div class=\"finrow\"><span class=\"fp\">24/3期</span><span class=\"fc\">8,928億円</span><span class=\"fc\">302億円</span><span class=\"fc\">139億円</span></div><div class=\"finrow\"><span class=\"fp\">23/3期</span><span class=\"fc\">9,557億円</span><span class=\"fc\">95億円</span><span class=\"fc\">-13億円</span></div><div class=\"discnote\">グラフの棒・点にカーソルを合わせると数値が出ます。決算履歴は毎晩の実行で自動蓄積され、期間は時間とともに伸びていきます。古い年度はYahoo Financeの年次データで補完しています（この区間の経常利益は税引前利益で代用。決算短信の実測が入り次第、自動で置き換わります）。</div><div class=\"nhead\">ファンダメンタル指標</div><div class=\"fact\"><span>PER</span><span class=\"num\">9.4倍</span></div><div class=\"fact\"><span>PBR</span><span class=\"num\">0.79倍</span></div><div class=\"fact\"><span>ROE</span><span class=\"num\">8.5%</span></div><div class=\"fact\"><span>配当利回り</span><span class=\"num\">1.89%</span></div><div class=\"fact\"><span>時価総額</span><span class=\"num\">3,355億円</span></div><div class=\"nhead\">アナリスト・コンセンサス（証券会社レーティング）</div><div class=\"fact\"><span>平均評価（1=強気買い〜5=売り）</span><span class=\"num\"><b>1.8</b>（買い）</span></div><div class=\"fact\"><span>カバーするアナリスト数</span><span class=\"num\">6名</span></div><div class=\"fact\"><span>平均目標株価</span><span class=\"num\">3,005円 （現在値から <span class=\"plus\">+62.2%</span>）</span></div><div class=\"fact\"><span>直近の変化（11/10）</span><span><b>平均目標株価が 3,235円 → 3,005円 に引き下げ</b></span></div><div class=\"discnote\">出所はYahoo Finance（LSEG集計）のコンセンサス＝複数証券会社の平均で、MINKABU等の記事になる個別証券会社の発表が集計されたものです。目標株価はアナリストの「予想」であり保証ではありません。カバレッジのある銘柄（主に中大型株）のみ表示。レーティングは株価を動かす需給材料として「情報として知っておく」用途で、このシステムの採点には現時点で使っていません（変化イベントを蓄積し、効果を検証してから判断します）。</div><div class=\"nhead\">板・売買フローの推定（AI）</div><div class=\"discnote\">この銘柄は本日の分析対象外です（今夜の厳選・出尽くしサイン・レーティング変化・注目開示などの注目銘柄のみ、毎晩の実行で場中の5分足を取得して分析します）。</div><div class=\"spwrap\"><div class=\"nhead\">値動きと長期支持帯<span class=\"spbtns\"><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, '1')\">1年</button><button type=\"button\" class=\"spbtn on\" onclick=\"spSwap(this, '3')\">3年</button><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, '10')\">10年</button><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, 'all')\">全期間(21年)</button></span></div><div class=\"spark spv\" data-sp=\"1\" style=\"display:none\"><svg viewBox=\"0 0 320 110\" xmlns=\"http://www.w3.org/2000/svg\" styl