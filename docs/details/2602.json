注目開示などの注目銘柄のみ、毎晩の実行で場中の5分足を取得して分析します）。</div><div class=\"spwrap\"><div class=\"nhead\">値動きと長期支持帯<span class=\"spbtns\"><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, '1')\">1年</button><button type=\"button\" class=\"spbtn on\" onclick=\"spSwap(this, '3')\">3年</button><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, '10')\">10年</button><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, 'all')\">全期間(26年)</button></span></div><div class=\"spark spv\" data-sp=\"1\" style=\"display:none\"><svg viewBox=\"0 0 320 110\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:100%; height:auto; background:#fffdf6; border-radius:8px;\"><rect x=\"0\" y=\"63.5\" width=\"320\" height=\"9.900000000000006\" fill=\"#c62f2f\" opacity=\"0.12\"/><polyline points=\"4.0,92.0 9.1,90.7 14.2,86.8 19.3,94.6 24.5,92.0 29.6,90.7 34.7,88.1 39.8,88.1 44.9,84.9 50.0,97.2 55.1,94.0 60.3,89.4 65.4,84.2 70.5,83.6 75.6,77.7 80.7,72.5 85.8,57.6 91.0,61.5 96.1,58.9 101.2,50.4 106.3,41.3 111.4,43.9 116.5,30.9 121.6,33.5 126.8,44.6 131.9,53.0 137.0,50.4 142.1,44.6 147.2,47.1 152.3,45.1 157.4,48.9 162.6,57.4 167.7,71.9 172.8,72.5 177.9,76.2 183.0,72.9 188.1,78.1 193.2,88.1 198.4,92.0 203.5,81.0 208.6,73.0 213.7,75.6 218.8,69.7 223.9,65.8 229.0,57.6 234.2,59.6 239.3,53.5 244.4,48.5 249.5,33.4 254.6,69.1 259.7,48.1 264.9,35.6 270.0,21.7 275.1,25.2 280.2,17.6 285.3,22.9 290.4,12.8 295.5,13.9 300.7,33.8 305.8,36.0 310.9,33.1 316.0,24.7\" fill=\"none\" stroke=\"#1c1c1e\" stroke-width=\"1.6\"/><path d=\"M 147.2 59.1 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 254.6 81.1 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><circle cx=\"316.0\" cy=\"24.7\" r=\"4\" fill=\"#1c1c1e\"/></svg></div><div class=\"spark spv\" data-sp=\"3\" style=\"display:\"><svg viewBox=\"0 0 320 110\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:100%; height:auto; background:#fffdf6; border-radius:8px;\"><rect x=\"0\" y=\"39.0\" width=\"320\" height=\"5.600000000000001\" fill=\"#c62f2f\" opacity=\"0.12\"/