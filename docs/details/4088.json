分析対象外です（今夜の厳選・出尽くしサイン・レーティング変化・注目開示などの注目銘柄のみ、毎晩の実行で場中の5分足を取得して分析します）。</div><div class=\"spwrap\"><div class=\"nhead\">値動きと長期支持帯<span class=\"spbtns\"><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, '1')\">1年</button><button type=\"button\" class=\"spbtn on\" onclick=\"spSwap(this, '3')\">3年</button><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, '10')\">10年</button><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, 'all')\">全期間(26年)</button></span></div><div class=\"spark spv\" data-sp=\"1\" style=\"display:none\"><svg viewBox=\"0 0 320 110\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:100%; height:auto; background:#fffdf6; border-radius:8px;\"><polyline points=\"4.0,82.9 9.1,82.3 14.2,78.7 19.3,83.0 24.5,83.8 29.6,81.1 34.7,72.6 39.8,72.5 44.9,70.4 50.0,65.3 55.1,65.2 60.3,66.7 65.4,66.7 70.5,61.7 75.6,52.2 80.7,89.4 85.8,86.1 91.0,85.8 96.1,92.0 101.2,86.2 106.3,87.5 111.4,82.4 116.5,78.3 121.6,72.3 126.8,75.6 131.9,73.2 137.0,77.8 142.1,76.8 147.2,97.2 152.3,71.7 157.4,50.5 162.6,44.1 167.7,57.3 172.8,56.6 177.9,58.9 183.0,56.0 188.1,38.6 193.2,32.7 198.4,32.7 203.5,49.8 208.6,51.8 213.7,49.3 218.8,45.3 223.9,50.7 229.0,49.9 234.2,50.3 239.3,54.4 244.4,53.2 249.5,38.9 254.6,12.8 259.7,16.2 264.9,17.7 270.0,28.1 275.1,21.9 280.2,27.1 285.3,34.5 290.4,42.8 295.5,30.1 300.7,26.8 305.8,28.7 310.9,23.1 316.0,13.2\" fill=\"none\" stroke=\"#1c1c1e\" stroke-width=\"1.6\"/><circle cx=\"316.0\" cy=\"13.2\" r=\"4\" fill=\"#1c1c1e\"/></svg></div><div class=\"spark spv\" data-sp=\"3\" style=\"display:\"><svg viewBox=\"0 0 320 110\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:100%; height:auto; background:#fffdf6; border-radius:8px;\"><polyline points=\"4.0,80.7 6.1,81.5 8.3,83.3 10.4,84.6 12.5,88.4 14.7,90.0 16.8,85.4 19.0,82.8 21.1,82.7 23.2,83.1 25.4,82.3 27.5,77.2 29.6,72.5 31.8,66.0 33.9,67.1 36.1,56.7 38.2,59.8 40.3,56.5 42.5,59.1 44.6,58.0 46.7,55.5 48.9,58.5 51.0,55.0 53.2,52.4 55.3,63.9 57.4,65.3 59.6,61.9 61.7,6