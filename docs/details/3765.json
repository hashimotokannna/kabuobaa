b3\"></div><div class=\"mz\" style=\"left:50.0%; width:10.0%; background:#eeeae0\"></div><div class=\"mz\" style=\"left:60.0%; width:40.0%; background:#b9dcc0\"></div><div class=\"mpin\" style=\"left:49.7%\"></div></div><span class=\"mv num\">-0%</span></div><div class=\"mrow\"><span class=\"ml\">自己資本比率</span><div class=\"mtrack\"><div class=\"mz\" style=\"left:0.0%; width:20.0%; background:#f2c4a8\"></div><div class=\"mz\" style=\"left:20.0%; width:15.0%; background:#f5e6b3\"></div><div class=\"mz\" style=\"left:35.0%; width:15.0%; background:#eeeae0\"></div><div class=\"mz\" style=\"left:50.0%; width:50.0%; background:#b9dcc0\"></div><div class=\"mpin\" style=\"left:85.4%\"></div></div><span class=\"mv num\">85%</span></div><div class=\"mrow\"><span class=\"ml\">営業利益率</span><div class=\"mtrack\"><div class=\"mz\" style=\"left:0.0%; width:25.0%; background:#f2c4a8\"></div><div class=\"mz\" style=\"left:25.0%; width:12.5%; background:#f5e6b3\"></div><div class=\"mz\" style=\"left:37.5%; width:12.5%; background:#eeeae0\"></div><div class=\"mz\" style=\"left:50.0%; width:50.0%; background:#b9dcc0\"></div><div class=\"mpin\" style=\"left:59.7%\"></div></div><span class=\"mv num\">13.9%</span></div><div class=\"mrow\"><span class=\"ml\">ROA</span><div class=\"mtrack\"><div class=\"mz\" style=\"left:0.0%; width:20.0%; background:#f2c4a8\"></div><div class=\"mz\" style=\"left:20.0%; width:8.0%; background:#f5e6b3\"></div><div class=\"mz\" style=\"left:28.0%; width:12.0%; background:#eeeae0\"></div><div class=\"mz\" style=\"left:40.0%; width:60.0%; background:#b9dcc0\"></div><div class=\"mpin\" style=\"left:24.0%\"></div></div><span class=\"mv num\">1.0%</span></div></div><div class=\"discnote\">ピンが現在値。PER・PBRなど価値系は「標準」が最も安心、割安は魅力だが「割安の罠」の確認が必要。RSI・ボリンジャーなど行きすぎ系は売られすぎ側が押し目買いに有利。読み方は「指標の読み方」ページへ。</div><div class=\"nhead\">スコア 120点（候補圏外）</div><div class=\"reason\">・直近20日高値から −6.1%（安さの主基準 +49点・8%で頭打ち）</div><div class=\"reason\">・下げが複数日に分散した「じわ下げ」で、1日の急落で作られた安さではない（+15点）</div><div class=\"reason\">・日々の値動きが±2.2%と穏やかで読みやすい（+10点）</div><div class=\"reason\">・200日平均線より上での下げ＝上昇トレンド中の一時的な押し目（+20点）</div><div class=\"reason\">・1年高値からの下落 −13% で長期トレンド健全（+12点）</div><div class=\"reason\">・1年の値幅の中腹（下から52%）での下げ。底抜けでも高値掴みでもない位置（+10点）</div><div class=\"reason\">・過去1年、同じ買い方で 1回 利確ライン（+5%）に到達（+5点）</div><div class=\"reason\">・利確まで平均 55営業日と資金拘束が長め。短期回転スタイルでは機会損失（−5点）</div><div class=\"reason\">・ただし直近の仮想買いが塩漬け中（−15点）</div><div class=\"reason\">・長期支持帯 2,206円付近は過去6回試されており、今回で7回目。支持線は試されるほど割れやすい（−5点・警戒）</div><div class=\"reason\">・50日線が200日線の下（長期は調整形・加点なし）</div><div class=\"reason\">・RSI(14)=35 でやや売られすぎ（+5点）</div><div class=\"reason\">・一目均衡表の雲の上（中期の地合いは良好 +4点）</div><div class=\"reason\">・PER 80.4倍と利益に対して異常な割高。期待剥落時の下げが深い（−10点）</div><div class=\"reason\">・PBR 0.93倍と資産に対して割安圏。下値が固くなりやすい（+6点）</div><div class=\"reason\">・ROE 1.2%と収益力が弱い（−5点）</div><div class=\"reason\">・時価総額1,344億円の中大型で値動きが安定しやすい（+3点）</div><div class=\"reason\">・自己資本比率85%と財務が厚く倒産リスクが低い（+4点）</div><div class=\"reason\">・営業利益率13.9%と本業の稼ぐ力が高い（+3点）</div><div class=\"reason\">・夜間ギャップ（翌朝の窓開け）平均±0.8%と小さく、夜に決めた指値が翌朝も有効に働きやすい（+8点）</div><div class=\"reason\">・1日平均 8.9億円の売買（+6点）</div><div class=\"nhead\">減点方式: 全体2,637位（−47点）</div><div class=\"hit\"><span class=\"sev sevB\">重い</span>PER 80倍と期待先行の割高<span class=\"num hp\">−15</span></div><div class=\"hit\"><span class=\"sev sevB\">重い</span>ROE 1.2%と稼ぐ力が弱い<span class=\"num hp\">−12</span></div><div class=\"hit\"><span class=\"sev sevB\">重い</span>50日線が200日線の下（長期は調整形）<span class=\"num hp\">−10</span></div><div class=\"hit\"><span class=\"sev sevC\">軽い</span>利確まで平均55日と資金拘束が長い<span class=\"num hp\">−5</span></div><div class=\"hit\"><span class=\"sev sevC\">軽い</span>直近の仮想買いが塩漬け中<span class=\"num hp\">−5</span></div><div class=\"nhead\">TOB素地スコア: 48点（全体859位）</div><div class=\"reason\">・PBR 0.93倍 ＝ 1倍割れ（東証の改善要請対象圏）（+10）</div><div class=\"reason\">・時価総額 1,344億円 ＝ 買収資金が十分現実的（+8）</div><div class=\"reason\">・自己資本比率 85% ＝ ほぼ無借金のため込み体質（+12）</div><div class=\"reason\">・厚い資本にROE 1.2% ＝ 資本を活かせていない（アクティビスト誘因）（+6）</div><div class=\"reason\">・営業利益率 13.9% ＝ 本業の稼ぐ力あり（+8）</div><div class=\"reason\">・プライムでPBR1倍割れ ＝ 東証の改善要請が直撃（+4）</div><div class=\"discnote\">買収・非公開化されやすい「体質」の順位で、発生の予測ではありません。全体像と注意点は上部タブの「TOB素地」ページへ。</div><div class=\"nhead\">業績の推移（通期実績の推移・決算短信より）</div><div class=\"finchart\"><svg viewBox=\"0 0 340 150\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:100%; height:auto; background:#fffdf6; border-radius:8px;\"><rect x=\"55.5\" y=\"35.0\" width=\"34.0\" height=\"95.0\" rx=\"2\" fill=\"#cfe0f5\"><title>22/12期 売上高 1,055億円</title></rect><rect x=\"120.5\" y=\"17.2\" width=\"34.0\" height=\"112.8\" rx=\"2\" fill=\"#cfe0f5\"><title>23/12期 売上高 1,253億円</title></rect><rect x=\"185.5\" y=\"36.7\" width=\"34.0\" height=\"93.3\" rx=\"2\" fill=\"#cfe0f5\"><title>24/12期 売上高 1,036億円</title></rect><rect x=\"250.5\" y=\"46.1\" width=\"34.0\" height=\"83.9\" rx=\"2\" fill=\"#cfe0f5\"><title>25/12期 売上高 932億円</title></rect><polyline points=\"72.5,25.1 137.5,24.2 202.5,63.6 267.5,110.8\" fill=\"none\" stroke=\"#c9661f\" stroke-width=\"1.8\"/><circle cx=\"72.5\" cy=\"25.1\" r=\"2.4\" fill=\"#c9661f\"><title>22/12期 営業利益 276億円</title></circle><circle cx=\"137.5\" cy=\"24.2\" r=\"2.4\" fill=\"#c9661f\"><title>23/12期 営業利益 279億円</title></circle><circle cx=\"202.5\" cy=\"63.6\" r=\"2.4\" fill=\"#c9661f\"><title>24/12期 営業利益 175億円</title></circle><circle cx=\"267.5\" cy=\"110.8\" r=\"2.4\" fill=\"#c9661f\"><title>25/12期 営業利益 51億円</title></circle><polyline points=\"72.5,20.2 137.5,17.2 202.5,54.7 267.5,105.0\" fill=\"none\" stroke=\"#178a5b\" stroke-width=\"1.8\"/><circle cx=\"72.5\" cy=\"20.2\" r=\"2.4\" fill=\"#178a5b\"><title>22/12期 経常利益 289億円</title></circle><circle cx=\"137.5\" cy=\"17.2\" r=\"2.4\" fill=\"#178a5b\"><title>23/12期 経常利益 297億円</title></circle><circle cx=\"202.5\" cy=\"54.7\" r=\"2.4\" fill=\"#178a5b\"><title>24/12期 経常利益 198億円</title></circle><circle cx=\"267.5\" cy=\"105.0\" r=\"2.4\" fill=\"#178a5b\"><title>25/12期 経常利益 66億円</title></circle><