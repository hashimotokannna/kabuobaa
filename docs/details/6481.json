button\" class=\"spbtn\" onclick=\"spSwap(this, '10')\">10年</button><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, 'all')\">全期間(26年)</button></span></div><div class=\"spark spv\" data-sp=\"1\" style=\"display:none\"><svg viewBox=\"0 0 320 110\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:100%; height:auto; background:#fffdf6; border-radius:8px;\"><rect x=\"0\" y=\"93.0\" width=\"320\" height=\"4.200000000000003\" fill=\"#c62f2f\" opacity=\"0.12\"/><polyline points=\"4.0,96.1 9.1,95.4 14.2,91.9 19.3,88.8 24.5,86.7 29.6,91.6 34.7,90.3 39.8,91.9 44.9,90.1 50.0,87.5 55.1,86.5 60.3,86.4 65.4,79.4 70.5,72.9 75.6,66.6 80.7,71.8 85.8,65.1 91.0,60.6 96.1,76.0 101.2,71.0 106.3,75.2 111.4,75.3 116.5,69.9 121.6,71.5 126.8,57.3 131.9,57.8 137.0,61.3 142.1,52.2 147.2,29.6 152.3,16.0 157.4,25.5 162.6,23.3 167.7,17.9 172.8,26.7 177.9,26.6 183.0,13.2 188.1,13.2 193.2,21.3 198.4,12.8 203.5,13.5 208.6,26.1 213.7,24.9 218.8,46.7 223.9,27.0 229.0,27.8 234.2,17.1 239.3,29.6 244.4,32.4 249.5,44.1 254.6,48.4 259.7,52.1 264.9,43.7 270.0,38.3 275.1,33.3 280.2,34.4 285.3,44.3 290.4,56.4 295.5,50.5 300.7,57.6 305.8,63.9 310.9,77.6 316.0,86.8\" fill=\"none\" stroke=\"#1c1c1e\" stroke-width=\"1.6\"/><path d=\"M 4.0 108.1 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 4.0 108.1 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 4.0 108.1 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 4.0 108.1 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 4.0 108.1 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 39.8 103.9 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><circle cx=\"316.0\" cy=\"86.8\" r=\"4\" fill=\"#1c1c1e\"/></svg></div><div class=\"spark spv\" data-sp=\"3\" style=\"display:\"><svg viewBox=\"0 0 320 110\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:100%; height:auto; background:#fffdf6; border-radius:8px;\"><rect x=\"0\" y=\"73.4\" width=\"320\" height=\"3.0\" fill=\"#c62f2f\" opacity=\"0.12\"/><polyline points=\"4.0,89.4 6.1,88.4 8.3,88.8 10.4,89.9 12.5,91.2 14.7,91.4 16.8,