外です（今夜の厳選・出尽くしサイン・レーティング変化・注目開示などの注目銘柄のみ、毎晩の実行で場中の5分足を取得して分析します）。</div><div class=\"spwrap\"><div class=\"nhead\">値動きと長期支持帯<span class=\"spbtns\"><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, '1')\">1年</button><button type=\"button\" class=\"spbtn on\" onclick=\"spSwap(this, '3')\">3年</button><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, '10')\">10年</button><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, 'all')\">全期間(27年)</button></span></div><div class=\"spark spv\" data-sp=\"1\" style=\"display:none\"><svg viewBox=\"0 0 320 110\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:100%; height:auto; background:#fffdf6; border-radius:8px;\"><rect x=\"0\" y=\"67.6\" width=\"320\" height=\"16.700000000000003\" fill=\"#c62f2f\" opacity=\"0.12\"/><polyline points=\"4.0,42.4 9.1,38.9 14.2,40.8 19.3,38.9 24.5,52.2 29.6,56.5 34.7,67.9 39.8,60.5 44.9,63.0 50.0,66.1 55.1,50.2 60.3,51.4 65.4,55.0 70.5,56.4 75.6,57.9 80.7,49.7 85.8,60.5 91.0,72.8 96.1,80.2 101.2,77.3 106.3,82.5 111.4,75.2 116.5,84.3 121.6,81.8 126.8,90.5 131.9,86.6 137.0,92.5 142.1,87.6 147.2,81.0 152.3,74.7 157.4,77.5 162.6,73.4 167.7,89.0 172.8,97.2 177.9,83.0 183.0,78.2 188.1,70.8 193.2,68.3 198.4,57.8 203.5,50.8 208.6,53.0 213.7,51.0 218.8,58.9 223.9,45.9 229.0,33.9 234.2,37.0 239.3,33.7 244.4,30.8 249.5,12.8 254.6,23.3 259.7,73.7 264.9,66.8 270.0,68.9 275.1,62.1 280.2,57.8 285.3,70.7 290.4,65.2 295.5,59.7 300.7,60.1 305.8,52.7 310.9,50.8 316.0,50.3\" fill=\"none\" stroke=\"#1c1c1e\" stroke-width=\"1.6\"/><path d=\"M 4.0 54.4 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 4.0 54.4 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 4.0 54.4 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 4.0 54.4 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 4.0 54.4 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 4.0 54.4 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 34.7 79.9 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 264.9 78.8 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><p