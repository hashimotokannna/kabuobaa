">3年</button><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, '10')\">10年</button><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, 'all')\">全期間(26年)</button></span></div><div class=\"spark spv\" data-sp=\"1\" style=\"display:none\"><svg viewBox=\"0 0 320 110\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:100%; height:auto; background:#fffdf6; border-radius:8px;\"><rect x=\"0\" y=\"46.9\" width=\"320\" height=\"9.800000000000004\" fill=\"#c62f2f\" opacity=\"0.12\"/><polyline points=\"4.0,97.2 9.1,92.3 14.2,89.6 19.3,92.2 24.5,85.9 29.6,86.4 34.7,84.4 39.8,78.4 44.9,79.7 50.0,78.0 55.1,73.2 60.3,67.3 65.4,52.1 70.5,49.2 75.6,53.5 80.7,49.5 85.8,38.3 91.0,36.3 96.1,26.2 101.2,12.8 106.3,22.8 111.4,30.0 116.5,38.2 121.6,36.6 126.8,31.8 131.9,32.3 137.0,24.9 142.1,33.6 147.2,38.1 152.3,44.0 157.4,40.9 162.6,28.1 167.7,32.8 172.8,37.9 177.9,41.0 183.0,54.2 188.1,49.7 193.2,44.9 198.4,48.8 203.5,48.5 208.6,50.1 213.7,49.7 218.8,48.4 223.9,44.9 229.0,43.2 234.2,46.5 239.3,39.1 244.4,38.5 249.5,45.2 254.6,38.8 259.7,31.7 264.9,30.0 270.0,29.5 275.1,27.0 280.2,24.1 285.3,32.5 290.4,29.9 295.5,22.6 300.7,28.2 305.8,22.9 310.9,27.0 316.0,36.8\" fill=\"none\" stroke=\"#1c1c1e\" stroke-width=\"1.6\"/><path d=\"M 121.6 48.6 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 152.3 56.0 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 183.0 66.2 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 198.4 60.8 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 218.8 60.4 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><circle cx=\"316.0\" cy=\"36.8\" r=\"4\" fill=\"#1c1c1e\"/></svg></div><div class=\"spark spv\" data-sp=\"3\" style=\"display:\"><svg viewBox=\"0 0 320 110\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:100%; height:auto; background:#fffdf6; border-radius:8px;\"><rect x=\"0\" y=\"31.0\" width=\"320\" height=\"6.299999999999997\" fill=\"#c62f2f\" opacity=\"0.12\"/><polyline points=\"4.0,95.7 6.1,97.2 8.3,95.5 10.4,95.7 12.5,94.9 14.7,94.5 16.8,95.7 19.0,96