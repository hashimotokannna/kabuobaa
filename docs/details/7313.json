\">板・売買フローの推定（AI）</div><div class=\"discnote\">この銘柄は本日の分析対象外です（今夜の厳選・出尽くしサイン・レーティング変化・注目開示などの注目銘柄のみ、毎晩の実行で場中の5分足を取得して分析します）。</div><div class=\"spwrap\"><div class=\"nhead\">値動きと長期支持帯<span class=\"spbtns\"><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, '1')\">1年</button><button type=\"button\" class=\"spbtn on\" onclick=\"spSwap(this, '3')\">3年</button><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, '10')\">10年</button><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, 'all')\">全期間(20年)</button></span></div><div class=\"spark spv\" data-sp=\"1\" style=\"display:none\"><svg viewBox=\"0 0 320 110\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:100%; height:auto; background:#fffdf6; border-radius:8px;\"><rect x=\"0\" y=\"64.7\" width=\"320\" height=\"32.5\" fill=\"#c62f2f\" opacity=\"0.12\"/><polyline points=\"4.0,53.1 9.1,44.0 14.2,35.0 19.3,43.3 24.5,40.1 29.6,36.6 34.7,66.5 39.8,59.9 44.9,55.1 50.0,61.7 55.1,60.5 60.3,56.1 65.4,48.6 70.5,43.2 75.6,33.3 80.7,25.9 85.8,27.3 91.0,32.1 96.1,33.1 101.2,20.2 106.3,13.5 111.4,13.6 116.5,12.8 121.6,26.3 126.8,42.2 131.9,54.5 137.0,60.2 142.1,50.7 147.2,48.9 152.3,53.5 157.4,57.0 162.6,58.2 167.7,64.1 172.8,69.9 177.9,62.2 183.0,50.6 188.1,57.6 193.2,57.5 198.4,55.2 203.5,49.6 208.6,60.8 213.7,66.9 218.8,70.1 223.9,65.3 229.0,55.7 234.2,64.5 239.3,59.8 244.4,55.7 249.5,34.8 254.6,57.1 259.7,50.7 264.9,46.6 270.0,41.9 275.1,44.1 280.2,42.3 285.3,53.6 290.4,50.9 295.5,45.8 300.7,59.4 305.8,63.4 310.9,61.8 316.0,53.9\" fill=\"none\" stroke=\"#1c1c1e\" stroke-width=\"1.6\"/><path d=\"M 4.0 65.1 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 4.0 65.1 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 4.0 65.1 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 4.0 65.1 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 4.0 65.1 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 4.0 65.1 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 4.0 65.1 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 4.0 6