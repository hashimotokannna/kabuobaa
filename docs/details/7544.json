')\">10年</button><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, 'all')\">全期間(26年)</button></span></div><div class=\"spark spv\" data-sp=\"1\" style=\"display:none\"><svg viewBox=\"0 0 320 110\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:100%; height:auto; background:#fffdf6; border-radius:8px;\"><rect x=\"0\" y=\"58.7\" width=\"320\" height=\"38.5\" fill=\"#c62f2f\" opacity=\"0.12\"/><polyline points=\"4.0,69.1 9.1,88.3 14.2,64.6 19.3,51.3 24.5,57.2 29.6,61.7 34.7,63.2 39.8,63.2 44.9,70.6 50.0,66.1 55.1,63.2 60.3,12.8 65.4,21.7 70.5,21.7 75.6,14.2 80.7,27.6 85.8,35.0 91.0,38.0 96.1,42.4 101.2,45.4 106.3,26.1 111.4,66.1 116.5,45.4 121.6,21.7 126.8,70.6 131.9,63.2 137.0,63.2 142.1,33.5 147.2,60.2 152.3,69.1 157.4,64.6 162.6,73.5 167.7,66.1 172.8,66.1 177.9,66.1 183.0,67.6 188.1,42.4 193.2,51.3 198.4,51.3 203.5,54.3 208.6,60.2 213.7,54.3 218.8,52.8 223.9,67.6 229.0,57.2 234.2,51.3 239.3,43.9 244.4,52.8 249.5,58.7 254.6,58.7 259.7,58.7 264.9,60.2 270.0,57.2 275.1,69.1 280.2,63.2 285.3,55.7 290.4,60.2 295.5,57.2 300.7,69.1 305.8,64.6 310.9,69.1 316.0,69.1\" fill=\"none\" stroke=\"#1c1c1e\" stroke-width=\"1.6\"/><path d=\"M 4.0 81.1 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 34.7 75.2 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 55.1 75.2 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 96.1 54.4 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 111.4 78.1 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 131.9 75.2 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 183.0 79.6 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 229.0 69.2 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 249.5 70.7 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 275.1 81.1 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 300.7 81.1 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><circle cx=\"316.0\" cy=\"69.1\" r=\"4\" fill=\"#1c1c1e\"/></svg></div><div class=\"spark spv\" data-sp=\"3\" style=\"display:\"><svg viewBox=\"0 0 320 110\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width