3年</button><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, '10')\">10年</button><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, 'all')\">全期間(26年)</button></span></div><div class=\"spark spv\" data-sp=\"1\" style=\"display:none\"><svg viewBox=\"0 0 320 110\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:100%; height:auto; background:#fffdf6; border-radius:8px;\"><rect x=\"0\" y=\"81.2\" width=\"320\" height=\"12.5\" fill=\"#c62f2f\" opacity=\"0.12\"/><polyline points=\"4.0,73.1 9.1,62.7 14.2,65.4 19.3,58.7 24.5,54.0 29.6,49.3 34.7,42.6 39.8,42.2 44.9,35.2 50.0,28.1 55.1,31.2 60.3,35.5 65.4,28.1 70.5,13.5 75.6,18.7 80.7,12.8 85.8,26.9 91.0,47.7 96.1,43.4 101.2,49.7 106.3,43.0 111.4,42.2 116.5,37.5 121.6,37.5 126.8,46.9 131.9,55.2 137.0,59.1 142.1,48.5 147.2,68.8 152.3,74.1 157.4,69.7 162.6,80.4 167.7,73.4 172.8,68.1 177.9,70.7 183.0,71.9 188.1,63.8 193.2,67.5 198.4,72.9 203.5,61.9 208.6,64.6 213.7,56.4 218.8,54.0 223.9,51.3 229.0,60.3 234.2,60.3 239.3,57.9 244.4,61.5 249.5,69.4 254.6,68.4 259.7,62.7 264.9,74.0 270.0,83.3 275.1,85.2 280.2,79.6 285.3,78.1 290.4,83.3 295.5,80.7 300.7,76.8 305.8,89.5 310.9,97.2 316.0,84.2\" fill=\"none\" stroke=\"#1c1c1e\" stroke-width=\"1.6\"/><path d=\"M 4.0 85.1 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 4.0 85.1 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 4.0 85.1 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 4.0 85.1 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 4.0 85.1 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 162.6 92.4 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 275.1 97.2 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><circle cx=\"316.0\" cy=\"84.2\" r=\"4\" fill=\"#1c1c1e\"/></svg></div><div class=\"spark spv\" data-sp=\"3\" style=\"display:\"><svg viewBox=\"0 0 320 110\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:100%; height:auto; background:#fffdf6; border-radius:8px;\"><rect x=\"0\" y=\"81.2\" width=\"320\" height=\"12.5\" fill=\"#c62f2f\" opacity=\"0.12\"/><polyline poi