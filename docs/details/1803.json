ap\"><div class=\"nhead\">値動きと長期支持帯<span class=\"spbtns\"><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, '1')\">1年</button><button type=\"button\" class=\"spbtn on\" onclick=\"spSwap(this, '3')\">3年</button><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, '10')\">10年</button><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, 'all')\">全期間(27年)</button></span></div><div class=\"spark spv\" data-sp=\"1\" style=\"display:none\"><svg viewBox=\"0 0 320 110\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:100%; height:auto; background:#fffdf6; border-radius:8px;\"><rect x=\"0\" y=\"97.1\" width=\"320\" height=\"2\" fill=\"#c62f2f\" opacity=\"0.12\"/><polyline points=\"4.0,78.1 9.1,68.3 14.2,64.7 19.3,54.4 24.5,59.2 29.6,57.9 34.7,60.2 39.8,60.3 44.9,59.7 50.0,54.2 55.1,50.9 60.3,50.5 65.4,52.7 70.5,55.4 75.6,45.7 80.7,15.9 85.8,28.6 91.0,17.3 96.1,12.8 101.2,28.2 106.3,36.6 111.4,37.8 116.5,43.8 121.6,54.3 126.8,50.8 131.9,48.1 137.0,47.8 142.1,51.0 147.2,32.9 152.3,40.1 157.4,46.1 162.6,63.5 167.7,55.5 172.8,64.9 177.9,67.7 183.0,73.3 188.1,65.1 193.2,69.7 198.4,65.3 203.5,63.3 208.6,68.8 213.7,66.8 218.8,69.8 223.9,69.6 229.0,76.8 234.2,74.0 239.3,72.8 244.4,76.6 249.5,73.9 254.6,70.8 259.7,72.7 264.9,75.6 270.0,72.9 275.1,83.9 280.2,89.6 285.3,92.2 290.4,96.3 295.5,92.8 300.7,89.3 305.8,91.3 310.9,88.5 316.0,82.0\" fill=\"none\" stroke=\"#1c1c1e\" stroke-width=\"1.6\"/><path d=\"M 4.0 90.1 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 290.4 108.3 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><circle cx=\"316.0\" cy=\"82.0\" r=\"4\" fill=\"#1c1c1e\"/></svg></div><div class=\"spark spv\" data-sp=\"3\" style=\"display:\"><svg viewBox=\"0 0 320 110\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:100%; height:auto; background:#fffdf6; border-radius:8px;\"><rect x=\"0\" y=\"62.3\" width=\"320\" height=\"2\" fill=\"#c62f2f\" opacity=\"0.12\"/><polyline points=\"4.0,94.6 6.1,93.6 8.3,92.5 10.4,93.0 12.5,93.8 14.7,94.3 16.8,95.2 19.0,94