)\">3年</button><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, '10')\">10年</button><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, 'all')\">全期間(17年)</button></span></div><div class=\"spark spv\" data-sp=\"1\" style=\"display:none\"><svg viewBox=\"0 0 320 110\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:100%; height:auto; background:#fffdf6; border-radius:8px;\"><rect x=\"0\" y=\"81.9\" width=\"320\" height=\"2\" fill=\"#c62f2f\" opacity=\"0.12\"/><polyline points=\"4.0,97.2 9.1,92.8 14.2,94.3 19.3,96.3 24.5,94.9 29.6,88.9 34.7,87.5 39.8,81.0 44.9,78.3 50.0,85.5 55.1,81.9 60.3,72.2 65.4,66.5 70.5,68.1 75.6,65.8 80.7,66.2 85.8,66.6 91.0,64.0 96.1,65.8 101.2,64.4 106.3,34.0 111.4,22.0 116.5,27.0 121.6,28.1 126.8,34.9 131.9,37.3 137.0,36.2 142.1,23.9 147.2,16.0 152.3,12.8 157.4,14.4 162.6,16.5 167.7,31.7 172.8,40.3 177.9,25.6 183.0,54.1 188.1,49.9 193.2,35.3 198.4,38.9 203.5,38.0 208.6,34.5 213.7,27.5 218.8,32.7 223.9,58.2 229.0,58.2 234.2,67.1 239.3,63.0 244.4,68.3 249.5,66.8 254.6,74.6 259.7,73.4 264.9,72.3 270.0,71.3 275.1,70.0 280.2,78.9 285.3,80.2 290.4,79.5 295.5,70.4 300.7,78.7 305.8,82.1 310.9,77.4 316.0,66.8\" fill=\"none\" stroke=\"#1c1c1e\" stroke-width=\"1.6\"/><path d=\"M 254.6 86.6 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 290.4 91.5 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><circle cx=\"316.0\" cy=\"66.8\" r=\"4\" fill=\"#1c1c1e\"/></svg></div><div class=\"spark spv\" data-sp=\"3\" style=\"display:\"><svg viewBox=\"0 0 320 110\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:100%; height:auto; background:#fffdf6; border-radius:8px;\"><rect x=\"0\" y=\"58.5\" width=\"320\" height=\"2\" fill=\"#c62f2f\" opacity=\"0.12\"/><polyline points=\"4.0,91.1 6.1,94.3 8.3,94.6 10.4,92.3 12.5,93.3 14.7,78.6 16.8,76.3 19.0,70.3 21.1,60.9 23.2,64.7 25.4,64.5 27.5,57.9 29.6,47.9 31.8,45.1 33.9,46.7 36.1,42.8 38.2,43.2 40.3,61.4 42.5,59.2 44.6,62.0 46.7,63.6 48.9,62.0 51.0,64.0 53.2,66.2 55.3,66.2 57.4,69.4 59.6,69.0 61.7,66.6 63.8