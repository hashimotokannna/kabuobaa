</button><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, '10')\">10年</button><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, 'all')\">全期間(26年)</button></span></div><div class=\"spark spv\" data-sp=\"1\" style=\"display:none\"><svg viewBox=\"0 0 320 110\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:100%; height:auto; background:#fffdf6; border-radius:8px;\"><rect x=\"0\" y=\"62.3\" width=\"320\" height=\"10.5\" fill=\"#c62f2f\" opacity=\"0.12\"/><polyline points=\"4.0,96.9 9.1,91.7 14.2,91.7 19.3,97.2 24.5,86.8 29.6,80.4 34.7,82.5 39.8,72.4 44.9,72.4 50.0,84.4 55.1,85.9 60.3,78.6 65.4,74.3 70.5,74.3 75.6,61.4 80.7,51.6 85.8,56.8 91.0,53.5 96.1,51.0 101.2,39.4 106.3,24.1 111.4,41.5 116.5,25.9 121.6,29.9 126.8,36.6 131.9,34.2 137.0,27.8 142.1,32.7 147.2,29.9 152.3,31.7 157.4,29.0 162.6,25.6 167.7,25.0 172.8,49.8 177.9,52.9 183.0,63.0 188.1,63.6 193.2,66.0 198.4,81.0 203.5,73.4 208.6,74.9 213.7,73.7 218.8,77.7 223.9,72.1 229.0,71.2 234.2,68.8 239.3,66.0 244.4,65.4 249.5,60.8 254.6,62.7 259.7,67.9 264.9,64.8 270.0,51.3 275.1,47.3 280.2,21.6 285.3,14.9 290.4,18.6 295.5,12.8 300.7,33.6 305.8,48.0 310.9,47.7 316.0,42.1\" fill=\"none\" stroke=\"#1c1c1e\" stroke-width=\"1.6\"/><path d=\"M 96.1 63.0 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 172.8 61.8 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 259.7 79.9 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><circle cx=\"316.0\" cy=\"42.1\" r=\"4\" fill=\"#1c1c1e\"/></svg></div><div class=\"spark spv\" data-sp=\"3\" style=\"display:\"><svg viewBox=\"0 0 320 110\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:100%; height:auto; background:#fffdf6; border-radius:8px;\"><rect x=\"0\" y=\"38.4\" width=\"320\" height=\"5.600000000000001\" fill=\"#c62f2f\" opacity=\"0.12\"/><polyline points=\"4.0,89.8 6.1,91.2 8.3,92.4 10.4,89.8 12.5,91.8 14.7,92.1 16.8,93.2 19.0,93.8 21.1,94.0 23.2,97.2 25.4,96.5 27.5,95.6 29.6,92.1 31.8,93.3 33.9,92.8 36.1,91.6 38.2,92.9 40.3,93.6 42.5,93.3 44.6,94.0 46.7,92.2 48.