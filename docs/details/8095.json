I）</div><div class=\"discnote\">この銘柄は本日の分析対象外です（今夜の厳選・出尽くしサイン・レーティング変化・注目開示などの注目銘柄のみ、毎晩の実行で場中の5分足を取得して分析します）。</div><div class=\"spwrap\"><div class=\"nhead\">値動きと長期支持帯<span class=\"spbtns\"><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, '1')\">1年</button><button type=\"button\" class=\"spbtn on\" onclick=\"spSwap(this, '3')\">3年</button><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, '10')\">10年</button><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, 'all')\">全期間(26年)</button></span></div><div class=\"spark spv\" data-sp=\"1\" style=\"display:none\"><svg viewBox=\"0 0 320 110\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:100%; height:auto; background:#fffdf6; border-radius:8px;\"><rect x=\"0\" y=\"77.7\" width=\"320\" height=\"19.5\" fill=\"#c62f2f\" opacity=\"0.12\"/><polyline points=\"4.0,26.7 9.1,88.0 14.2,75.0 19.3,70.3 24.5,87.0 29.6,82.4 34.7,70.3 39.8,81.5 44.9,79.6 50.0,85.2 55.1,95.4 60.3,90.7 65.4,83.3 70.5,70.3 75.6,65.7 80.7,63.8 85.8,73.1 91.0,72.2 96.1,75.9 101.2,75.0 106.3,72.2 111.4,62.9 116.5,53.6 121.6,52.7 126.8,61.0 131.9,81.5 137.0,81.5 142.1,80.5 147.2,70.3 152.3,66.6 157.4,66.6 162.6,76.8 167.7,62.0 172.8,68.5 177.9,72.2 183.0,73.1 188.1,73.1 193.2,69.4 198.4,65.7 203.5,80.5 208.6,63.8 213.7,60.1 218.8,59.2 223.9,55.5 229.0,55.5 234.2,46.2 239.3,31.3 244.4,43.4 249.5,37.8 254.6,44.3 259.7,49.9 264.9,32.3 270.0,19.3 275.1,19.3 280.2,17.4 285.3,19.3 290.4,36.9 295.5,41.5 300.7,32.3 305.8,34.1 310.9,17.4 316.0,12.8\" fill=\"none\" stroke=\"#1c1c1e\" stroke-width=\"1.6\"/><path d=\"M 4.0 38.7 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 4.0 38.7 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 4.0 38.7 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 4.0 38.7 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 4.0 38.7 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 4.0 38.7 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 4.0 38.7 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 4.0 38.7 l 5 8 l -10