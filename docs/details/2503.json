ン・レーティング変化・注目開示などの注目銘柄のみ、毎晩の実行で場中の5分足を取得して分析します）。</div><div class=\"spwrap\"><div class=\"nhead\">値動きと長期支持帯<span class=\"spbtns\"><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, '1')\">1年</button><button type=\"button\" class=\"spbtn on\" onclick=\"spSwap(this, '3')\">3年</button><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, '10')\">10年</button><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, 'all')\">全期間(27年)</button></span></div><div class=\"spark spv\" data-sp=\"1\" style=\"display:none\"><svg viewBox=\"0 0 320 110\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:100%; height:auto; background:#fffdf6; border-radius:8px;\"><rect x=\"0\" y=\"63.1\" width=\"320\" height=\"8.699999999999996\" fill=\"#c62f2f\" opacity=\"0.12\"/><polyline points=\"4.0,93.3 9.1,97.2 14.2,92.2 19.3,76.9 24.5,76.3 29.6,71.2 34.7,76.8 39.8,81.6 44.9,78.5 50.0,76.1 55.1,77.9 60.3,79.6 65.4,79.0 70.5,76.2 75.6,68.8 80.7,79.1 85.8,80.5 91.0,72.7 96.1,50.1 101.2,54.0 106.3,47.7 111.4,61.1 116.5,54.6 121.6,58.0 126.8,72.1 131.9,66.7 137.0,63.2 142.1,52.5 147.2,56.7 152.3,59.6 157.4,68.1 162.6,62.6 167.7,65.5 172.8,43.8 177.9,47.6 183.0,46.6 188.1,55.1 193.2,46.5 198.4,46.5 203.5,38.1 208.6,33.5 213.7,41.3 218.8,29.3 223.9,33.3 229.0,27.8 234.2,23.5 239.3,24.9 244.4,27.3 249.5,16.7 254.6,20.7 259.7,12.8 264.9,15.5 270.0,28.7 275.1,39.9 280.2,35.3 285.3,32.8 290.4,35.0 295.5,41.7 300.7,34.4 305.8,26.3 310.9,20.4 316.0,30.6\" fill=\"none\" stroke=\"#1c1c1e\" stroke-width=\"1.6\"/><path d=\"M 111.4 73.1 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 152.3 71.6 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 188.1 67.1 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><circle cx=\"316.0\" cy=\"30.6\" r=\"4\" fill=\"#1c1c1e\"/></svg></div><div class=\"spark spv\" data-sp=\"3\" style=\"display:\"><svg viewBox=\"0 0 320 110\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:100%; height:auto; background:#fffdf6; border-radius:8px;\"><rect x=\"0\" y=\"52.0\" width=\