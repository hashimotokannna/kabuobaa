ae0\"></div><div class=\"mz\" style=\"left:50.0%; width:50.0%; background:#b9dcc0\"></div><div class=\"mpin\" style=\"left:57.2%\"></div></div><span class=\"mv num\">12.9%</span></div><div class=\"mrow\"><span class=\"ml\">ROA</span><div class=\"mtrack\"><div class=\"mz\" style=\"left:0.0%; width:20.0%; background:#f2c4a8\"></div><div class=\"mz\" style=\"left:20.0%; width:8.0%; background:#f5e6b3\"></div><div class=\"mz\" style=\"left:28.0%; width:12.0%; background:#eeeae0\"></div><div class=\"mz\" style=\"left:40.0%; width:60.0%; background:#b9dcc0\"></div><div class=\"mpin\" style=\"left:40.0%\"></div></div><span class=\"mv num\">5.0%</span></div><div class=\"mrow\"><span class=\"ml\">配当性向</span><div class=\"mtrack\"><div class=\"mz\" style=\"left:0.0%; width:20.0%; background:#eeeae0\"></div><div class=\"mz\" style=\"left:20.0%; width:20.0%; background:#b9dcc0\"></div><div class=\"mz\" style=\"left:40.0%; width:26.7%; background:#f5e6b3\"></div><div class=\"mz\" style=\"left:66.7%; width:33.3%; background:#f2c4a8\"></div><div class=\"mpin\" style=\"left:37.6%\"></div></div><span class=\"mv num\">56%</span></div><div class=\"mrow\"><span class=\"ml\">PEG</span><div class=\"mtrack\"><div class=\"mz\" style=\"left:0.0%; width:20.0%; background:#c9dcf3\"></div><div class=\"mz\" style=\"left:20.0%; width:20.0%; background:#b9dcc0\"></div><div class=\"mz\" style=\"left:40.0%; width:20.0%; background:#f5e6b3\"></div><div class=\"mz\" style=\"left:60.0%; width:40.0%; background:#f2c4a8\"></div><div class=\"mpin\" style=\"left:33.6%\"></div></div><span class=\"mv num\">1.68</span></div></div><div class=\"discnote\">ピンが現在値。PER・PBRなど価値系は「標準」が最も安心、割安は魅力だが「割安の罠」の確認が必要。RSI・ボリンジャーなど行きすぎ系は売られすぎ側が押し目買いに有利。読み方は「指標の読み方」ページへ。</div><div class=\"nhead\">スコア 122点（候補圏外）</div><div class=\"reason\">・直近20日高値から −1.8%（安さの主基準 +14点・8%で頭打ち）</div><div class=\"reason\">・普段の値段（20日平均）より 0.9%安い（+3点）</div><div class=\"reason\">・下げが複数日に分散した「じわ下げ」で、1日の急落で作られた安さではない（+15点）</div><div class=\"reason\">・日々の値動きが±0.2%と穏やかで読みやすい（+10点）</div><div class=\"reason\">・200日平均線より上での下げ＝上昇トレンド中の一時的な押し目（+20点）</div><div class=\"reason\">・1年高値からの下落 −12% で長期トレンド健全（+12点）</div><div class=\"reason\">・過去1年、同じ買い方で 4回 利確ライン（+5%）に到達（+20点）</div><div class=\"reason\">・利確まで平均 30営業日と資金拘束が長め。短期回転スタイルでは機会損失（−5点）</div><div class=\"reason\">・ただし直近の仮想買いが塩漬け中（−15点）</div><div class=\"reason\">・長期支持帯 1,698円付近は過去4回試されており、今回で5回目。支持線は試されるほど割れやすい（−5点・警戒）</div><div class=\"reason\">・50日線が200日線の上（ゴールデンクロス継続中の長期上昇形 +10点）</div><div class=\"reason\">・RSI(14)=21 の売られすぎ水準（+10点）</div><div class=\"reason\">・ボリンジャーバンド−1.6σと下限付近（+4点）</div><div class=\"reason\">・スローストキャス 14 の売られすぎ圏（+4点）</div><div class=\"reason\">・一目均衡表の雲の下（中期は弱い −3点）</div><div class=\"reason\">・ATR 0.2%と日々の値幅が小さく、損切り幅を狭く置ける（+3点）</div><div class=\"reason\">・自己資本比率62%と財務が厚く倒産リスクが低い（+4点）</div><div class=\"reason\">・営業利益率12.9%と本業の稼ぐ力が高い（+3点）</div><div class=\"reason\">・ROA 5.0%と資産効率が良い（+3点）</div><div class=\"reason\">・夜間ギャップ（翌朝の窓開け）平均±0.1%と小さく、夜に決めた指値が翌朝も有効に働きやすい（+8点）</div><div class=\"reason\">・1日平均 3.1億円の売買（+6点）</div><div class=\"nhead\">減点方式: 全体1,017位（−18点）</div><div class=\"hit\"><span class=\"sev sevB\">重い</span>長期支持帯を5回目に試す位置（割れやすい）<span class=\"num hp\">−8</span></div><div class=\"hit\"><span class=\"sev sevC\">軽い</span>利確まで平均30日と資金拘束が長い<span class=\"num hp\">−5</span></div><div class=\"hit\"><span class=\"sev sevC\">軽い</span>直近の仮想買いが塩漬け中<span class=\"num hp\">−5</span></div><div class=\"nhead\">TOB素地スコア: 27点（全体2,367位）<span class=\"tpbadge twarn\">TOB・MBO発表済み</span></div><div class=\"reason\">・PBR 3.1倍 ＝ 資産面の買収妙味は薄い（-8）</div><div class=\"reason\">・時価総額 272億円 ＝ TOB・MBOの主戦場サイズ（+15）</div><div class=\"reason\">・自己資本比率 62% ＝ 財務が厚く買収後の余力大（+8）</div><div class=\"reason\">・営業利益率 12.9% ＝ 本業の稼ぐ力あり（+8）</div><div class=\"reason\">・スタンダード市場 ＝ 上場維持メリットが薄く非公開化しやすい（+4）</div><div class=\"discnote\">買収・非公開化されやすい「体質」の順位で、発生の予測ではありません。全体像と注意点は上部タブの「TOB素地」ページへ。</div><div class=\"nhead\">業績の推移（通期実績の推移・決算短信より）</div><div class=\"finchart\"><svg viewBox=\"0 0 340 150\" xml