化・注目開示などの注目銘柄のみ、毎晩の実行で場中の5分足を取得して分析します）。</div><div class=\"spwrap\"><div class=\"nhead\">値動きと長期支持帯<span class=\"spbtns\"><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, '1')\">1年</button><button type=\"button\" class=\"spbtn on\" onclick=\"spSwap(this, '3')\">3年</button><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, '10')\">10年</button><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, 'all')\">全期間(26年)</button></span></div><div class=\"spark spv\" data-sp=\"1\" style=\"display:none\"><svg viewBox=\"0 0 320 110\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:100%; height:auto; background:#fffdf6; border-radius:8px;\"><rect x=\"0\" y=\"71.0\" width=\"320\" height=\"6.900000000000006\" fill=\"#c62f2f\" opacity=\"0.12\"/><polyline points=\"4.0,92.7 9.1,97.2 14.2,90.6 19.3,81.6 24.5,69.3 29.6,80.3 34.7,86.1 39.8,89.3 44.9,76.1 50.0,78.0 55.1,81.9 60.3,81.3 65.4,83.1 70.5,79.1 75.6,77.4 80.7,72.8 85.8,63.0 91.0,61.3 96.1,61.6 101.2,69.0 106.3,51.4 111.4,34.0 116.5,24.8 121.6,12.8 126.8,13.7 131.9,36.2 137.0,28.9 142.1,27.5 147.2,21.9 152.3,25.1 157.4,33.7 162.6,33.6 167.7,35.2 172.8,32.7 177.9,26.2 183.0,20.1 188.1,35.2 193.2,50.3 198.4,39.9 203.5,50.3 208.6,56.5 213.7,49.6 218.8,27.1 223.9,29.6 229.0,36.0 234.2,36.1 239.3,49.4 244.4,47.7 249.5,50.2 254.6,46.4 259.7,63.3 264.9,68.1 270.0,58.2 275.1,65.9 280.2,63.9 285.3,68.1 290.4,69.3 295.5,74.1 300.7,68.3 305.8,73.3 310.9,71.4 316.0,75.7\" fill=\"none\" stroke=\"#1c1c1e\" stroke-width=\"1.6\"/><path d=\"M 101.2 81.0 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 254.6 58.4 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 270.0 70.2 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 290.4 81.3 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><circle cx=\"316.0\" cy=\"75.7\" r=\"4\" fill=\"#1c1c1e\"/></svg></div><div class=\"spark spv\" data-sp=\"3\" style=\"display:\"><svg viewBox=\"0 0 320 110\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:100%; height:auto; background:#fffdf6; bor