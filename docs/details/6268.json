"discnote\">この銘柄は本日の分析対象外です（今夜の厳選・出尽くしサイン・レーティング変化・注目開示などの注目銘柄のみ、毎晩の実行で場中の5分足を取得して分析します）。</div><div class=\"spwrap\"><div class=\"nhead\">値動きと長期支持帯<span class=\"spbtns\"><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, '1')\">1年</button><button type=\"button\" class=\"spbtn on\" onclick=\"spSwap(this, '3')\">3年</button><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, '10')\">10年</button><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, 'all')\">全期間(26年)</button></span></div><div class=\"spark spv\" data-sp=\"1\" style=\"display:none\"><svg viewBox=\"0 0 320 110\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:100%; height:auto; background:#fffdf6; border-radius:8px;\"><polyline points=\"4.0,93.0 9.1,94.1 14.2,94.5 19.3,76.7 24.5,84.5 29.6,77.6 34.7,77.3 39.8,83.0 44.9,92.2 50.0,88.5 55.1,97.2 60.3,95.6 65.4,91.8 70.5,74.0 75.6,75.5 80.7,81.5 85.8,81.3 91.0,78.1 96.1,75.8 101.2,64.8 106.3,66.1 111.4,73.4 116.5,59.2 121.6,52.9 126.8,57.9 131.9,47.7 137.0,35.2 142.1,51.6 147.2,54.5 152.3,57.5 157.4,65.8 162.6,73.8 167.7,67.2 172.8,50.0 177.9,49.0 183.0,44.5 188.1,36.9 193.2,29.3 198.4,12.8 203.5,29.1 208.6,15.8 213.7,19.8 218.8,29.6 223.9,54.6 229.0,34.7 234.2,13.8 239.3,34.5 244.4,30.6 249.5,27.1 254.6,32.0 259.7,41.2 264.9,41.2 270.0,48.5 275.1,40.8 280.2,38.9 285.3,54.7 290.4,53.3 295.5,51.3 300.7,56.6 305.8,55.3 310.9,53.4 316.0,45.1\" fill=\"none\" stroke=\"#1c1c1e\" stroke-width=\"1.6\"/><circle cx=\"316.0\" cy=\"45.1\" r=\"4\" fill=\"#1c1c1e\"/></svg></div><div class=\"spark spv\" data-sp=\"3\" style=\"display:\"><svg viewBox=\"0 0 320 110\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:100%; height:auto; background:#fffdf6; border-radius:8px;\"><polyline points=\"4.0,80.9 6.1,81.5 8.3,83.7 10.4,80.3 12.5,82.2 14.7,83.7 16.8,82.6 19.0,81.9 21.1,82.5 23.2,81.5 25.4,83.4 27.5,83.6 29.6,81.3 31.8,79.9 33.9,79.1 36.1,76.6 38.2,81.0 40.3,78.9 42.5,79.1 44.6,79.7 46.7,88.5 48.9,83.9 51.0,88.0 53.2,88.1 55.3,84.1 57.4,8