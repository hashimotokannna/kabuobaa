%; background:#b9dcc0\"></div><div class=\"mz\" style=\"left:20.8%; width:12.5%; background:#eeeae0\"></div><div class=\"mz\" style=\"left:33.3%; width:16.7%; background:#f5e6b3\"></div><div class=\"mz\" style=\"left:50.0%; width:50.0%; background:#f2c4a8\"></div><div class=\"mpin\" style=\"left:16.8%\"></div></div><span class=\"mv num\">20%</span></div><div class=\"mrow\"><span class=\"ml\">OBV(20日)</span><div class=\"mtrack\"><div class=\"mz\" style=\"left:0.0%; width:40.0%; background:#f2c4a8\"></div><div class=\"mz\" style=\"left:40.0%; width:10.0%; background:#f5e6b3\"></div><div class=\"mz\" style=\"left:50.0%; width:10.0%; background:#eeeae0\"></div><div class=\"mz\" style=\"left:60.0%; width:40.0%; background:#b9dcc0\"></div><div class=\"mpin\" style=\"left:70.7%\"></div></div><span class=\"mv num\">+21%</span></div><div class=\"mrow\"><span class=\"ml\">自己資本比率</span><div class=\"mtrack\"><div class=\"mz\" style=\"left:0.0%; width:20.0%; background:#f2c4a8\"></div><div class=\"mz\" style=\"left:20.0%; width:15.0%; background:#f5e6b3\"></div><div class=\"mz\" style=\"left:35.0%; width:15.0%; background:#eeeae0\"></div><div class=\"mz\" style=\"left:50.0%; width:50.0%; background:#b9dcc0\"></div><div class=\"mpin\" style=\"left:59.2%\"></div></div><span class=\"mv num\">59%</span></div><div class=\"mrow\"><span class=\"ml\">営業利益率</span><div class=\"mtrack\"><div class=\"mz\" style=\"left:0.0%; width:25.0%; background:#f2c4a8\"></div><div class=\"mz\" style=\"left:25.0%; width:12.5%; background:#f5e6b3\"></div><div class=\"mz\" style=\"left:37.5%; width:12.5%; background:#eeeae0\"></div><div class=\"mz\" style=\"left:50.0%; width:50.0%; background:#b9dcc0\"></div><div class=\"mpin\" style=\"left:45.8%\"></div></div><span class=\"mv num\">8.3%</span></div><div class=\"mrow\"><span class=\"ml\">ROA</span><div class=\"mtrack\"><div class=\"mz\" style=\"left:0.0%; width:20.0%; background:#f2c4a8\"></div><div class=\"mz\" style=\"left:20.0%; width:8.0%; background:#f5e6b3\"></div><div class=\"mz\" style=\"left:28.0%; width:12.0%; background:#eeeae0\"></div><div class=\"mz\" style=\"left:40.0%; width:60.0%; background:#b9dcc0\"></div><div class=\"mpin\" style=\"left:43.6%\"></div></div><span class=\"mv num\">5.9%</span></div></div><div class=\"discnote\">ピンが現在値。PER・PBRなど価値系は「標準」が最も安心、割安は魅力だが「割安の罠」の確認が必要。RSI・ボリンジャーなど行きすぎ系は売られすぎ側が押し目買いに有利。読み方は「指標の読み方」ページへ。</div><div class=\"nhead\">スコア 72点（候補圏外）</div><div class=\"reason\">・直近20日高値から −4.5%（安さの主基準 +36点・8%で頭打ち）</div><div class=\"reason\">・下げはやや急だが崩落型ではない（+5点）</div><div class=\"reason\">・日々の値動きが±1.3%と穏やかで読みやすい（+10点）</div><div class=\"reason\">・1年高値からの下落 −20%（+6点）</div><div class=\"reason\">・過去1年、同じ買い方で 2回 利確ライン（+5%）に到達（+10点）</div><div class=\"reason\">・利確まで平均 30営業日と資金拘束が長め。短期回転スタイルでは機会損失（−5点）</div><div class=\"reason\">・ただし直近の仮想買いが塩漬け中（−15点）</div><div class=\"reason\">・長期支持帯 1,339円付近は過去7回試されており、今回で8回目。支持線は試されるほど割れやすい（−5点・警戒）</div><div class=\"reason\">・50日線が200日線の下（長期は調整形・加点なし）</div><div class=\"reason\">・MACDが直近5日以内に買い転換（下げの勢いが尽きた定番シグナル +8点）</div><div class=\"reason\">・スローストキャス 18 の売られすぎ圏（+4点）</div><div class=\"reason\">・一目均衡表の雲の下（中期は弱い −3点）</div><div class=\"reason\">・OBVが上向き＝下げの中でも買い集めの気配（+3点）</div><div class=\"reason\">・ATR 1.8%と日々の値幅が小さく、損切り幅を狭く置ける（+3点）</div><div class=\"reason\">・自己資本比率59%と財務が厚く倒産リスクが低い（+4点）</div><div class=\"reason\">・ROA 5.9%と資産効率が良い（+3点）</div><div class=\"reason\">・夜間ギャップ（翌朝の窓開け）平均±0.6%と小さく、夜に決めた指値が翌朝も有効に働きやすい（+8点）</div><div class=\"nhead\">減点方式: 全体2,151位（−38点）</div><div class=\"hit\"><span class=\"sev sevB\">重い</span>50日線が200日線の下（長期は調整形）<span class=\"num hp\">−10</span></div><div class=\"hit\"><span class=\"sev sevB\">重い</span>売買代金が1日1億円未満（約定しにくい）<span class=\"num hp\">−10</span></div><div class=\"hit\"><span class=\"sev sevB\">重い</span>長期支持帯を8回目に試す位置（割れやすい）<span class=\"num hp\">−8</span></div><div class=\"hit\"><span class=\"sev sevC\">軽い</span>利確まで平均30日と資金拘束が長い<span class=\"num hp\">−5</span></div><div class=\"hit\"><span class=\"sev sevC\">軽い</span>直近の仮想買いが塩漬け中<span class=\"num hp\">−5</span></div><div class=\"nhead\">業績の推移（通期実績の推移・決算短信より）</div><div class=\"finchart\"><svg viewBox=\"0 0 340 150\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:100%; height:auto; background:#fffdf6; border-radius:8px;\"><rect x=\"55.5\" y=\"59.5\" width=\"34.0\" height=\"70.5\" rx=\"2\" fill=\"#cfe0f5\"><title>22/3期 売上高 200億円</title></rect><rect x=\"120.5\" y=\"53.6\" width=\"34.0\" height=\"76.4\" rx=\"2\" fill=\"#cfe0f5\"><title>23/3期 売上高 217億円</title></rect><rect x=\"185.5\" y=\"50.9\" width=\"34.0\" height=\"79.1\" rx=\"2\" fill=\"#cfe0f5\"><title>24/3期 売上高 224億円</title></rect><rect x=\"250.5\" y=\"17.2\" width=\"34.0\" height=\"112.8\" rx=\"2\" fill=\"#cfe0f5\"><title>25/3期 売上高 320億円</title></rect><polyline points=\"72.5,78.7 137.5,71.2 202.5,72.4 267.5,61.3\" fill=\"none\" stroke=\"#c9661f\" stroke-width=\"1.8\"/><circle cx=\"72.5\" cy=\"78.7\" r=\"2.4\" fill=\"#c9661f\"><title>22/3期 営業利益 34億円</title></circle><circle cx=\"137.5\" cy=\"71.2\" r=\"2.4\" fill=\"#c9661f\"><title>23/3期 営業利益 39億円</title></circle><circle cx=\"202.5\" cy=\"72.4\" r=\"2.4\" fill=\"#c9661f\"><title>24/3期 営業利益 38億円</title></circle><circle cx=\"267.5\" cy=\"61.3\" r=\"2.4\" fill=\"#c9661f\"><title>25/3期 営業利益 45億円</title></circle><polyline points=\"72.5,81.9 137.5,67.4 202.5,74.9 267.5,17.2\" fill=\"none\" stroke=\"#178a5b\" stroke-width=\"1.8\"/><circle cx=\"72.5\" cy=\"81.9\" r=\"2.4\" fill=\"#178a5b\"><title>22/3期 経常利益 32億円</title></circle><circle cx=\"137.5\" cy=\"67.4\" r=\"2.4\" fill=\"#178a5b\"><title>23/3期 経常利益 41億円</title></circle><circle cx=\"202.5\" cy=\"74.9\" r=\"2.4\" fill=\"#178a5b\"><title>24/3期 経常利益 36億円</title></circle><circle cx=\"267.5\" cy=\"17.2\" r=\"2.4\" fill=\"#178a5b\"><title>25/3期 経常利益 74億円</title></circle><polyline points=\"72.5,99.1 137.5,87.8 202.5,94.1 267.5,58.4\" fill=\"none\" stroke=\"#7d55c7\" stroke-width=\"1.8\"/><circle cx=\"72.5\" cy=\"99.1\" r=\"2.4\" fill=\"#7d55c7\"><title>22/3期 純利益 20億円</title></circle><circl