選・出尽くしサイン・レーティング変化・注目開示などの注目銘柄のみ、毎晩の実行で場中の5分足を取得して分析します）。</div><div class=\"spwrap\"><div class=\"nhead\">値動きと長期支持帯<span class=\"spbtns\"><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, '1')\">1年</button><button type=\"button\" class=\"spbtn on\" onclick=\"spSwap(this, '3')\">3年</button><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, '10')\">10年</button><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, 'all')\">全期間(27年)</button></span></div><div class=\"spark spv\" data-sp=\"1\" style=\"display:none\"><svg viewBox=\"0 0 320 110\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:100%; height:auto; background:#fffdf6; border-radius:8px;\"><rect x=\"0\" y=\"92.7\" width=\"320\" height=\"2\" fill=\"#c62f2f\" opacity=\"0.12\"/><polyline points=\"4.0,88.2 9.1,89.4 14.2,89.2 19.3,87.4 24.5,89.0 29.6,86.0 34.7,85.3 39.8,73.8 44.9,76.6 50.0,75.3 55.1,75.2 60.3,45.7 65.4,46.2 70.5,12.8 75.6,36.4 80.7,44.2 85.8,48.6 91.0,64.4 96.1,60.9 101.2,55.6 106.3,71.2 111.4,67.2 116.5,69.0 121.6,56.8 126.8,55.1 131.9,61.8 137.0,65.7 142.1,78.1 147.2,80.3 152.3,87.7 157.4,83.3 162.6,87.0 167.7,89.1 172.8,88.0 177.9,83.0 183.0,86.6 188.1,90.8 193.2,85.4 198.4,89.7 203.5,90.8 208.6,88.2 213.7,93.8 218.8,90.8 223.9,88.8 229.0,87.1 234.2,88.9 239.3,87.1 244.4,88.0 249.5,87.7 254.6,89.3 259.7,88.6 264.9,91.6 270.0,90.5 275.1,92.7 280.2,94.7 285.3,97.2 290.4,95.2 295.5,91.9 300.7,84.3 305.8,89.1 310.9,96.3 316.0,95.6\" fill=\"none\" stroke=\"#1c1c1e\" stroke-width=\"1.6\"/><path d=\"M 172.8 100.0 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 188.1 102.8 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 213.7 105.8 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><circle cx=\"316.0\" cy=\"95.6\" r=\"4\" fill=\"#1c1c1e\"/></svg></div><div class=\"spark spv\" data-sp=\"3\" style=\"display:\"><svg viewBox=\"0 0 320 110\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:100%; height:auto; background:#fffdf6; border-radius:8px;\"><rect x=\"0\" y=\"72.7\" width=\"320\