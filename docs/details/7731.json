中の5分足を取得して分析します）。</div><div class=\"spwrap\"><div class=\"nhead\">値動きと長期支持帯<span class=\"spbtns\"><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, '1')\">1年</button><button type=\"button\" class=\"spbtn on\" onclick=\"spSwap(this, '3')\">3年</button><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, '10')\">10年</button><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, 'all')\">全期間(27年)</button></span></div><div class=\"spark spv\" data-sp=\"1\" style=\"display:none\"><svg viewBox=\"0 0 320 110\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:100%; height:auto; background:#fffdf6; border-radius:8px;\"><rect x=\"0\" y=\"90.9\" width=\"320\" height=\"6.299999999999997\" fill=\"#c62f2f\" opacity=\"0.12\"/><polyline points=\"4.0,58.9 9.1,56.9 14.2,61.3 19.3,56.4 24.5,52.9 29.6,54.1 34.7,59.2 39.8,62.9 44.9,60.6 50.0,59.5 55.1,54.6 60.3,51.3 65.4,44.3 70.5,47.3 75.6,43.9 80.7,44.8 85.8,45.1 91.0,42.3 96.1,41.7 101.2,42.6 106.3,45.9 111.4,41.8 116.5,43.7 121.6,49.5 126.8,38.6 131.9,47.1 137.0,45.4 142.1,49.3 147.2,64.9 152.3,50.2 157.4,12.8 162.6,46.6 167.7,44.0 172.8,51.8 177.9,44.7 183.0,45.3 188.1,31.4 193.2,31.3 198.4,27.4 203.5,17.4 208.6,28.1 213.7,16.6 218.8,22.3 223.9,43.8 229.0,51.3 234.2,40.0 239.3,36.3 244.4,43.0 249.5,43.5 254.6,43.8 259.7,50.7 264.9,65.1 270.0,62.5 275.1,51.0 280.2,48.5 285.3,49.2 290.4,58.1 295.5,61.3 300.7,62.8 305.8,65.8 310.9,78.2 316.0,73.4\" fill=\"none\" stroke=\"#1c1c1e\" stroke-width=\"1.6\"/><path d=\"M 4.0 70.9 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 4.0 70.9 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 4.0 70.9 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 4.0 70.9 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 4.0 70.9 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 4.0 70.9 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 4.0 70.9 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><circle cx=\"316.0\" cy=\"73.4\" r=\"4\" fill=\"#1c1c1e\"/></svg></div><div class=\"spark spv\" data-sp=\"3\" s