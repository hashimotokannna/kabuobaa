.5\" fill=\"#a99a76\" text-anchor=\"middle\">23/3期</text><text x=\"137.5\" y=\"144\" font-size=\"8.5\" fill=\"#a99a76\" text-anchor=\"middle\">24/3期</text><text x=\"202.5\" y=\"144\" font-size=\"8.5\" fill=\"#a99a76\" text-anchor=\"middle\">25/3期</text><text x=\"267.5\" y=\"144\" font-size=\"8.5\" fill=\"#a99a76\" text-anchor=\"middle\">26/3期</text><text x=\"303\" y=\"25.2\" font-size=\"8\" fill=\"#7ba0cc\">339億</text><text x=\"303\" y=\"132\" font-size=\"8\" fill=\"#7ba0cc\">売上</text><text x=\"4\" y=\"25.2\" font-size=\"8\" fill=\"#8a6f4d\">21億</text><text x=\"4\" y=\"132\" font-size=\"8\" fill=\"#8a6f4d\">利益</text></svg></div><div class=\"finlg\"><span><i style=\"background:#cfe0f5\"></i>売上高（右軸）</span><span><i style=\"background:#c9661f\"></i>営業利益</span><span><i style=\"background:#178a5b\"></i>経常利益</span><span><i style=\"background:#7d55c7\"></i>純利益</span></div><div class=\"finrow finhead\"><span class=\"fp\"></span><span class=\"fc\">売上高</span><span class=\"fc\">営業利益</span><span class=\"fc\">純利益</span></div><div class=\"finrow\"><span class=\"fp\">26/3期</span><span class=\"fc\">339億円</span><span class=\"fc\">14億円</span><span class=\"fc\">11億円</span></div><div class=\"finrow\"><span class=\"fp\">25/3期</span><span class=\"fc\">332億円</span><span class=\"fc\">16億円</span><span class=\"fc\">11億円</span></div><div class=\"finrow\"><span class=\"fp\">24/3期</span><span class=\"fc\">324億円</span><span class=\"fc\">21億円</span><span class=\"fc\">20億円</span></div><div class=\"finrow\"><span class=\"fp\">23/3期</span><span class=\"fc\">306億円</span><span class=\"fc\">6億円</span><span class=\"fc\">-3億円</span></div><div class=\"discnote\">グラフの棒・点にカーソルを合わせると数値が出ます。決算履歴は毎晩の実行で自動蓄積され、期間は時間とともに伸びていきます。古い年度はYahoo Financeの年次データで補完しています（この区間の経常利益は税引前利益で代用。決算短信の実測が入り次第、自動で置き換わります）。</div><div class=\"nhead\">ファンダメンタル指標</div><div class=\"fact\"><span>PER</span><span class=\"num\">70.8倍</span></div><div class=\"fact\"><span>PBR</span><span class=\"num\">1.25倍</span></div><div class=\"fact\"><span>ROE</span><span class=\"num\">1.8%</span></div><div class=\"fact\"><span>配当利回り</span><span class=\"num\">1.91%</span></div><div class=\"fact\"><span>時価総額</span><span class=\"num\">238億円</span></div><div class=\"nhead\">アナリスト・コンセンサス（証券会社レーティング）</div><div class=\"discnote\">この銘柄は現時点で<b>カバレッジ対象外</b>です（証券会社アナリストによる平均評価・平均目標株価の公表データがありません）。レーティングは主に中大型株が対象で、小型株はカバーされないことが多くあります。データが取得でき次第、ここに自動で表示されます。</div><div class=\"nhead\">板・売買フローの推定（11/06の5分足・AI）</div><div class=\"fprof\"><div class=\"fpcol\"><div class=\"fpbar\" style=\"height:12px\"></div><span class=\"fplab\">9時</span></div><div class=\"fpcol\"><div class=\"fpbar\" style=\"height:31px\"></div><span class=\"fplab\"></span></div><div class=\"fpcol\"><div class=\"fpbar\" style=\"height:5px\"></div><span class=\"fplab\">10時</span></div><div class=\"fpcol\"><div class=\"fpbar\" style=\"height:3px\"></div><span class=\"fplab\"></span></div><div class=\"fpcol\"><div class=\"fpbar\" style=\"height:9px\"></div><span class=\"fplab\">11時</span></div><div class=\"fpcol\"><div class=\"fpbar\" style=\"height:46px\"></div><span class=\"fplab\">12時半</span></div><div class=\"fpcol\"><div class=\"fpbar\" style=\"height:18px\"></div><span class=\"fplab\"></span></div><div class=\"fpcol\"><div class=\"fpbar\" style=\"height:3px\"></div><span class=\"fplab\">13時半</span></div><div class=\"fpcol\"><div class=\"fpbar\" style=\"height:3px\"></div><span class=\"fplab\"></span></div><div class=\"fpcol\"><div class=\"fpbar\" style=\"height:17px\"></div><span class=\"fplab\">14時半</span></div><div class=\"fpcol\"><div class=\"fpbar\" style=\"height:3px\"></div><span class=\"fplab\">引け</span></div></div><div class=\"fplegend\">時間帯ごとの出来高（どの時間に売買が集中したか）</div><div class=\"fact\"><span>この日の値動き</span><span class=\"num\">+0.0%（値幅0.2%）</span></div><div class=\"fact\"><span>出来高（普段の日足平均との比）</span><span class=\"num\">2.5倍</span></div><div class=\"fact\"><span>終値とVWAP（1日の平均約定価格）の差</span><span class=\"num\">-0.06%</span></div><div class=\"fact\"><span>寄り30分／引け30分の出来高シェア</span><span class=\"num\">8% ／ 0%</span></div><div class=\"fsub\">裏にいそうな売買主体（機械推定・上位2件）</div><div class=\"factor\"><div class=\"factorh\">🎯 大口の買い集め（静かな仕込み）<span class=\"fconf\">一致度50・確度中</span></div><div class=\"exhwhy\">・後場に出来高の59%（時間をかけた分割買いの痕跡）</div><div class=\"exhwhy\">・出来高2.5倍なのに値幅0.3%と静か（目立たず数量を確保する動き）</div></div><div class=\"factor\"><div class=\"factorh\">👤 機関投資家（VWAP・大引け執行）<span class=\"fconf\">一致度45・確度低</span></div><div class=\"exhwhy\">・終値がVWAP±0.1%（1日の平均価格に沿った執行＝VWAPアルゴの痕跡）</div><div class=\"exhwhy\">・寄り直後の過熱がない</div><div class=\"exhwhy\">・出来高は普段の2.5倍と厚め</div></div><div class=\"discnote\">リアルタイムの板（気配値・注文残）は取引所の有料データのため、場中の5分足の値動きと出来高の「形」から典型パターンとの一致度で推定しています。実際の注文主体を特定するものではありません。寄り集中＝個人の飛びつき、引け集中＋VWAP沿い＝機関の執行、出来高増なのに値幅が静か＝大口の仕込み、といった市場の経験則を採点式にしたものです。</div><div class=\"spwrap\"><div class=\"nhead\">値動きと長期支持帯<span class=\"spbtns\"><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, '1')\">1年</button><button type=\"button\" class=\"spbtn on\" onclick=\"spSwap(this, '3')\">3年</button><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, '10')\">10年</button><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, 'all')\">全期間(27年)</button></span></div><div class=\"spark spv\" data-sp=\"1\" style=\"display:none\"><svg viewBox=\"0 0 320 110\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:100%; height:auto; background:#fffdf6; border-radius:8px;\"><rect x=\"0\" y=\"13.0\" width=\"320\" height=\"7.300000000000001\" fill=\"#c62f2f\" opacity=\"0.12\"/><polyline points=\"4.0,73.1 9.1,73.4 14.2,73.4 19.3,73.7 24.5,68.3 29.6,69.9 34.7,74.8 39.8,71.5 44.9,74.5 50.0,74.2 55.1,70.7 60.3,69.6 65.4,60.4 70.5,66.9 75.6,73.1 80.7,70.2 85.8,78.3 91.0,82.9 96.1,83.4 101.2,74.0 106.3,82.6 111.4,82.1 116.5,68.0 121.6,59.9 126.8,62.9 131.9,62.0 137.0,61.8 142.1,70.4 147.2,78.6 152.3,84.5 157.4,81.3 162.6,88.6 167.7,91.0 172.8,89.4 177.9,92.1 183.0,97.2 188.1,97.0 193.2,95.6 198.4,93.5 203.5,91.6 208.6,88.8 213.7,89.1 218.8,87