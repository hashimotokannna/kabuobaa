銘柄のみ、毎晩の実行で場中の5分足を取得して分析します）。</div><div class=\"spwrap\"><div class=\"nhead\">値動きと長期支持帯<span class=\"spbtns\"><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, '1')\">1年</button><button type=\"button\" class=\"spbtn on\" onclick=\"spSwap(this, '3')\">3年</button><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, '10')\">10年</button><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, 'all')\">全期間(24年)</button></span></div><div class=\"spark spv\" data-sp=\"1\" style=\"display:none\"><svg viewBox=\"0 0 320 110\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:100%; height:auto; background:#fffdf6; border-radius:8px;\"><rect x=\"0\" y=\"62.1\" width=\"320\" height=\"11.399999999999999\" fill=\"#c62f2f\" opacity=\"0.12\"/><polyline points=\"4.0,77.5 9.1,79.8 14.2,66.6 19.3,54.5 24.5,68.3 29.6,65.3 34.7,68.1 39.8,60.1 44.9,40.5 50.0,36.0 55.1,34.7 60.3,23.6 65.4,22.8 70.5,17.9 75.6,19.3 80.7,16.9 85.8,12.8 91.0,15.3 96.1,42.1 101.2,47.8 106.3,64.6 111.4,69.9 116.5,53.8 121.6,56.2 126.8,52.1 131.9,66.8 137.0,66.3 142.1,67.2 147.2,62.8 152.3,54.8 157.4,64.4 162.6,52.6 167.7,64.8 172.8,71.0 177.9,70.7 183.0,78.9 188.1,74.5 193.2,73.4 198.4,74.7 203.5,87.2 208.6,94.8 213.7,97.2 218.8,93.8 223.9,83.6 229.0,67.0 234.2,60.7 239.3,58.2 244.4,64.1 249.5,48.0 254.6,65.5 259.7,57.3 264.9,60.5 270.0,55.2 275.1,53.1 280.2,49.6 285.3,57.3 290.4,49.3 295.5,61.8 300.7,59.9 305.8,64.7 310.9,50.7 316.0,41.0\" fill=\"none\" stroke=\"#1c1c1e\" stroke-width=\"1.6\"/><path d=\"M 4.0 89.5 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 4.0 89.5 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 34.7 80.1 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 147.2 74.8 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 254.6 77.5 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 295.5 73.8 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><circle cx=\"316.0\" cy=\"41.0\" r=\"4\" fill=\"#1c1c1e\"/></svg></div><div class=\"spark spv\" data-sp=\"3\" style=\"display:\"><svg viewBox=\"0 0 