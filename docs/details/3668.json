b3\"></div><div class=\"mz\" style=\"left:50.0%; width:10.0%; background:#eeeae0\"></div><div class=\"mz\" style=\"left:60.0%; width:40.0%; background:#b9dcc0\"></div><div class=\"mpin\" style=\"left:50.3%\"></div></div><span class=\"mv num\">+0%</span></div><div class=\"mrow\"><span class=\"ml\">自己資本比率</span><div class=\"mtrack\"><div class=\"mz\" style=\"left:0.0%; width:20.0%; background:#f2c4a8\"></div><div class=\"mz\" style=\"left:20.0%; width:15.0%; background:#f5e6b3\"></div><div class=\"mz\" style=\"left:35.0%; width:15.0%; background:#eeeae0\"></div><div class=\"mz\" style=\"left:50.0%; width:50.0%; background:#b9dcc0\"></div><div class=\"mpin\" style=\"left:92.5%\"></div></div><span class=\"mv num\">92%</span></div><div class=\"mrow\"><span class=\"ml\">営業利益率</span><div class=\"mtrack\"><div class=\"mz\" style=\"left:0.0%; width:25.0%; background:#f2c4a8\"></div><div class=\"mz\" style=\"left:25.0%; width:12.5%; background:#f5e6b3\"></div><div class=\"mz\" style=\"left:37.5%; width:12.5%; background:#eeeae0\"></div><div class=\"mz\" style=\"left:50.0%; width:50.0%; background:#b9dcc0\"></div><div class=\"mpin\" style=\"left:38.2%\"></div></div><span class=\"mv num\">5.3%</span></div><div class=\"mrow\"><span class=\"ml\">ROA</span><div class=\"mtrack\"><div class=\"mz\" style=\"left:0.0%; width:20.0%; background:#f2c4a8\"></div><div class=\"mz\" style=\"left:20.0%; width:8.0%; background:#f5e6b3\"></div><div class=\"mz\" style=\"left:28.0%; width:12.0%; background:#eeeae0\"></div><div class=\"mz\" style=\"left:40.0%; width:60.0%; background:#b9dcc0\"></div><div class=\"mpin\" style=\"left:24.4%\"></div></div><span class=\"mv num\">1.1%</span></div></div><div class=\"discnote\">ピンが現在値。PER・PBRなど価値系は「標準」が最も安心、割安は魅力だが「割安の罠」の確認が必要。RSI・ボリンジャーなど行きすぎ系は売られすぎ側が押し目買いに有利。読み方は「指標の読み方」ページへ。</div><div class=\"nhead\">スコア 116点（候補圏外）</div><div class=\"reason\">・直近20日高値から −5.8%（安さの主基準 +46点・8%で頭打ち）</div><div class=\"reason\">・普段の値段（20日平均）より 1.6%安い（+6点）</div><div class=\"reason\">・下げが複数日に分散した「じわ下げ」で、1日の急落で作られた安さではない（+15点）</div><div class=\"reason\">・日々の値動きが±1.7%と穏やかで読みやすい（+10点）</div><div class=\"reason\">・200日平均線より上での下げ＝上昇トレンド中の一時的な押し目（+20点）</div><div class=\"reason\">・1年高値からの下落 −22%（+6点）</div><div class=\"reason\">・1年の値幅の中腹（下から40%）での下げ。底抜けでも高値掴みでもない位置（+10点）</div><div class=\"reason\">・過去1年はこの買い方の成立実績なし（加点なし）</div><div class=\"reason\">・ただし直近の仮想買いが塩漬け中（−15点）</div><div class=\"reason\">・長期支持帯 421円付近は過去5回試されており、今回で6回目。支持線は試されるほど割れやすい（−5点・警戒）</div><div class=\"reason\">・50日線が200日線の下（長期は調整形・加点なし）</div><div class=\"reason\">・RSI(14)=36 でやや売られすぎ（+5点）</div><div class=\"reason\">・ADX 41・+DI優勢＝上昇トレンドに勢いがある中の押し目（+4点）</div><div class=\"reason\">・一目均衡表の雲の上（中期の地合いは良好 +4点）</div><div class=\"reason\">・PER 65.9倍と利益に対して異常な割高。期待剥落時の下げが深い（−10点）</div><div class=\"reason\">・PBR 0.82倍と資産に対して割安圏。下値が固くなりやすい（+6点）</div><div class=\"reason\">・ROE 1.2%と収益力が弱い（−5点）</div><div class=\"reason\">・自己資本比率92%と財務が厚く倒産リスクが低い（+4点）</div><div class=\"reason\">・夜間ギャップ（翌朝の窓開け）平均±0.7%と小さく、夜に決めた指値が翌朝も有効に働きやすい（+8点）</div><div class=\"reason\">・1日平均 2.1億円の売買（+6点）</div><div class=\"nhead\">減点方式: 全体2,646位（−50点）</div><div class=\"hit\"><span class=\"sev sevB\">重い</span>PER 66倍と期待先行の割高<span class=\"num hp\">−15</span></div><div class=\"hit\"><span class=\"sev sevB\">重い</span>ROE 1.2%と稼ぐ力が弱い<span class=\"num hp\">−12</span></div><div class=\"hit\"><span class=\"sev sevB\">重い</span>50日線が200日線の下（長期は調整形）<span class=\"num hp\">−10</span></div><div class=\"hit\"><span class=\"sev sevB\">重い</span>長期支持帯を6回目に試す位置（割れやすい）<span class=\"num hp\">−8</span></div><div class=\"hit\"><span class=\"sev sevC\">軽い</span>直近の仮想買いが塩漬け中<span class=\"num hp\">−5</span></div><div class=\"nhead\">TOB素地スコア: 59点（全体364位）</div><div class=\"reason\">・PBR 0.82倍 ＝ 1倍割れ（東証の改善要請対象圏）（+10）</div><div class=\"reason\">・時価総額 544億円 ＝ TOB・MBOの主戦場サイズ（+15）</div><div class=\"reason\">・自己資本比率 92% ＝ ほぼ無借金のため込み体質（+12）</div><div class=\"reason\">・厚い資本にROE 1.2% ＝ 資本を活かせていない（アクティビスト誘因）（+6）</div><div class=\"reason\">・営業利益率 5.3% ＝ 本業は黒字（+5）</div><div class=\"reason\">・株価は1年レンジの下位40%（+3）</div><div class=\"reason\">・売買代金が薄く市場の目が届きにくい（+4）</div><div class=\"reason\">・プライムでPBR1倍割れ ＝ 東証の改善要請が直撃（+4）</div><div class=\"discnote\">買収・非公開化されやすい「体質」の順位で、発生の予測ではありません。全体像と注意点は上部タブの「TOB素地」ページへ。</div><div class=\"nhead\">業績の推移（通期実績の推移・決算短信より）</div><div class=\"finchart\"><svg viewBox=\"0 0 340 150\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:100%; height:auto; background:#fffdf6; border-radius:8px;\"><line x1=\"40\" y1=\"102.3\" x2=\"300\" y2=\"102.3\" stroke=\"#e0d8c4\" stroke-width=\"1\" stroke-dasharray=\"3,3\"/><rect x=\"55.5\" y=\"17.2\" width=\"34.0\" height=\"112.8\" rx=\"2\" fill=\"#cfe0f5\"><title>22/9期 売上高 325億円</title></rect><rect x=\"120.5\" y=\"23.2\" width=\"34.0\" height=\"106.8\" rx=\"2\" fill=\"#cfe0f5\"><title>23/9期 売上高 308億円</title></rect><rect x=\"185.5\" y=\"40.0\" width=\"34.0\" height=\"90.0\" rx=\"2\" fill=\"#cfe0f5\"><title>24/9期 売上高 260億円</title></rect><rect x=\"250.5\" y=\"40.1\" width=\"34.0\" height=\"89.9\" rx=\"2\" fill=\"#cfe0f5\"><title>25/9期 売上高 259億円</title></rect><polyline points=\"72.5,38.3 137.5,63.0 202.5,120.2 267.5,87.4\" fill=\"none\" stroke=\"#c9661f\" stroke-width=\"1.8\"/><circle cx=\"72.5\" cy=\"38.3\" r=\"2.4\" fill=\"#c9661f\"><title>22/9期 営業利益 43億円</title></circle><circle cx=\"137.5\" cy=\"63.0\" r=\"2.4\" fill=\"#c9661f\"><title>23/9期 営業利益 26億円</title></circle><circle cx=\"202.5\" cy=\"120.2\" r=\"2.4\" fill=\"#c9661f\"><title>24/9期 営業利益 -12億円</title></circle><circle cx=\"267.5\" cy=\"87.4\" r=\"2.4\" fill=\"#c9661f\"><title>25/9期 営業利益 10億円</title></circle><polyline points=\"72.5,17.2 137.5,56.8 202.5,120.5 267.5,97.1\" fill=\"none\" stroke=\"#178a5b\" stroke-width=\"1.8\"/><circle cx=\"72.5\" cy=\"17.2\" r=\"2.4\" fill=\"#178a5b\"><title>22/9期 経常利益 57億円</title></circle><circle cx=\"137.5\" cy=\"56.8\" r=\"2.4\" fill=\"#178a5b\"><title>23/9期 経常利益 31億円</title></circle><circle cx=\"202.5\" cy=\"120.5\" r=\"2.4\" fill=\"#178a5b\"><title>24/9期 経常利益 -12億円</title><