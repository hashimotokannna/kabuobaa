4a8\"></div><div class=\"mz\" style=\"left:20.0%; width:8.0%; background:#f5e6b3\"></div><div class=\"mz\" style=\"left:28.0%; width:12.0%; background:#eeeae0\"></div><div class=\"mz\" style=\"left:40.0%; width:60.0%; background:#b9dcc0\"></div><div class=\"mpin\" style=\"left:58.0%\"></div></div><span class=\"mv num\">9.5%</span></div><div class=\"mrow\"><span class=\"ml\">配当性向</span><div class=\"mtrack\"><div class=\"mz\" style=\"left:0.0%; width:20.0%; background:#eeeae0\"></div><div class=\"mz\" style=\"left:20.0%; width:20.0%; background:#b9dcc0\"></div><div class=\"mz\" style=\"left:40.0%; width:26.7%; background:#f5e6b3\"></div><div class=\"mz\" style=\"left:66.7%; width:33.3%; background:#f2c4a8\"></div><div class=\"mpin\" style=\"left:65.5%\"></div></div><span class=\"mv num\">98%</span></div><div class=\"mrow\"><span class=\"ml\">PEG</span><div class=\"mtrack\"><div class=\"mz\" style=\"left:0.0%; width:20.0%; background:#c9dcf3\"></div><div class=\"mz\" style=\"left:20.0%; width:20.0%; background:#b9dcc0\"></div><div class=\"mz\" style=\"left:40.0%; width:20.0%; background:#f5e6b3\"></div><div class=\"mz\" style=\"left:60.0%; width:40.0%; background:#f2c4a8\"></div><div class=\"mpin\" style=\"left:4.0%\"></div></div><span class=\"mv num\">0.20</span></div></div><div class=\"discnote\">ピンが現在値。PER・PBRなど価値系は「標準」が最も安心、割安は魅力だが「割安の罠」の確認が必要。RSI・ボリンジャーなど行きすぎ系は売られすぎ側が押し目買いに有利。読み方は「指標の読み方」ページへ。</div><div class=\"nhead\">スコア 149点（候補圏外）</div><div class=\"reason\">・直近20日高値から −1.0%（安さの主基準 +8点・8%で頭打ち）</div><div class=\"reason\">・普段の値段（20日平均）より 0.7%安い（+3点）</div><div class=\"reason\">・下げの大半が特定の1日に集中（急落型・加点なし）</div><div class=\"reason\">・日々の値動きが±0.2%と穏やかで読みやすい（+10点）</div><div class=\"reason\">・200日平均線より上での下げ＝上昇トレンド中の一時的な押し目（+20点）</div><div class=\"reason\">・1年高値からの下落 −6% で長期トレンド健全（+12点）</div><div class=\"reason\">・過去1年、同じ買い方で 5回 利確ライン（+5%）に到達（+25点）</div><div class=\"reason\">・50日線が200日線の上（ゴールデンクロス継続中の長期上昇形 +10点）</div><div class=\"reason\">・RSI(14)=26 の売られすぎ水準（+10点）</div><div class=\"reason\">・ボリンジャーバンド−2σ以下（統計的な売られすぎ圏 +8点）</div><div class=\"reason\">・一目均衡表の雲の上（中期の地合いは良好 +4点）</div><div class=\"reason\">・ATR 0.3%と日々の値幅が小さく、損切り幅を狭く置ける（+3点）</div><div class=\"reason\">・ROE 13.5%と資本効率が高く、稼ぐ力のある会社（+8点）</div><div class=\"reason\">・自己資本比率70%と財務が厚く倒産リスクが低い（+4点）</div><div class=\"reason\">・営業利益率22.5%と本業の稼ぐ力が高い（+3点）</div><div class=\"reason\">・ROA 9.5%と資産効率が良い（+3点）</div><div class=\"reason\">・PEG 0.20倍＝成長率に対して株価が割安（+4点）</div><div class=\"reason\">・夜間ギャップ（翌朝の窓開け）平均±0.1%と小さく、夜に決めた指値が翌朝も有効に働きやすい（+8点）</div><div class=\"reason\">・1日平均 4.8億円の売買（+6点）</div><div class=\"nhead\">減点方式: 全体86位（−6点）</div><div class=\"hit\"><span class=\"sev sevC\">軽い</span>下げが1日に集中（崩落型）<span class=\"num hp\">−6</span></div><div class=\"nhead\">TOB素地スコア: 31点（全体2,130位）<span class=\"tpbadge twarn\">TOB・MBO発表済み</span></div><div class=\"reason\">・PBR 7.4倍 ＝ 資産面の買収妙味は薄い（-8）</div><div class=\"reason\">・時価総額 367億円 ＝ TOB・MBOの主戦場サイズ（+15）</div><div class=\"reason\">・自己資本比率 70% ＝ ほぼ無借金のため込み体質（+12）</div><div class=\"reason\">・営業利益率 22.5% ＝ 本業の稼ぐ力あり（+8）</div><div class=\"reason\">・グロース市場 ＝ 上場維持メリットが薄く非公開化しやすい（+4）</div><div class=\"discnote\">買収・非公開化されやすい「体質」の順位で、発生の予測ではありません。全体像と注意点は上部タブの「TOB素地」ページへ。</div><div class=\"nhead\">業績の推移（通期実績の推移・決算短信より）</div><div class=\"finchart\"><svg viewBox=\"0 0 340 150\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:100%; height:auto; background:#fffdf6; border-radius:8px;\"><rect x=\"55.5\" y=\"71.8\" width=\"34.0\" height=\"58.2\" rx=\"2\" fill=\"#cfe0f5\"><title>22/9期 売上高 44億円</title></rect><rect x=\"120.5\" y=\"48.1\" width=\"34.0\" height=\"81.9\" rx=\"2\" fill=\"#cfe0f5\"><title>23/9期 売上高 62億円</title></rect><rect x=\"185.5\" y=\"31.4\" width=\"34.0\" height=\"98.6\" rx=\"2\" fill=\"#cfe0f5\"><title>24/9期 売上高 75億円</title></rect><rect x=\"250.5\" y=\"17.2\" width=\"34.0\" height=\"112.8\" rx=\"2\" fill=\"#cfe0f5\"><title>25/9期 売上高 86億円</title></rect><polyline points=\"72.5,108.2 137.5,62.5 202.5,32.6 267.5,17.2\" fill=\"none\" stroke=\"#c9661f\" s