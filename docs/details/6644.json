tn on\" onclick=\"spSwap(this, '3')\">3年</button><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, '10')\">10年</button><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, 'all')\">全期間(26年)</button></span></div><div class=\"spark spv\" data-sp=\"1\" style=\"display:none\"><svg viewBox=\"0 0 320 110\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:100%; height:auto; background:#fffdf6; border-radius:8px;\"><rect x=\"0\" y=\"85.7\" width=\"320\" height=\"3.0999999999999943\" fill=\"#c62f2f\" opacity=\"0.12\"/><polyline points=\"4.0,84.8 9.1,83.8 14.2,84.4 19.3,83.7 24.5,83.3 29.6,80.4 34.7,79.7 39.8,79.2 44.9,78.8 50.0,81.9 55.1,85.0 60.3,79.4 65.4,71.8 70.5,59.2 75.6,56.1 80.7,49.6 85.8,47.6 91.0,56.5 96.1,42.4 101.2,42.7 106.3,36.9 111.4,42.7 116.5,40.9 121.6,31.5 126.8,28.4 131.9,32.7 137.0,23.5 142.1,12.8 147.2,38.0 152.3,49.8 157.4,49.1 162.6,58.1 167.7,65.0 172.8,68.3 177.9,63.1 183.0,62.6 188.1,62.3 193.2,59.4 198.4,62.8 203.5,60.9 208.6,60.1 213.7,65.5 218.8,53.7 223.9,60.4 229.0,56.1 234.2,59.8 239.3,56.8 244.4,62.8 249.5,65.8 254.6,64.7 259.7,62.4 264.9,64.7 270.0,64.6 275.1,67.9 280.2,70.0 285.3,72.2 290.4,71.2 295.5,78.2 300.7,87.1 305.8,88.3 310.9,97.2 316.0,89.0\" fill=\"none\" stroke=\"#1c1c1e\" stroke-width=\"1.6\"/><path d=\"M 4.0 96.8 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 55.1 97.0 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><circle cx=\"316.0\" cy=\"89.0\" r=\"4\" fill=\"#1c1c1e\"/></svg></div><div class=\"spark spv\" data-sp=\"3\" style=\"display:\"><svg viewBox=\"0 0 320 110\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:100%; height:auto; background:#fffdf6; border-radius:8px;\"><rect x=\"0\" y=\"65.2\" width=\"320\" height=\"2.5\" fill=\"#c62f2f\" opacity=\"0.12\"/><polyline points=\"4.0,91.7 6.1,93.9 8.3,93.8 10.4,94.5 12.5,94.7 14.7,94.5 16.8,93.6 19.0,93.3 21.1,93.4 23.2,91.7 25.4,90.2 27.5,91.8 29.6,92.1 31.8,92.9 33.9,92.8 36.1,92.6 38.2,91.8 40.3,91.6 42.5,93.5 44.6,90.1 46.7,93.9 48.9,91.9 51.0,91.9 53.2