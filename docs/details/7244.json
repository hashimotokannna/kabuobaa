\" class=\"spbtn\" onclick=\"spSwap(this, '10')\">10年</button><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, 'all')\">全期間(26年)</button></span></div><div class=\"spark spv\" data-sp=\"1\" style=\"display:none\"><svg viewBox=\"0 0 320 110\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:100%; height:auto; background:#fffdf6; border-radius:8px;\"><rect x=\"0\" y=\"85.7\" width=\"320\" height=\"11.5\" fill=\"#c62f2f\" opacity=\"0.12\"/><polyline points=\"4.0,93.8 9.1,90.9 14.2,84.6 19.3,87.5 24.5,81.1 29.6,69.7 34.7,62.2 39.8,62.8 44.9,58.2 50.0,47.2 55.1,52.4 60.3,61.0 65.4,61.0 70.5,50.7 75.6,35.7 80.7,16.8 85.8,26.0 91.0,52.4 96.1,69.1 101.2,77.1 106.3,78.9 111.4,65.6 116.5,66.2 121.6,67.4 126.8,62.2 131.9,59.9 137.0,59.9 142.1,64.5 147.2,54.7 152.3,44.4 157.4,51.3 162.6,52.4 167.7,61.0 172.8,51.8 177.9,55.3 183.0,50.7 188.1,62.8 193.2,67.9 198.4,55.3 203.5,61.0 208.6,59.9 213.7,53.6 218.8,43.8 223.9,64.5 229.0,27.7 234.2,12.8 239.3,23.1 244.4,32.9 249.5,26.6 254.6,32.3 259.7,37.5 264.9,31.1 270.0,34.0 275.1,42.6 280.2,37.5 285.3,23.7 290.4,47.8 295.5,59.9 300.7,72.5 305.8,60.5 310.9,67.9 316.0,95.5\" fill=\"none\" stroke=\"#1c1c1e\" stroke-width=\"1.6\"/><path d=\"M 4.0 105.8 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 4.0 105.8 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 111.4 77.6 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><circle cx=\"316.0\" cy=\"95.5\" r=\"4\" fill=\"#1c1c1e\"/></svg></div><div class=\"spark spv\" data-sp=\"3\" style=\"display:\"><svg viewBox=\"0 0 320 110\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:100%; height:auto; background:#fffdf6; border-radius:8px;\"><rect x=\"0\" y=\"56.2\" width=\"320\" height=\"6.5\" fill=\"#c62f2f\" opacity=\"0.12\"/><polyline points=\"4.0,39.4 6.1,40.7 8.3,33.5 10.4,34.5 12.5,35.1 14.7,43.0 16.8,48.6 19.0,25.6 21.1,22.0 23.2,23.9 25.4,16.7 27.5,12.8 29.6,34.8 31.8,34.5 33.9,29.5 36.1,24.9 38.2,25.3 40.3,31.5 42.5,33.1 44.6,33.1 46.7,39.7 48.9,41.4 51.0,34.5 53.2,31.2 55.3,42.0 57.4,29.