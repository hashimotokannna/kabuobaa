)\">3年</button><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, '10')\">10年</button><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, 'all')\">全期間(27年)</button></span></div><div class=\"spark spv\" data-sp=\"1\" style=\"display:none\"><svg viewBox=\"0 0 320 110\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:100%; height:auto; background:#fffdf6; border-radius:8px;\"><rect x=\"0\" y=\"76.6\" width=\"320\" height=\"20.60000000000001\" fill=\"#c62f2f\" opacity=\"0.12\"/><polyline points=\"4.0,43.8 9.1,42.4 14.2,45.2 19.3,46.6 24.5,44.1 29.6,41.6 34.7,39.2 39.8,27.0 44.9,29.2 50.0,21.7 55.1,20.7 60.3,14.9 65.4,20.5 70.5,36.6 75.6,47.1 80.7,31.3 85.8,12.8 91.0,18.3 96.1,18.9 101.2,51.0 106.3,56.4 111.4,63.0 116.5,70.5 121.6,66.0 126.8,72.9 131.9,68.5 137.0,71.2 142.1,69.8 147.2,83.5 152.3,70.9 157.4,77.0 162.6,85.4 167.7,82.8 172.8,79.6 177.9,76.5 183.0,85.6 188.1,71.3 193.2,76.7 198.4,76.3 203.5,64.6 208.6,69.4 213.7,65.0 218.8,58.7 223.9,43.1 229.0,69.4 234.2,69.1 239.3,64.7 244.4,66.3 249.5,70.9 254.6,60.2 259.7,69.5 264.9,70.6 270.0,67.2 275.1,70.8 280.2,90.1 285.3,87.0 290.4,83.7 295.5,80.9 300.7,86.0 305.8,81.1 310.9,68.8 316.0,67.9\" fill=\"none\" stroke=\"#1c1c1e\" stroke-width=\"1.6\"/><path d=\"M 4.0 55.8 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 4.0 55.8 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 4.0 55.8 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 116.5 82.5 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 147.2 95.5 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 162.6 97.4 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 183.0 97.6 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 198.4 88.3 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 244.4 78.3 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 280.2 102.1 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 300.7 98.0 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><circle cx=\"316.0\" cy=\"67.9\" r=\"4\" fill=\"#1c1c1e\"/></svg></div><div class=\"spark spv\" data-sp=\"3\" styl