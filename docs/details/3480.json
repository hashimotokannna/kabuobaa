idth:8.0%; background:#f5e6b3\"></div><div class=\"mz\" style=\"left:28.0%; width:12.0%; background:#eeeae0\"></div><div class=\"mz\" style=\"left:40.0%; width:60.0%; background:#b9dcc0\"></div><div class=\"mpin\" style=\"left:21.6%\"></div></div><span class=\"mv num\">0.4%</span></div><div class=\"mrow\"><span class=\"ml\">配当性向</span><div class=\"mtrack\"><div class=\"mz\" style=\"left:0.0%; width:20.0%; background:#eeeae0\"></div><div class=\"mz\" style=\"left:20.0%; width:20.0%; background:#b9dcc0\"></div><div class=\"mz\" style=\"left:40.0%; width:26.7%; background:#f5e6b3\"></div><div class=\"mz\" style=\"left:66.7%; width:33.3%; background:#f2c4a8\"></div><div class=\"mpin\" style=\"left:100.0%\"></div></div><span class=\"mv num\">633%</span></div><div class=\"mrow\"><span class=\"ml\">PEG</span><div class=\"mtrack\"><div class=\"mz\" style=\"left:0.0%; width:20.0%; background:#c9dcf3\"></div><div class=\"mz\" style=\"left:20.0%; width:20.0%; background:#b9dcc0\"></div><div class=\"mz\" style=\"left:40.0%; width:20.0%; background:#f5e6b3\"></div><div class=\"mz\" style=\"left:60.0%; width:40.0%; background:#f2c4a8\"></div><div class=\"mpin\" style=\"left:6.8%\"></div></div><span class=\"mv num\">0.34</span></div></div><div class=\"discnote\">ピンが現在値。PER・PBRなど価値系は「標準」が最も安心、割安は魅力だが「割安の罠」の確認が必要。RSI・ボリンジャーなど行きすぎ系は売られすぎ側が押し目買いに有利。読み方は「指標の読み方」ページへ。</div><div class=\"nhead\">スコア 82点（候補圏外）</div><div class=\"reason\">・直近20日高値から −1.8%（安さの主基準 +14点・8%で頭打ち）</div><div class=\"reason\">・普段の値段（20日平均）より 0.1%安い（+0点）</div><div class=\"reason\">・下げの大半が特定の1日に集中（急落型・加点なし）</div><div class=\"reason\">・日々の値動きが±0.5%と穏やかで読みやすい（+10点）</div><div class=\"reason\">・200日平均線より上での下げ＝上昇トレンド中の一時的な押し目（+20点）</div><div class=\"reason\">・1年高値からの下落 −3% で長期トレンド健全（+12点）</div><div class=\"reason\">・過去1年、同じ買い方で 3回 利確ライン（+5%）に到達（+15点）</div><div class=\"reason\">・利確まで平均 44営業日と資金拘束が長め。短期回転スタイルでは機会損失（−5点）</div><div class=\"reason\">・50日線が200日線の上（ゴールデンクロス継続中の長期上昇形 +10点）</div><div class=\"reason\">・ADX 29・+DI優勢＝