kground:#b9dcc0\"></div><div class=\"mz\" style=\"left:20.0%; width:15.0%; background:#eeeae0\"></div><div class=\"mz\" style=\"left:35.0%; width:15.0%; background:#f5e6b3\"></div><div class=\"mz\" style=\"left:50.0%; width:50.0%; background:#f2c4a8\"></div><div class=\"mpin\" style=\"left:33.5%\"></div></div><span class=\"mv num\">3.4%</span></div><div class=\"mrow\"><span class=\"ml\">HV(年率変動)</span><div class=\"mtrack\"><div class=\"mz\" style=\"left:0.0%; width:20.8%; background:#b9dcc0\"></div><div class=\"mz\" style=\"left:20.8%; width:12.5%; background:#eeeae0\"></div><div class=\"mz\" style=\"left:33.3%; width:16.7%; background:#f5e6b3\"></div><div class=\"mz\" style=\"left:50.0%; width:50.0%; background:#f2c4a8\"></div><div class=\"mpin\" style=\"left:33.4%\"></div></div><span class=\"mv num\">40%</span></div><div class=\"mrow\"><span class=\"ml\">OBV(20日)</span><div class=\"mtrack\"><div class=\"mz\" style=\"left:0.0%; width:40.0%; background:#f2c4a8\"></div><div class=\"mz\" style=\"left:40.0%; width:10.0%; background:#f5e6b3\"></div><div class=\"mz\" style=\"left:50.0%; width:10.0%; background:#eeeae0\"></div><div class=\"mz\" style=\"left:60.0%; width:40.0%; background:#b9dcc0\"></div><div class=\"mpin\" style=\"left:61.1%\"></div></div><span class=\"mv num\">+11%</span></div><div class=\"mrow\"><span class=\"ml\">自己資本比率</span><div class=\"mtrack\"><div class=\"mz\" style=\"left:0.0%; width:20.0%; background:#f2c4a8\"></div><div class=\"mz\" style=\"left:20.0%; width:15.0%; background:#f5e6b3\"></div><div class=\"mz\" style=\"left:35.0%; width:15.0%; background:#eeeae0\"></div><div class=\"mz\" style=\"left:50.0%; width:50.0%; background:#b9dcc0\"></div><div class=\"mpin\" style=\"left:59.3%\"></div></div><span class=\"mv num\">59%</span></div><div class=\"mrow\"><span class=\"ml\">ROA</span><div class=\"mtrack\"><div class=\"mz\" style=\"left:0.0%; width:20.0%; background:#f2c4a8\"></div><div class=\"mz\" style=\"left:20.0%; width:8.0%; background:#f5e6b3\"></div><div class=\"mz\" style=\"left:28.0%; width:12.0%; background:#eeeae0\"></div><div class=\"mz\" style=\"left:40.0%; width:60.0%; background:#b9dcc0\"></div><div class=\"mpin\" style=\"left:80.4%\"></div></div><span class=\"mv num\">15.1%</span></div></div><div class=\"discnote\">ピンが現在値。PER・PBRなど価値系は「標準」が最も安心、割安は魅力だが「割安の罠」の確認が必要。RSI・ボリンジャーなど行きすぎ系は売られすぎ側が押し目買いに有利。読み方は「指標の読み方」ページへ。</div><div class=\"nhead\">スコア 99点（候補圏外）</div><div class=\"reason\">・直近20日高値から −0.9%（安さの主基準 +7点・8%で頭打ち）</div><div class=\"reason\">・下げの大半が特定の1日に集中（急落型・加点なし）</div><div class=\"reason\">・200日平均線より上での下げ＝上昇トレンド中の一時的な押し目（+20点）</div><div class=\"reason\">・1年の値幅の中腹（下から44%）での下げ。底抜けでも高値掴みでもない位置（+10点）</div><div class=\"reason\">・過去1年、同じ買い方で 2回 利確ライン（+5%）に到達（+10点）</div><div class=\"reason\">・利確まで平均 2営業日。短期回転スタイルに最適（+15点）</div><div class=\"reason\">・ただし直近の仮想買いが塩漬け中（−15点）</div><div class=\"reason\">・長期支持帯 1,198〜1,221円の直上。過去2回反発し、今回が3回目の試し（〜3回目までは支持されやすいという定石の圏内 +12点）</div><div class=\"reason\">・50日線が200日線の上（ゴールデンクロス継続中の長期上昇形 +10点）</div><div class=\"reason\">・MACDがシグナル線の上で上向き（+4点）</div><div class=\"reason\">・ADX 56・+DI優勢＝上昇トレンドに勢いがある中の押し目（+4点）</div><div class=\"reason\">・一目均衡表の雲の上（中期の地合いは良好 +4点）</div><div class=\"reason\">・OBVが上向き＝下げの中でも買い集めの気配（+3点）</div><div class=\"reason\">・PER 19.7倍と利益に対して妥当〜割安の水準（+8点）</div><div class=\"reason\">・自己資本比率59%と財務が厚く倒産リスクが低い（+4点）</div><div class=\"reason\">・ROA 15.1%と資産効率が良い（+3点）</div><div class=\"nhead\">減点方式: 全体1,575位（−27点）</div><div class=\"hit\"><span class=\"sev sevB\">重い</span>売買代金が1日1億円未満（約定しにくい）<span class=\"num hp\">−10</span></div><div class=\"hit\"><span class=\"sev sevC\">軽い</span>下げが1日に集中（崩落型）<span class=\"num hp\">−6</span></div><div class=\"hit\"><span class=\"sev sevC\">軽い</span>RSI 80 の買われすぎ<span class=\"num hp\">−6</span></div><div class=\"hit\"><span class=\"sev sevC\">軽い</span>直近の仮想買いが塩漬け中<span class=\"num hp\">−5</span></div><div class=\"nhead\">業績の推移（通期実績の推移・決算短信より）</div><div class=\"finchart\"><svg viewBox=\"0 0 340 150\" xmlns=\"http://ww