6b3\"></div><div class=\"mz\" style=\"left:50.0%; width:10.0%; background:#eeeae0\"></div><div class=\"mz\" style=\"left:60.0%; width:40.0%; background:#b9dcc0\"></div><div class=\"mpin\" style=\"left:47.9%\"></div></div><span class=\"mv num\">-2%</span></div><div class=\"mrow\"><span class=\"ml\">自己資本比率</span><div class=\"mtrack\"><div class=\"mz\" style=\"left:0.0%; width:20.0%; background:#f2c4a8\"></div><div class=\"mz\" style=\"left:20.0%; width:15.0%; background:#f5e6b3\"></div><div class=\"mz\" style=\"left:35.0%; width:15.0%; background:#eeeae0\"></div><div class=\"mz\" style=\"left:50.0%; width:50.0%; background:#b9dcc0\"></div><div class=\"mpin\" style=\"left:72.7%\"></div></div><span class=\"mv num\">73%</span></div><div class=\"mrow\"><span class=\"ml\">営業利益率</span><div class=\"mtrack\"><div class=\"mz\" style=\"left:0.0%; width:25.0%; background:#f2c4a8\"></div><div class=\"mz\" style=\"left:25.0%; width:12.5%; background:#f5e6b3\"></div><div class=\"mz\" style=\"left:37.5%; width:12.5%; background:#eeeae0\"></div><div class=\"mz\" style=\"left:50.0%; width:50.0%; background:#b9dcc0\"></div><div class=\"mpin\" style=\"left:52.0%\"></div></div><span class=\"mv num\">10.8%</span></div><div class=\"mrow\"><span class=\"ml\">ROA</span><div class=\"mtrack\"><div class=\"mz\" style=\"left:0.0%; width:20.0%; background:#f2c4a8\"></div><div class=\"mz\" style=\"left:20.0%; width:8.0%; background:#f5e6b3\"></div><div class=\"mz\" style=\"left:28.0%; width:12.0%; background:#eeeae0\"></div><div class=\"mz\" style=\"left:40.0%; width:60.0%; background:#b9dcc0\"></div><div class=\"mpin\" style=\"left:29.2%\"></div></div><span class=\"mv num\">2.3%</span></div><div class=\"mrow\"><span class=\"ml\">PEG</span><div class=\"mtrack\"><div class=\"mz\" style=\"left:0.0%; width:20.0%; background:#c9dcf3\"></div><div class=\"mz\" style=\"left:20.0%; width:20.0%; background:#b9dcc0\"></div><div class=\"mz\" style=\"left:40.0%; width:20.0%; background:#f5e6b3\"></div><div class=\"mz\" style=\"left:60.0%; width:40.0%; background:#f2c4a8\"></div><div class=\"mpin\" style=\"left:5.2%\"></div></div><span class=\"mv num\">0.26</span></div></div><div class=\"discnote\">ピンが現在値。PER・PBRなど価値系は「標準」が最も安心、割安は魅力だが「割安の罠」の確認が必要。RSI・ボリンジャーなど行きすぎ系は売られすぎ側が押し目買いに有利。読み方は「指標の読み方」ページへ。</div><div class=\"nhead\">スコア 117点（候補圏外）</div><div class=\"reason\">・直近20日高値から −2.7%（安さの主基準 +21点・8%で頭打ち）</div><div class=\"reason\">・普段の値段（20日平均）より 0.0%安い（+0点）</div><div class=\"reason\">・下げの大半が特定の1日に集中（急落型・加点なし）</div><div class=\"reason\">・日々の値動きが±1.0%と穏やかで読みやすい（+10点）</div><div class=\"reason\">・200日平均線より上での下げ＝上昇トレンド中の一時的な押し目（+20点）</div><div class=\"reason\">・1年高値からの下落 −8% で長期トレンド健全（+12点）</div><div class=\"reason\">・過去1年、同じ買い方で 5回 利確ライン（+5%）に到達（+25点）</div><div class=\"reason\">・利確まで平均 13営業日（+8点）</div><div class=\"reason\">・ただし直近の仮想買いが塩漬け中（−15点）</div><div class=\"reason\">・長期支持帯 3,420円付近は過去6回試されており、今回で7回目。支持線は試されるほど割れやすい（−5点・警戒）</div><div class=\"reason\">・50日線が200日線の上（ゴールデンクロス継続中の長期上昇形 +10点）</div><div class=\"reason\">・一目均衡表の雲の上（中期の地合いは良好 +4点）</div><div class=\"reason\">・ATR 1.8%と日々の値幅が小さく、損切り幅を狭く置ける（+3点）</div><div class=\"reason\">・PER 60.1倍と利益に対して異常な割高。期待剥落時の下げが深い（−10点）</div><div class=\"reason\">・時価総額7,586億円の中大型で値動きが安定しやすい（+3点）</div><div class=\"reason\">・自己資本比率73%と財務が厚く倒産リスクが低い（+4点）</div><div class=\"reason\">・営業利益率10.8%と本業の稼ぐ力が高い（+3点）</div><div class=\"reason\">・PEG 0.26倍＝成長率に対して株価が割安（+4点）</div><div class=\"reason\">・夜間ギャップ（翌朝の窓開け）平均±0.7%と小さく、夜に決めた指値が翌朝も有効に働きやすい（+8点）</div><div class=\"reason\">・1日平均 11億円の売買があり注文が通りやすい（+12点）</div><div class=\"nhead\">減点方式: 全体1,231位（−26点）</div><div class=\"hit\"><span class=\"sev sevB\">重い</span>PER 60倍と期待先行の割高<span class=\"num hp\">−15</span></div><div class=\"hit\"><span class=\"sev sevC\">軽い</span>下げが1日に集中（崩落型）<span class=\"num hp\">−6</span></div><div class=\"hit\"><span class=\"sev sevC\">軽い</span>直近の仮想買いが塩漬け中<span class=\"num hp\">−5</span></div><div class=\"nhead\">TOB素地スコア: 14点（全体3,052位）</div><div class=\"reason\">・時価総額 7,586億円 ＝ 大