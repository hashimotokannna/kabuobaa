und:#b9dcc0\"></div><div class=\"mz\" style=\"left:20.0%; width:15.0%; background:#eeeae0\"></div><div class=\"mz\" style=\"left:35.0%; width:15.0%; background:#f5e6b3\"></div><div class=\"mz\" style=\"left:50.0%; width:50.0%; background:#f2c4a8\"></div><div class=\"mpin\" style=\"left:49.4%\"></div></div><span class=\"mv num\">4.9%</span></div><div class=\"mrow\"><span class=\"ml\">HV(年率変動)</span><div class=\"mtrack\"><div class=\"mz\" style=\"left:0.0%; width:20.8%; background:#b9dcc0\"></div><div class=\"mz\" style=\"left:20.8%; width:12.5%; background:#eeeae0\"></div><div class=\"mz\" style=\"left:33.3%; width:16.7%; background:#f5e6b3\"></div><div class=\"mz\" style=\"left:50.0%; width:50.0%; background:#f2c4a8\"></div><div class=\"mpin\" style=\"left:48.8%\"></div></div><span class=\"mv num\">58%</span></div><div class=\"mrow\"><span class=\"ml\">OBV(20日)</span><div class=\"mtrack\"><div class=\"mz\" style=\"left:0.0%; width:40.0%; background:#f2c4a8\"></div><div class=\"mz\" style=\"left:40.0%; width:10.0%; background:#f5e6b3\"></div><div class=\"mz\" style=\"left:50.0%; width:10.0%; background:#eeeae0\"></div><div class=\"mz\" style=\"left:60.0%; width:40.0%; background:#b9dcc0\"></div><div class=\"mpin\" style=\"left:56.1%\"></div></div><span class=\"mv num\">+6%</span></div><div class=\"mrow\"><span class=\"ml\">自己資本比率</span><div class=\"mtrack\"><div class=\"mz\" style=\"left:0.0%; width:20.0%; background:#f2c4a8\"></div><div class=\"mz\" style=\"left:20.0%; width:15.0%; background:#f5e6b3\"></div><div class=\"mz\" style=\"left:35.0%; width:15.0%; background:#eeeae0\"></div><div class=\"mz\" style=\"left:50.0%; width:50.0%; background:#b9dcc0\"></div><div class=\"mpin\" style=\"left:75.0%\"></div></div><span class=\"mv num\">75%</span></div><div class=\"mrow\"><span class=\"ml\">営業利益率</span><div class=\"mtrack\"><div class=\"mz\" style=\"left:0.0%; width:25.0%; background:#f2c4a8\"></div><div class=\"mz\" style=\"left:25.0%; width:12.5%; background:#f5e6b3\"></div><div class=\"mz\" style=\"left:37.5%; width:12.5%; background:#eeeae0\"></div><div class=\"mz\" style=\"left:50.0%; width:50.0%; background:#b9dcc0\"></div><div class=\"mpin\" style=\"left:48.5%\"></div></div><span class=\"mv num\">9.4%</span></div><div class=\"mrow\"><span class=\"ml\">ROA</span><div class=\"mtrack\"><div class=\"mz\" style=\"left:0.0%; width:20.0%; background:#f2c4a8\"></div><div class=\"mz\" style=\"left:20.0%; width:8.0%; background:#f5e6b3\"></div><div class=\"mz\" style=\"left:28.0%; width:12.0%; background:#eeeae0\"></div><div class=\"mz\" style=\"left:40.0%; width:60.0%; background:#b9dcc0\"></div><div class=\"mpin\" style=\"left:36.4%\"></div></div><span class=\"mv num\">4.1%</span></div><div class=\"mrow\"><span class=\"ml\">配当性向</span><div class=\"mtrack\"><div class=\"mz\" style=\"left:0.0%; width:20.0%; background:#eeeae0\"></div><div class=\"mz\" style=\"left:20.0%; width:20.0%; background:#b9dcc0\"></div><div class=\"mz\" style=\"left:40.0%; width:26.7%; background:#f5e6b3\"></div><div class=\"mz\" style=\"left:66.7%; width:33.3%; background:#f2c4a8\"></div><div class=\"mpin\" style=\"left:11.3%\"></div></div><span class=\"mv num\">17%</span></div></div><div class=\"discnote\">ピンが現在値。PER・PBRなど価値系は「標準」が最も安心、割安は魅力だが「割安の罠」の確認が必要。RSI・ボリンジャーなど行きすぎ系は売られすぎ側が押し目買いに有利。読み方は「指標の読み方」ページへ。</div><div class=\"nhead\">スコア 175点（候補圏外）</div><div class=\"reason\">・直近20日高値から −7.3%（安さの主基準 +58点・8%で頭打ち）</div><div class=\"reason\">・下げの大半が特定の1日に集中（急落型・加点なし）</div><div class=\"reason\">・200日平均線より上での下げ＝上昇トレンド中の一時的な押し目（+20点）</div><div class=\"reason\">・1年の値幅の中腹（下から55%）での下げ。底抜けでも高値掴みでもない位置（+10点）</div><div class=\"reason\">・過去1年、同じ買い方で 17回 利確ライン（+5%）に到達（+50点）</div><div class=\"reason\">・利確まで平均 7営業日。短期回転スタイルに最適（+15点）</div><div class=\"reason\">・ただし直近の仮想買いが塩漬け中（−15点）</div><div class=\"reason\">・50日線が200日線の上（ゴールデンクロス継続中の長期上昇形 +10点）</div><div class=\"reason\">・MACDがシグナル線の上で上向き（+4点）</div><div class=\"reason\">・ADX 29・+DI優勢＝上昇トレンドに勢いがある中の押し目（+4点）</div><div class=\"reason\">・OBVが上向き＝下げの中でも買い集めの気配（+3点）</div><div class=\"reason\">・PBR 1.18倍と資産に対して割安圏。下値が固くなりやすい（+6点）</div><div class=\"reason\">・自己資本比率75%と財務が厚く倒産リスクが低い（+4点）</div><div class=\"reason\">・1日平均 2.7億円の売買（+6点）</div><div class=\"nhead\">減点方式: 全体443位（−11点）</div><div class=\"hit\"><span class=\"sev sevC\">軽い</span>下げが1日に集中（崩落型）<span class=\"num hp\">−6</span></div><div class=\"hit\"><span class=\"sev sevC\">軽い</span>直近の仮想買いが塩漬け中<span class=\"num hp\">−5</span></div><div class=\"nhead\">TOB素地スコア: 58点（全体387位）</div><div class=\"reason\">・PBR 1.18倍 ＝ 1倍をわずかに超える程度（+4）</div><div class=\"reason\">・時価総額 167億円 ＝ TOB・MBOの主戦場サイズ（+15）</div><div class=\"reason\">・自己資本比率 75% ＝ ほぼ無借金のため込み体質（+12）</div><div class=\"reason\">・厚い資本にROE 5.5% ＝ 資本を活かせていない（アクティビスト誘因）（+6）</div><div class=\"reason\">・営業利益率 9.4% ＝ 本業の稼ぐ力あり（+8）</div><div class=\"reason\">・配当性向 17% ＝ 黒字なのに還元が渋い（+5）</div><div class=\"reason\">・売買代金が薄く市場の目が届きにくい（+4）</div><div class=\"reason\">・スタンダード市場 ＝ 上場維持メリットが薄く非公開化しやすい（+4）</div><div class=\"discnote\">買収・非公開化されやすい「体質」の順位で、発生の予測ではありません。全体像と注意点は上部タブの「TOB素地」ページへ。</div><div class=\"nhead\">業績の推移（通期実績の推移・決算短信より）</div><div class=\"finchart\"><svg viewBox=\"0 0 340 150\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:100%; height:auto; background:#fffdf6; border-radius:8px;\"><rect x=\"55.5\" y=\"23.2\" width=\"34.0\" height=\"106.8\" rx=\"2\" fill=\"#cfe0f5\"><title>23/3期 売上高 107億円</title></rect><rect x=\"120.5\" y=\"28.2\" width=\"34.0\" height=\"101.8\" rx=\"2\" fill=\"#cfe0f5\"><title>24/3期 売上高 102億円</title></rect><rect x=\"185.5\" y=\"29.8\" width=\"34.0\" height=\"100.2\" rx=\"2\" fill=\"#cfe0f5\"><title>25/3期 売上高 101億円</title></rect><rect x=\"250.5\" y=\"17.2\" width=\"34.0\" height=\"112.8\" rx=\"2\" fill=\"#cfe0f5\"><title>26/3期 売上高 113億円</title></rect><polyline points=\"72.5,24.2 137.5,41.8 202.5,68.8 267.5,27.2\" fill=\"none\" stroke=\"#c9661f\" stroke-width=\"1.8\"/><circle cx=\"72.5\" cy=\"24.2\" r=\"2.4\" fill=\"#c9661f\"><title>23/3期 営業利益 11億円</title></circle><circl