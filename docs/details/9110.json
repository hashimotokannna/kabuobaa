4a8\"></div><div class=\"mz\" style=\"left:20.0%; width:8.0%; background:#f5e6b3\"></div><div class=\"mz\" style=\"left:28.0%; width:12.0%; background:#eeeae0\"></div><div class=\"mz\" style=\"left:40.0%; width:60.0%; background:#b9dcc0\"></div><div class=\"mpin\" style=\"left:28.4%\"></div></div><span class=\"mv num\">2.1%</span></div><div class=\"mrow\"><span class=\"ml\">配当性向</span><div class=\"mtrack\"><div class=\"mz\" style=\"left:0.0%; width:20.0%; background:#eeeae0\"></div><div class=\"mz\" style=\"left:20.0%; width:20.0%; background:#b9dcc0\"></div><div class=\"mz\" style=\"left:40.0%; width:26.7%; background:#f5e6b3\"></div><div class=\"mz\" style=\"left:66.7%; width:33.3%; background:#f2c4a8\"></div><div class=\"mpin\" style=\"left:0.0%\"></div></div><span class=\"mv num\">0%</span></div><div class=\"mrow\"><span class=\"ml\">PEG</span><div class=\"mtrack\"><div class=\"mz\" style=\"left:0.0%; width:20.0%; background:#c9dcf3\"></div><div class=\"mz\" style=\"left:20.0%; width:20.0%; background:#b9dcc0\"></div><div class=\"mz\" style=\"left:40.0%; width:20.0%; background:#f5e6b3\"></div><div class=\"mz\" style=\"left:60.0%; width:40.0%; background:#f2c4a8\"></div><div class=\"mpin\" style=\"left:2.6%\"></div></div><span class=\"mv num\">0.13</span></div></div><div class=\"discnote\">ピンが現在値。PER・PBRなど価値系は「標準」が最も安心、割安は魅力だが「割安の罠」の確認が必要。RSI・ボリンジャーなど行きすぎ系は売られすぎ側が押し目買いに有利。読み方は「指標の読み方」ページへ。</div><div class=\"nhead\">スコア 150点（候補圏外）</div><div class=\"reason\">・直近20日高値から −0.3%（安さの主基準 +2点・8%で頭打ち）</div><div class=\"reason\">・下げが複数日に分散した「じわ下げ」で、1日の急落で作られた安さではない（+15点）</div><div class=\"reason\">・日々の値動きが±0.1%と穏やかで読みやすい（+10点）</div><div class=\"reason\">・200日平均線より上での下げ＝上昇トレンド中の一時的な押し目（+20点）</div><div class=\"reason\">・1年高値からの下落 −0% で長期トレンド健全（+12点）</div><div class=\"reason\">・過去1年、同じ買い方で 6回 利確ライン（+5%）に到達（+30点）</div><div class=\"reason\">・50日線が200日線の上（ゴールデンクロス継続中の長期上昇形 +10点）</div><div class=\"reason\">・ADX 73・+DI優勢＝上昇トレンドに勢いがある中の押し目（+4点）</div><div class=\"reason\">・一目均衡表の雲の上（中期の地合いは良好 +4点）</div><div class=\"reason\">・ATR 0.3%と日々の値幅が小さく、損切り幅を狭く置ける（+3点）</div><div class=\"reason\">・PBR 1.31倍と資産に対して割安圏。下値が固くなりやすい（+6点）</div><div class=\"reason\">・時価総額2,484億円の中大型で値動きが安定しやすい（+3点）</div><div class=\"reason\">・自己資本比率64%と財務が厚く倒産リスクが低い（+4点）</div><div class=\"reason\">・営業利益率10.9%と本業の稼ぐ力が高い（+3点）</div><div class=\"reason\">・PEG 0.13倍＝成長率に対して株価が割安（+4点）</div><div class=\"reason\">・夜間ギャップ（翌朝の窓開け）平均±0.1%と小さく、夜に決めた指値が翌朝も有効に働きやすい（+8点）</div><div class=\"reason\">・1日平均 13億円の売買があり注文が通りやすい（+12点）</div><div class=\"nhead\">減点方式: 全体2位（無傷）</div><div class=\"hit ok\">買ってはいけない条件に一つも該当なし</div><div class=\"nhead\">TOB素地スコア: 27点（全体2,458位）</div><div class=\"reason\">・自己資本比率 64% ＝ 財務が厚く買収後の余力大（+8）</div><div class=\"reason\">・厚い資本にROE 3.2% ＝ 資本を活かせていない（アクティビスト誘因）（+6）</div><div class=\"reason\">・営業利益率 10.9% ＝ 本業の稼ぐ力あり（+8）</div><div class=\"reason\">・配当性向 0% ＝ 黒字なのに還元が渋い（+5）</div><div class=\"discnote\">買収・非公開化されやすい「体質」の順位で、発生の予測ではありません。全体像と注意点は上部タブの「TOB素地」ページへ。</div><div class=\"nhead\">業績の推移（通期実績の推移・決算短信より）</div><div class=\"finchart\"><svg viewBox=\"0 0 340 150\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:100%; height:auto; background:#fffdf6; border-radius:8px;\"><rect x=\"55.5\" y=\"17.2\" width=\"34.0\" height=\"112.8\" rx=\"2\" fill=\"#cfe0f5\"><title>23/3期 売上高 2,508億円</title></rect><rect x=\"120.5\" y=\"25.2\" width=\"34.0\" height=\"104.8\" rx=\"2\" fill=\"#cfe0f5\"><title>24/3期 売上高 2,331億円</title></rect><rect x=\"185.5\" y=\"18.7\" width=\"34.0\" height=\"111.3\" rx=\"2\" fill=\"#cfe0f5\"><title>25/3期 売上高 2,474億円</title></rect><rect x=\"250.5\" y=\"26.7\" width=\"34.0\" height=\"103.3\" rx=\"2\" fill=\"#cfe0f5\"><title>26/3期 売上高 2,298億円</title></rect><polyline points=\"72.5,18.5 137.5,55.8 202.5,60.6 267.5,59.5\" fill=\"none\" stroke=\"#c9661f\" stroke-width=\"1.8\"/><circle cx=\"72.5\" cy=\"18.5\" r=\"2.4\" fill=\"#c9661f\"><title>23/3期 営業利益 325億円</title></circle><circle cx=\"137.5\" cy=\"55.8\" r=\"2.4\" fill=\"#c9661f\"><title>24/3期 営業利益 216億円</title></