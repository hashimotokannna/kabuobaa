\" style=\"left:0.0%; width:20.8%; background:#b9dcc0\"></div><div class=\"mz\" style=\"left:20.8%; width:12.5%; background:#eeeae0\"></div><div class=\"mz\" style=\"left:33.3%; width:16.7%; background:#f5e6b3\"></div><div class=\"mz\" style=\"left:50.0%; width:50.0%; background:#f2c4a8\"></div><div class=\"mpin\" style=\"left:48.3%\"></div></div><span class=\"mv num\">58%</span></div><div class=\"mrow\"><span class=\"ml\">OBV(20日)</span><div class=\"mtrack\"><div class=\"mz\" style=\"left:0.0%; width:40.0%; background:#f2c4a8\"></div><div class=\"mz\" style=\"left:40.0%; width:10.0%; background:#f5e6b3\"></div><div class=\"mz\" style=\"left:50.0%; width:10.0%; background:#eeeae0\"></div><div class=\"mz\" style=\"left:60.0%; width:40.0%; background:#b9dcc0\"></div><div class=\"mpin\" style=\"left:56.8%\"></div></div><span class=\"mv num\">+7%</span></div><div class=\"mrow\"><span class=\"ml\">自己資本比率</span><div class=\"mtrack\"><div class=\"mz\" style=\"left:0.0%; width:20.0%; background:#f2c4a8\"></div><div class=\"mz\" style=\"left:20.0%; width:15.0%; background:#f5e6b3\"></div><div class=\"mz\" style=\"left:35.0%; width:15.0%; background:#eeeae0\"></div><div class=\"mz\" style=\"left:50.0%; width:50.0%; background:#b9dcc0\"></div><div class=\"mpin\" style=\"left:4.7%\"></div></div><span class=\"mv num\">5%</span></div><div class=\"mrow\"><span class=\"ml\">ROA</span><div class=\"mtrack\"><div class=\"mz\" style=\"left:0.0%; width:20.0%; background:#f2c4a8\"></div><div class=\"mz\" style=\"left:20.0%; width:8.0%; background:#f5e6b3\"></div><div class=\"mz\" style=\"left:28.0%; width:12.0%; background:#eeeae0\"></div><div class=\"mz\" style=\"left:40.0%; width:60.0%; background:#b9dcc0\"></div><div class=\"mpin\" style=\"left:20.4%\"></div></div><span class=\"mv num\">0.1%</span></div><div class=\"mrow\"><span class=\"ml\">配当性向</span><div class=\"mtrack\"><div class=\"mz\" style=\"left:0.0%; width:20.0%; background:#eeeae0\"></div><div class=\"mz\" style=\"left:20.0%; width:20.0%; background:#b9dcc0\"></div><div class=\"mz\" style=\"left:40.0%; width:26.7%; background:#f5e6b3\"></div><div class=\"mz\" style=\"left:66.7%; width:33.3%; background:#f2c4a8\"></div><div class=\"mpin\" style=\"left:38.2%\"></div></div><span class=\"mv num\">57%</span></div><div class=\"mrow\"><span class=\"ml\">PEG</span><div class=\"mtrack\"><div class=\"mz\" style=\"left:0.0%; width:20.0%; background:#c9dcf3\"></div><div class=\"mz\" style=\"left:20.0%; width:20.0%; background:#b9dcc0\"></div><div class=\"mz\" style=\"left:40.0%; width:20.0%; background:#f5e6b3\"></div><div class=\"mz\" style=\"left:60.0%; width:40.0%; background:#f2c4a8\"></div><div class=\"mpin\" style=\"left:5.8%\"></div></div><span class=\"mv num\">0.29</span></div></div><div class=\"discnote\">ピンが現在値。PER・PBRなど価値系は「標準」が最も安心、割安は魅力だが「割安の罠」の確認が必要。RSI・ボリンジャーなど行きすぎ系は売られすぎ側が押し目買いに有利。読み方は「指標の読み方」ページへ。</div><div class=\"nhead\">スコア 193点（候補圏外）</div><div class=\"reason\">・直近20日高値から −22.9%（安さの主基準 +64点・8%で頭打ち）</div><div class=\"reason\">・普段の値段（20日平均）より 4.7%安い（+19点）</div><div class=\"reason\">・下げが複数日に分散した「じわ下げ」で、1日の急落で作られた安さではない（+15点）</div><div class=\"reason\">・200日平均線より上での下げ＝上昇トレンド中の一時的な押し目（+20点）</div><div class=\"reason\">・1年高値からの下落 −23%（+6点）</div><div class=\"reason\">・過去1年、同じ買い方で 11回 利確ライン（+5%）に到達（+50点）</div><div class=\"reason\">・利確まで平均 11営業日（+8点）</div><div class=\"reason\">・ただし直近の仮想買いが塩漬け中（−15点）</div><div class=\"reason\">・50日線が200日線の上（ゴールデンクロス継続中の長期上昇形 +10点）</div><div class=\"reason\">・RSI(14)=37 でやや売られすぎ（+5点）</div><div class=\"reason\">・ADX 26・−DI優勢＝下降トレンドに勢い（−4点）</div><div class=\"reason\">・OBVが上向き＝下げの中でも買い集めの気配（+3点）</div><div class=\"reason\">・ATR 5.6%と値幅が大きく、損切りが機能しにくい（−3点）</div><div class=\"reason\">・PBR 0.92倍と資産に対して割安圏。下値が固くなりやすい（+6点）</div><div class=\"reason\">・ROE 1.7%と収益力が弱い（−5点）</div><div class=\"reason\">・時価総額1,435億円の中大型で値動きが安定しやすい（+3点）</div><div class=\"reason\">・自己資本比率5%と借入依存が高い（−5点）</div><div class=\"reason\">・PEG 0.29倍＝成長率に対して株価が割安（+4点）</div><div class=\"reason\">・1日平均 13億円の売買があり注文が通りやすい（+12点）</div><div class=\"nhead\">減点方式: 全体491位（−17点）</div><div class=\"hit\"><span class=\"sev sevB\">重い</span>ROE 1.7%と稼ぐ力が弱い<span class=\"num hp\">−12</span></div><div class=\"hit\"><span class=\"sev sevC\">軽い</span>直近の仮想買いが塩漬け中<span class=\"num hp\">−5</span></div><div class=\"nhead\">TOB素地スコア: 22点（全体2,728位）</div><div class=\"reason\">・PBR 0.92倍 ＝ 1倍割れ（東証の改善要請対象圏）（+10）</div><div class=\"reason\">・時価総額 1,435億円 ＝ 買収資金が十分現実的（+8）</div><div class=\"reason\">・プライムでPBR1倍割れ ＝ 東証の改善要請が直撃（+4）</div><div class=\"discnote\">買収・非公開化されやすい「体質」の順位で、発生の予測ではありません。全体像と注意点は上部タブの「TOB素地」ページへ。</div><div class=\"nhead\">業績の推移（通期実績の推移・決算短信より）</div><div class=\"finchart\"><svg viewBox=\"0 0 340 150\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:100%; height:auto; background:#fffdf6; border-radius:8px;\"><rect x=\"55.5\" y=\"31.9\" width=\"34.0\" height=\"98.1\" rx=\"2\" fill=\"#cfe0f5\"><title>23/3期 売上高 449億円</title></rect><rect x=\"120.5\" y=\"26.8\" width=\"34.0\" height=\"103.2\" rx=\"2\" fill=\"#cfe0f5\"><title>24/3期 売上高 472億円</title></rect><rect x=\"185.5\" y=\"31.0\" width=\"34.0\" height=\"99.0\" rx=\"2\" fill=\"#cfe0f5\"><title>25/3期 売上高 453億円</title></rect><rect x=\"250.5\" y=\"17.2\" width=\"34.0\" height=\"112.8\" rx=\"2\" fill=\"#cfe0f5\"><title>26/3期 売上高 516億円</title></rect><polyline points=\"72.5,67.6 137.5,87.1 202.5,50.2 267.5,17.2\" fill=\"none\" stroke=\"#178a5b\" stroke-width=\"1.8\"/><circle cx=\"72.5\" cy=\"67.6\" r=\"2.4\" fill=\"#178a5b\"><title>23/3期 経常利益 50億円</title></circle><circle cx=\"137.5\" cy=\"87.1\" r=\"2.4\" fill=\"#178a5b\"><title>24/3期 経常利益 34億円</title></circle><circle cx=\"202.5\" cy=\"50.2\" r=\"2.4\" fill=\"#178a5b\"><title>25/3期 経常利益 64億円</title></circle><circle cx=\"267.5\" cy=\"17.2\" r=\"2.4\" fill=\"#178a5b\"><title>26/3期 経常利益 90億円</title></circle><polyline points=\"72.5,87.1 137.5,104.0 202.5,74.9 267.5,48.4\" fill=\"none\" stroke=\"#7d55c7\" stroke-width=\"1.8\"/><circle cx=\"72.5\" cy=\"87.1\" r=\"2.4\" fill=\"#7d55c7