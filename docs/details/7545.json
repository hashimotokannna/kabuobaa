\" onclick=\"spSwap(this, '10')\">10年</button><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, 'all')\">全期間(26年)</button></span></div><div class=\"spark spv\" data-sp=\"1\" style=\"display:none\"><svg viewBox=\"0 0 320 110\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:100%; height:auto; background:#fffdf6; border-radius:8px;\"><rect x=\"0\" y=\"45.3\" width=\"320\" height=\"25.5\" fill=\"#c62f2f\" opacity=\"0.12\"/><polyline points=\"4.0,40.9 9.1,21.0 14.2,22.3 19.3,32.6 24.5,35.2 29.6,23.3 34.7,48.3 39.8,49.9 44.9,46.5 50.0,45.3 55.1,35.6 60.3,28.9 65.4,37.0 70.5,22.9 75.6,12.8 80.7,17.0 85.8,27.1 91.0,38.8 96.1,40.7 101.2,46.9 106.3,49.5 111.4,42.7 116.5,42.7 121.6,29.5 126.8,47.1 131.9,48.9 137.0,62.3 142.1,65.5 147.2,73.8 152.3,74.4 157.4,66.7 162.6,77.2 167.7,78.0 172.8,70.0 177.9,74.4 183.0,86.9 188.1,97.2 193.2,75.6 198.4,56.4 203.5,63.1 208.6,67.1 213.7,78.6 218.8,52.2 223.9,71.0 229.0,57.8 234.2,66.1 239.3,62.9 244.4,59.6 249.5,63.3 254.6,66.3 259.7,73.6 264.9,73.2 270.0,75.6 275.1,77.6 280.2,87.1 285.3,78.6 290.4,85.3 295.5,95.8 300.7,84.5 305.8,87.3 310.9,72.8 316.0,81.5\" fill=\"none\" stroke=\"#1c1c1e\" stroke-width=\"1.6\"/><path d=\"M 4.0 52.9 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 4.0 52.9 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 4.0 52.9 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 4.0 52.9 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 4.0 52.9 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 4.0 52.9 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 4.0 52.9 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 4.0 52.9 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 4.0 52.9 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 39.8 61.9 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 116.5 54.7 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><circle cx=\"316.0\" cy=\"81.5\" r=\"4\" fill=\"#1c1c1e\"/></svg></div><div class=\"spark spv\" data-sp=\"3\" style=\"display:\"><svg viewBox=\"0 0 320 110\" xmlns=\"http://www.w3.org/2000/svg\