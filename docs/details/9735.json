分析します）。</div><div class=\"spwrap\"><div class=\"nhead\">値動きと長期支持帯<span class=\"spbtns\"><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, '1')\">1年</button><button type=\"button\" class=\"spbtn on\" onclick=\"spSwap(this, '3')\">3年</button><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, '10')\">10年</button><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, 'all')\">全期間(27年)</button></span></div><div class=\"spark spv\" data-sp=\"1\" style=\"display:none\"><svg viewBox=\"0 0 320 110\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:100%; height:auto; background:#fffdf6; border-radius:8px;\"><rect x=\"0\" y=\"76.9\" width=\"320\" height=\"7.3999999999999915\" fill=\"#c62f2f\" opacity=\"0.12\"/><polyline points=\"4.0,78.5 9.1,84.6 14.2,87.9 19.3,87.6 24.5,97.0 29.6,92.1 34.7,97.2 39.8,97.0 44.9,89.1 50.0,91.7 55.1,87.7 60.3,87.6 65.4,82.7 70.5,83.5 75.6,76.5 80.7,73.7 85.8,74.5 91.0,79.1 96.1,73.1 101.2,65.3 106.3,66.3 111.4,69.8 116.5,63.2 121.6,51.2 126.8,61.8 131.9,57.4 137.0,54.8 142.1,58.4 147.2,55.3 152.3,53.3 157.4,63.1 162.6,57.1 167.7,50.7 172.8,50.0 177.9,54.9 183.0,61.0 188.1,72.4 193.2,74.7 198.4,52.1 203.5,38.7 208.6,33.5 213.7,39.7 218.8,40.0 223.9,30.2 229.0,38.7 234.2,29.7 239.3,37.4 244.4,32.6 249.5,24.4 254.6,26.0 259.7,21.1 264.9,12.8 270.0,14.0 275.1,21.9 280.2,32.2 285.3,39.1 290.4,35.4 295.5,32.9 300.7,37.3 305.8,41.4 310.9,37.6 316.0,37.7\" fill=\"none\" stroke=\"#1c1c1e\" stroke-width=\"1.6\"/><path d=\"M 4.0 90.5 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 91.0 91.1 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 111.4 81.8 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 198.4 64.1 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><circle cx=\"316.0\" cy=\"37.7\" r=\"4\" fill=\"#1c1c1e\"/></svg></div><div class=\"spark spv\" data-sp=\"3\" style=\"display:\"><svg viewBox=\"0 0 320 110\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:100%; height:auto; background:#fffdf6; border-radius:8px;\"><rect x=\"0\" y=\