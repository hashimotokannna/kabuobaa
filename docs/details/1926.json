今夜の厳選・出尽くしサイン・レーティング変化・注目開示などの注目銘柄のみ、毎晩の実行で場中の5分足を取得して分析します）。</div><div class=\"spwrap\"><div class=\"nhead\">値動きと長期支持帯<span class=\"spbtns\"><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, '1')\">1年</button><button type=\"button\" class=\"spbtn on\" onclick=\"spSwap(this, '3')\">3年</button><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, '10')\">10年</button><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, 'all')\">全期間(26年)</button></span></div><div class=\"spark spv\" data-sp=\"1\" style=\"display:none\"><svg viewBox=\"0 0 320 110\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:100%; height:auto; background:#fffdf6; border-radius:8px;\"><rect x=\"0\" y=\"50.3\" width=\"320\" height=\"5.900000000000006\" fill=\"#c62f2f\" opacity=\"0.12\"/><polyline points=\"4.0,97.2 9.1,92.2 14.2,89.0 19.3,91.8 24.5,87.9 29.6,88.3 34.7,87.1 39.8,88.3 44.9,77.7 50.0,78.5 55.1,80.4 60.3,79.3 65.4,75.3 70.5,77.3 75.6,74.6 80.7,64.8 85.8,59.3 91.0,61.3 96.1,69.1 101.2,59.3 106.3,29.2 111.4,32.3 116.5,19.4 121.6,12.8 126.8,33.1 131.9,24.9 137.0,24.1 142.1,31.9 147.2,32.7 152.3,32.3 157.4,34.3 162.6,36.2 167.7,44.9 172.8,42.1 177.9,39.8 183.0,22.1 188.1,30.8 193.2,22.6 198.4,26.8 203.5,30.4 208.6,32.3 213.7,28.0 218.8,31.5 223.9,24.1 229.0,21.8 234.2,26.1 239.3,38.6 244.4,42.1 249.5,43.3 254.6,53.8 259.7,46.8 264.9,45.6 270.0,50.7 275.1,43.3 280.2,46.0 285.3,40.2 290.4,42.9 295.5,35.5 300.7,45.9 305.8,45.2 310.9,49.9 316.0,39.0\" fill=\"none\" stroke=\"#1c1c1e\" stroke-width=\"1.6\"/><path d=\"M 147.2 44.7 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 172.8 54.1 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 254.6 65.8 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 270.0 62.7 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 285.3 52.2 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><circle cx=\"316.0\" cy=\"39.0\" r=\"4\" fill=\"#1c1c1e\"/></svg></div><div class=\"spark spv\" data-sp=\"3\" style=\"display:\"><svg viewBox=\"0 0 320 110\" xmlns=\"http: