ype=\"button\" class=\"spbtn\" onclick=\"spSwap(this, '10')\">10年</button><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, 'all')\">全期間(26年)</button></span></div><div class=\"spark spv\" data-sp=\"1\" style=\"display:none\"><svg viewBox=\"0 0 320 110\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:100%; height:auto; background:#fffdf6; border-radius:8px;\"><rect x=\"0\" y=\"81.4\" width=\"320\" height=\"15.799999999999997\" fill=\"#c62f2f\" opacity=\"0.12\"/><polyline points=\"4.0,75.9 9.1,73.0 14.2,69.6 19.3,75.9 24.5,56.8 29.6,41.8 34.7,46.5 39.8,24.1 44.9,31.7 50.0,34.6 55.1,31.3 60.3,30.3 65.4,34.6 70.5,38.2 75.6,44.7 80.7,42.8 85.8,42.2 91.0,46.0 96.1,43.2 101.2,28.9 106.3,34.6 111.4,29.8 116.5,37.1 121.6,30.8 126.8,37.0 131.9,13.7 137.0,12.8 142.1,37.5 147.2,49.8 152.3,63.7 157.4,60.8 162.6,65.3 167.7,68.8 172.8,79.2 177.9,73.5 183.0,64.2 188.1,62.8 193.2,72.8 198.4,77.7 203.5,79.4 208.6,69.0 213.7,49.1 218.8,57.8 223.9,52.9 229.0,57.8 234.2,55.9 239.3,66.1 244.4,63.5 249.5,59.6 254.6,54.1 259.7,55.6 264.9,59.8 270.0,68.5 275.1,66.1 280.2,65.5 285.3,68.4 290.4,74.9 295.5,79.6 300.7,79.4 305.8,82.1 310.9,69.8 316.0,76.9\" fill=\"none\" stroke=\"#1c1c1e\" stroke-width=\"1.6\"/><path d=\"M 4.0 87.9 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 4.0 87.9 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 4.0 87.9 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 4.0 87.9 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 4.0 87.9 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 4.0 87.9 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 172.8 91.2 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 198.4 89.7 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><circle cx=\"316.0\" cy=\"76.9\" r=\"4\" fill=\"#1c1c1e\"/></svg></div><div class=\"spark spv\" data-sp=\"3\" style=\"display:\"><svg viewBox=\"0 0 320 110\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:100%; height:auto; background:#fffdf6; border-radius:8px;\"><rect x=\"0\" y=\"72.8\" width=\"320\" height=\"14.0