・注目開示などの注目銘柄のみ、毎晩の実行で場中の5分足を取得して分析します）。</div><div class=\"spwrap\"><div class=\"nhead\">値動きと長期支持帯<span class=\"spbtns\"><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, '1')\">1年</button><button type=\"button\" class=\"spbtn on\" onclick=\"spSwap(this, '3')\">3年</button><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, '10')\">10年</button><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, 'all')\">全期間(26年)</button></span></div><div class=\"spark spv\" data-sp=\"1\" style=\"display:none\"><svg viewBox=\"0 0 320 110\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:100%; height:auto; background:#fffdf6; border-radius:8px;\"><rect x=\"0\" y=\"90.2\" width=\"320\" height=\"7.0\" fill=\"#c62f2f\" opacity=\"0.12\"/><polyline points=\"4.0,83.4 9.1,75.3 14.2,70.2 19.3,72.3 24.5,67.8 29.6,66.5 34.7,56.9 39.8,55.1 44.9,51.0 50.0,39.4 55.1,42.8 60.3,40.6 65.4,43.7 70.5,33.9 75.6,13.9 80.7,29.0 85.8,31.6 91.0,31.8 96.1,53.4 101.2,48.2 106.3,46.9 111.4,44.1 116.5,43.1 121.6,46.5 126.8,44.6 131.9,38.9 137.0,29.2 142.1,23.0 147.2,12.8 152.3,21.9 157.4,33.3 162.6,29.2 167.7,37.2 172.8,35.0 177.9,39.1 183.0,31.9 188.1,32.1 193.2,34.1 198.4,33.2 203.5,40.9 208.6,44.2 213.7,48.7 218.8,52.1 223.9,62.3 229.0,60.1 234.2,53.8 239.3,55.1 244.4,50.0 249.5,50.8 254.6,54.3 259.7,55.0 264.9,51.3 270.0,59.7 275.1,60.4 280.2,68.0 285.3,65.9 290.4,67.9 295.5,64.3 300.7,72.3 305.8,69.5 310.9,62.7 316.0,74.2\" fill=\"none\" stroke=\"#1c1c1e\" stroke-width=\"1.6\"/><path d=\"M 4.0 95.4 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 300.7 84.3 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><circle cx=\"316.0\" cy=\"74.2\" r=\"4\" fill=\"#1c1c1e\"/></svg></div><div class=\"spark spv\" data-sp=\"3\" style=\"display:\"><svg viewBox=\"0 0 320 110\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:100%; height:auto; background:#fffdf6; border-radius:8px;\"><rect x=\"0\" y=\"52.2\" width=\"320\" height=\"3.8999999999999986\" fill=\"#c62f2f\" opacity=\"0.12\"/><polyline poi