iv class=\"nhead\">板・売買フローの推定（AI）</div><div class=\"discnote\">この銘柄は本日の分析対象外です（今夜の厳選・出尽くしサイン・レーティング変化・注目開示などの注目銘柄のみ、毎晩の実行で場中の5分足を取得して分析します）。</div><div class=\"spwrap\"><div class=\"nhead\">値動きと長期支持帯<span class=\"spbtns\"><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, '1')\">1年</button><button type=\"button\" class=\"spbtn on\" onclick=\"spSwap(this, '3')\">3年</button><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, '10')\">10年</button><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, 'all')\">全期間(27年)</button></span></div><div class=\"spark spv\" data-sp=\"1\" style=\"display:none\"><svg viewBox=\"0 0 320 110\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:100%; height:auto; background:#fffdf6; border-radius:8px;\"><rect x=\"0\" y=\"70.7\" width=\"320\" height=\"9.099999999999994\" fill=\"#c62f2f\" opacity=\"0.12\"/><polyline points=\"4.0,87.4 9.1,91.7 14.2,95.5 19.3,92.1 24.5,97.2 29.6,93.3 34.7,93.4 39.8,85.0 44.9,70.9 50.0,49.2 55.1,57.6 60.3,41.7 65.4,52.4 70.5,46.7 75.6,54.3 80.7,57.4 85.8,58.7 91.0,60.6 96.1,52.2 101.2,51.4 106.3,50.8 111.4,39.1 116.5,55.8 121.6,44.7 126.8,12.8 131.9,48.8 137.0,40.3 142.1,55.9 147.2,56.7 152.3,69.1 157.4,69.9 162.6,59.8 167.7,55.7 172.8,64.1 177.9,56.3 183.0,27.2 188.1,63.6 193.2,65.2 198.4,57.1 203.5,63.8 208.6,78.3 213.7,62.4 218.8,60.6 223.9,38.7 229.0,36.7 234.2,23.0 239.3,32.6 244.4,52.2 249.5,44.3 254.6,72.1 259.7,62.2 264.9,49.2 270.0,22.6 275.1,36.0 280.2,41.2 285.3,44.5 290.4,40.4 295.5,55.3 300.7,55.9 305.8,55.0 310.9,43.9 316.0,52.7\" fill=\"none\" stroke=\"#1c1c1e\" stroke-width=\"1.6\"/><path d=\"M 4.0 99.4 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 4.0 99.4 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 152.3 81.1 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 172.8 76.1 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 193.2 77.2 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 254.6 84.1 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><circle cx=\"316.0\" cy=\"52.7\" r=\"