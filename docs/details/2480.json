.4\" fill=\"#7d55c7\"><title>25/3期 純利益 3億円</title></circle><circle cx=\"267.5\" cy=\"74.6\" r=\"2.4\" fill=\"#7d55c7\"><title>26/3期 純利益 3億円</title></circle><text x=\"72.5\" y=\"144\" font-size=\"8.5\" fill=\"#a99a76\" text-anchor=\"middle\">23/3期</text><text x=\"137.5\" y=\"144\" font-size=\"8.5\" fill=\"#a99a76\" text-anchor=\"middle\">24/3期</text><text x=\"202.5\" y=\"144\" font-size=\"8.5\" fill=\"#a99a76\" text-anchor=\"middle\">25/3期</text><text x=\"267.5\" y=\"144\" font-size=\"8.5\" fill=\"#a99a76\" text-anchor=\"middle\">26/3期</text><text x=\"303\" y=\"25.2\" font-size=\"8\" fill=\"#7ba0cc\">17億</text><text x=\"303\" y=\"132\" font-size=\"8\" fill=\"#7ba0cc\">売上</text><text x=\"4\" y=\"25.2\" font-size=\"8\" fill=\"#8a6f4d\">6億</text><text x=\"4\" y=\"132\" font-size=\"8\" fill=\"#8a6f4d\">利益</text></svg></div><div class=\"finlg\"><span><i style=\"background:#cfe0f5\"></i>売上高（右軸）</span><span><i style=\"background:#c9661f\"></i>営業利益</span><span><i style=\"background:#178a5b\"></i>経常利益</span><span><i style=\"background:#7d55c7\"></i>純利益</span></div><div class=\"finrow finhead\"><span class=\"fp\"></span><span class=\"fc\">売上高</span><span class=\"fc\">営業利益</span><span class=\"fc\">純利益</span></div><div class=\"finrow\"><span class=\"fp\">26/3期</span><span class=\"fc\">17億円</span><span class=\"fc\">6億円</span><span class=\"fc\">3億円</span></div><div class=\"finrow\"><span class=\"fp\">25/3期</span><span class=\"fc\">17億円</span><span class=\"fc\">5億円</span><span class=\"fc\">3億円</span></div><div class=\"finrow\"><span class=\"fp\">24/3期</span><span class=\"fc\">17億円</span><span class=\"fc\">6億円</span><span class=\"fc\">4億円</span></div><div class=\"finrow\"><span class=\"fp\">23/3期</span><span class=\"fc\">17億円</span><span class=\"fc\">6億円</span><span class=\"fc\">4億円</span></div><div class=\"discnote\">グラフの棒・点にカーソルを合わせると数値が出ます。決算履歴は毎晩の実行で自動蓄積され、期間は時間とともに伸びていきます。古い年度はYahoo Financeの年次データで補完しています（この区間の経常利益は税引前利益で代用。決算短信の実測が入り次第、自動で置き換わります）。</div><div class=\"nhead\">ファンダメンタル指標</div><div class=\"fact\"><span>PER</span><span class=\"num\">22.2倍</span></div><div class=\"fact\"><span>PBR</span><span class=\"num\">1.63倍</span></div><div class=\"fact\"><span>ROE</span><span class=\"num\">7.3%</span></div><div class=\"fact\"><span>配当利回り</span><span class=\"num\">2.04%</span></div><div class=\"fact\"><span>時価総額</span><span class=\"num\">66億円</span></div><div class=\"nhead\">アナリスト・コンセンサス（証券会社レーティング）</div><div class=\"discnote\">この銘柄は現時点で<b>カバレッジ対象外</b>です（証券会社アナリストによる平均評価・平均目標株価の公表データがありません）。レーティングは主に中大型株が対象で、小型株はカバーされないことが多くあります。データが取得でき次第、ここに自動で表示されます。</div><div class=\"nhead\">板・売買フローの推定（09/17の15分足・AI）</div><div class=\"fprof\"><div class=\"fpcol\"><div class=\"fpbar\" style=\"height:46px\"></div><span class=\"fplab\">9時</span></div><div class=\"fpcol\"><div class=\"fpbar\" style=\"height:7px\"></div><span class=\"fplab\"></span></div><div class=\"fpcol\"><div class=\"fpbar\" style=\"height:13px\"></div><span class=\"fplab\">10時</span></div><div class=\"fpcol\"><div class=\"fpbar\" style=\"height:3px\"></div><span class=\"fplab\"></span></div><div class=\"fpcol\"><div class=\"fpbar\" style=\"height:3px\"></div><span class=\"fplab\">11時</span></div><div class=\"fpcol\"><div class=\"fpbar\" style=\"height:13px\"></div><span class=\"fplab\">12時半</span></div><div class=\"fpcol\"><div class=\"fpbar\" style=\"height:13px\"></div><span class=\"fplab\"></span></div><div class=\"fpcol\"><div class=\"fpbar\" style=\"height:13px\"></div><span class=\"fplab\">13時半</span></div><div class=\"fpcol\"><div class=\"fpbar\" style=\"height:3px\"></div><span class=\"fplab\"></span></div><div class=\"fpcol\"><div class=\"fpbar\" style=\"height:13px\"></div><span class=\"fplab\">14時半</span></div><div class=\"fpcol\"><div class=\"fpbar\" style=\"height:20px\"></div><span class=\"fplab\">引け</span></div></div><div class=\"fplegend\">時間帯ごとの出来高（どの時間に売買が集中したか）</div><div class=\"fact\"><span>この日の値動き</span><span class=\"num\">+0.7%（値幅2.5%）</span></div><div class=\"fact\"><span>出来高（普段の日足平均との比）</span><span class=\"num\">0.9倍</span></div><div class=\"fact\"><span>終値とVWAP（1日の平均約定価格）の差</span><span class=\"num\">-0.63%</span></div><div class=\"fact\"><span>寄り30分／引け30分の出来高シェア</span><span class=\"num\">33% ／ 14%</span></div><div class=\"fsub\">裏にいそうな売買主体（機械推定・上位2件）</div><div class=\"factor\"><div class=\"factorh\">🎯 デイトレ・アルゴの回転売買<span class=\"fconf\">一致度80・確度高</span></div><div class=\"exhwhy\">・5分足の方向転換率62%（細かい往復＝回転売買）</div><div class=\"exhwhy\">・方向感なく出来高だけこなす1日</div><div class=\"exhwhy\">・値幅2.4%の割に行って来い</div></div><div class=\"discnote\">リアルタイムの板（気配値・注文残）は取引所の有料データのため、場中の5分足の値動きと出来高の「形」から典型パターンとの一致度で推定しています。実際の注文主体を特定するものではありません。寄り集中＝個人の飛びつき、引け集中＋VWAP沿い＝機関の執行、出来高増なのに値幅が静か＝大口の仕込み、といった市場の経験則を採点式にしたものです。</div><div class=\"spwrap\"><div class=\"nhead\">値動きと長期支持帯<span class=\"spbtns\"><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, '1')\">1年</button><button type=\"button\" class=\"spbtn on\" onclick=\"spSwap(this, '3')\">3年</button><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, '10')\">10年</button><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, 'all')\">全期間(20年)</button></span></div><div class=\"spark spv\" data-sp=\"1\" style=\"display:none\"><svg viewBox=\"0 0 320 110\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:100%; height:auto; background:#fffdf6; border-radius:8px;\"><rect x=\"0\" y=\"55.1\" width=\"320\" height=\"4.799999999999997\" fill=\"#c62f2f\" opacity=\"0.12\"/><polyline points=\"4.0,62.1 9.1,78.7 14.2,97.2 19.3,72.2 24.5,79.7 29.6,54.9 34.7,61.4 39.8,65.9 44.9,72.2 50.0,79.4 55.1,70.2 60.3,67.4 65.4,72.7 70.5,76.4 75.6,70.7 80.7,55.4 85.8,64.4 91.0,50.1 96.1,53.4 101.2,54.6 106.3,55.9 111.4,50.4 116.5,51.1 121.6,53.9 126.8,44.6 131.9,48.6 137.0,47.4 142.1,50.6 147.2,51.9 152.3,50.9 157.4,54.4 162.6,70.7 167.7,54.6 172.8,56.1 177.9,54.6 183.0,54.6 188.1,55.1 193.2,54.6 198.4,54.9 203.5,54.6 208.6,54.6 213.7,52.4 218.8,55.6 223.9,54.6 229.0,58.4 234.2,57.9 239.3,54.6 244.4,54