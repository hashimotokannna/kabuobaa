" onclick=\"spSwap(this, '10')\">10年</button><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, 'all')\">全期間(26年)</button></span></div><div class=\"spark spv\" data-sp=\"1\" style=\"display:none\"><svg viewBox=\"0 0 320 110\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:100%; height:auto; background:#fffdf6; border-radius:8px;\"><rect x=\"0\" y=\"95.4\" width=\"320\" height=\"2\" fill=\"#c62f2f\" opacity=\"0.12\"/><polyline points=\"4.0,57.4 9.1,62.9 14.2,21.4 19.3,12.8 24.5,40.9 29.6,27.3 34.7,31.5 39.8,33.4 44.9,31.6 50.0,45.9 55.1,57.3 60.3,57.3 65.4,54.4 70.5,51.2 75.6,54.5 80.7,62.0 85.8,53.1 91.0,62.9 96.1,66.4 101.2,68.0 106.3,64.5 111.4,75.7 116.5,71.9 121.6,72.5 126.8,75.9 131.9,85.5 137.0,85.0 142.1,82.0 147.2,80.8 152.3,80.3 157.4,84.9 162.6,82.7 167.7,76.5 172.8,82.9 177.9,90.7 183.0,91.3 188.1,93.2 193.2,90.0 198.4,85.1 203.5,85.0 208.6,88.6 213.7,82.5 218.8,76.2 223.9,78.2 229.0,76.9 234.2,72.9 239.3,77.7 244.4,78.2 249.5,89.5 254.6,92.1 259.7,85.7 264.9,88.4 270.0,91.1 275.1,93.4 280.2,89.8 285.3,85.9 290.4,90.9 295.5,88.9 300.7,87.8 305.8,84.3 310.9,89.2 316.0,91.8\" fill=\"none\" stroke=\"#1c1c1e\" stroke-width=\"1.6\"/><path d=\"M 193.2 102.0 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 244.4 90.2 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 275.1 105.4 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><circle cx=\"316.0\" cy=\"91.8\" r=\"4\" fill=\"#1c1c1e\"/></svg></div><div class=\"spark spv\" data-sp=\"3\" style=\"display:\"><svg viewBox=\"0 0 320 110\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:100%; height:auto; background:#fffdf6; border-radius:8px;\"><rect x=\"0\" y=\"96.1\" width=\"320\" height=\"2\" fill=\"#c62f2f\" opacity=\"0.12\"/><polyline points=\"4.0,41.6 6.1,42.4 8.3,19.1 10.4,22.6 12.5,17.0 14.7,12.8 16.8,18.9 19.0,18.2 21.1,35.3 23.2,34.3 25.4,32.2 27.5,36.8 29.6,37.8 31.8,39.2 33.9,47.9 36.1,53.0 38.2,51.2 40.3,53.6 42.5,40.6 44.6,36.8 46.7,41.3 48.9,44.0 51.0,46.7 53.2,47.5 55.3,47.6 57.4,47.3 59.6,47.1 61.7,6