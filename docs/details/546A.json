h:40.0%; background:#eeeae0\"></div><div class=\"mz\" style=\"left:70.0%; width:10.0%; background:#f5e6b3\"></div><div class=\"mz\" style=\"left:80.0%; width:20.0%; background:#f2c4a8\"></div><div class=\"mpin\" style=\"left:53.5%\"></div></div><span class=\"mv num\">54</span></div><div class=\"mrow\"><span class=\"ml\">ADX(トレンド強さ)</span><div class=\"mtrack\"><div class=\"mz\" style=\"left:0.0%; width:33.3%; background:#eeeae0\"></div><div class=\"mz\" style=\"left:33.3%; width:8.3%; background:#f5e6b3\"></div><div class=\"mz\" style=\"left:41.7%; width:58.3%; background:#f2c4a8\"></div><div class=\"mpin\" style=\"left:28.5%\"></div></div><span class=\"mv num\">17↓</span></div><div class=\"mrow\"><span class=\"ml\">一目・雲</span><div class=\"mtrack\"><div class=\"mz\" style=\"left:0.0%; width:33.3%; background:#f2c4a8\"></div><div class=\"mz\" style=\"left:33.3%; width:33.3%; background:#f5e6b3\"></div><div class=\"mz\" style=\"left:66.7%; width:33.3%; background:#b9dcc0\"></div><div class=\"mpin\" style=\"left:16.7%\"></div></div><span class=\"mv num\">雲の下</span></div><div class=\"mrow\"><span class=\"ml\">ATR(日々の値幅)</span><div class=\"mtrack\"><div class=\"mz\" style=\"left:0.0%; width:20.0%; background:#b9dcc0\"></div><div class=\"mz\" style=\"left:20.0%; width:15.0%; background:#eeeae0\"></div><div class=\"mz\" style=\"left:35.0%; width:15.0%; background:#f5e6b3\"></div><div class=\"mz\" style=\"left:50.0%; width:50.0%; background:#f2c4a8\"></div><div class=\"mpin\" style=\"left:52.3%\"></div></div><span class=\"mv num\">5.2%</span></div><div class=\"mrow\"><span class=\"ml\">HV(年率変動)</span><div class=\"mtrack\"><div class=\"mz\" style=\"left:0.0%; width:20.8%; background:#b9dcc0\"></div><div class=\"mz\" style=\"left:20.8%; width:12.5%; background:#eeeae0\"></div><div class=\"mz\" style=\"left:33.3%; width:16.7%; background:#f5e6b3\"></div><div class=\"mz\" style=\"left:50.0%; width:50.0%; background:#f2c4a8\"></div><div class=\"mpin\" style=\"left:42.4%\"></div></div><span class=\"mv num\">51%</span></div><div class=\"mrow\"><span class=\"ml\">OBV(20日)</span><div class=\"mtrack\"><div class=\"mz\" style=\"left:0.0%; width:40.0%; background:#f2c4a8\"></div><div class=\"mz\" style=\"left:40.0%; width:10.0%; background:#f5e6b3\"></div><div class=\"mz\" style=\"left:50.0%; width:10.0%; background:#eeeae0\"></div><div class=\"mz\" style=\"left:60.0%; width:40.0%; background:#b9dcc0\"></div><div class=\"mpin\" style=\"left:28.4%\"></div></div><span class=\"mv num\">-22%</span></div><div class=\"mrow\"><span class=\"ml\">自己資本比率</span><div class=\"mtrack\"><div class=\"mz\" style=\"left:0.0%; width:20.0%; background:#f2c4a8\"></div><div class=\"mz\" style=\"left:20.0%; width:15.0%; background:#f5e6b3\"></div><div class=\"mz\" style=\"left:35.0%; width:15.0%; background:#eeeae0\"></div><div class=\"mz\" style=\"left:50.0%; width:50.0%; background:#b9dcc0\"></div><div class=\"mpin\" style=\"left:37.9%\"></div></div><span class=\"mv num\">38%</span></div><div class=\"mrow\"><span class=\"ml\">営業利益率</span><div class=\"mtrack\"><div class=\"mz\" style=\"left:0.0%; width:25.0%; background:#f2c4a8\"></div><div class=\"mz\" style=\"left:25.0%; width:12.5%; background:#f5e6b3\"></div><div class=\"mz\" style=\"left:37.5%; width:12.5%; background:#eeeae0\"></div><div class=\"mz\" style=\"left:50.0%; width:50.0%; background:#b9dcc0\"></div><div class=\"mpin\" style=\"left:32.0%\"></div></div><span class=\"mv num\">2.8%</span></div><div class=\"mrow\"><span class=\"ml\">ROA</span><div class=\"mtrack\"><div class=\"mz\" style=\"left:0.0%; width:20.0%; background:#f2c4a8\"></div><div class=\"mz\" style=\"left:20.0%; width:8.0%; background:#f5e6b3\"></div><div class=\"mz\" style=\"left:28.0%; width:12.0%; background:#eeeae0\"></div><div class=\"mz\" style=\"left:40.0%; width:60.0%; background:#b9dcc0\"></div><div class=\"mpin\" style=\"left:34.0%\"></div></div><span class=\"mv num\">3.5%</span></div><div class=\"mrow\"><span class=\"ml\">配当性向</span><div class=\"mtrack\"><div class=\"mz\" style=\"left:0.0%; width:20.0%; background:#eeeae0\"></div><div class=\"mz\" style=\"left:20.0%; width:20.0%; background:#b9dcc0\"></div><div class=\"mz\" style=\"left:40.0%; width:26.7%; background:#f5e6b3\"></div><div class=\"mz\" style=\"left:66.7%; width:33.3%; background:#f2c4a8\"></div><div class=\"mpin\" style=\"left:13.1%\"></div></div><span class=\"mv num\">20%</span></div><div class=\"mrow\"><span class=\"ml\">PEG</span><div class=\"mtrack\"><div class=\"mz\" style=\"left:0.0%; width:20.0%; background:#c9dcf3\"></div><div class=\"mz\" style=\"left:20.0%; width:20.0%; background:#b9dcc0\"></div><div class=\"mz\" style=\"left:40.0%; width:20.0%; background:#f5e6b3\"></div><div class=\"mz\" style=\"left:60.0%; width:40.0%; background:#f2c4a8\"></div><div class=\"mpin\" style=\"left:2.0%\"></div></div><span class=\"mv num\">0.10</span></div></div><div class=\"discnote\">ピンが現在値。PER・PBRなど価値系は「標準」が最も安心、割安は魅力だが「割安の罠」の確認が必要。RSI・ボリンジャーなど行きすぎ系は売られすぎ側が押し目買いに有利。読み方は「指標の読み方」ページへ。</div><div class=\"nhead\">スコア 142点（候補圏外）</div><div class=\"reason\">・直近20日高値から −21.1%（安さの主基準 +64点・8%で頭打ち）</div><div class=\"reason\">・普段の値段（20日平均）より 7.4%安い（+20点）</div><div class=\"reason\">・下げが複数日に分散した「じわ下げ」で、1日の急落で作られた安さではない（+15点）</div><div class=\"reason\">・過去1年、同じ買い方で 6回 利確ライン（+5%）に到達（+30点）</div><div class=\"reason\">・ただし直近の仮想買いが塩漬け中（−15点）</div><div class=\"reason\">・25日移動平均線から-9.9%下方乖離（逆張りの定番圏 +6点）</div><div class=\"reason\">・スローストキャス 6 の売られすぎ圏（+4点）</div><div class=\"reason\">・一目均衡表の雲の下（中期は弱い −3点）</div><div class=\"reason\">・ATR 5.2%と値幅が大きく、損切りが機能しにくい（−3点）</div><div class=\"reason\">・PER 8.2倍と利益に対して妥当〜割安の水準（+8点）</div><div class=\"reason\">・PBR 0.77倍と資産に対して割安圏。下値が固くなりやすい（+6点）</div><div class=\"reason\">・PEG 0.10倍＝成長率に対して株価が割安（+4点）</div><div class=\"reason\">・1日平均 4.6億円の売買（+6点）</div><div class=\"nhead\">減点方式: 全体49位（−5点）</div><div class=\"hit\"><span class=\"sev sevC\">軽い</span>直近の仮想買いが塩漬け中<span class=\"num hp\">−5</span></div><div class=\"nhead\">TOB素地スコア: 50点（全体886位）</div><div class=\"reason\">・PBR 0.77倍 ＝ 解散価値を大きく下回る（+16）</div><div class=\"reason\">・時価総額 691億円 ＝ TOB・MBOの主戦場サイズ（+15）</div><div class=\"reason\">・配当性向 20% ＝ 黒字なのに還元が渋い（+5）</div><div class=\"reason\">・株価は1年レンジの下位25%に放置（+6）</div><div class=\"reason\">・プライムでPBR1倍割れ ＝ 東証の改善要請が直撃（+4）</div><div class=\"reason\">・PER 8.2倍 ＝ 利益面でも割安（+4）</div><div class=\"discnote\">買収・非公開化されやすい「体質」の順位で、発生の予測ではありません。全体像と注意点は上部タブの「TOB素地」ページへ。</div><div class=\"nhead\">業績の推移（四半期開示の推移（累計ベース）・決算短信より）</div><div class=\"finchart\"><svg viewBox=\"0 0 340 150\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:100%; height:auto; background:#fffdf6; border-radius:8px;\"><rect x=\"153.0\" y=\"17.2\" width=\"34.0\" height=\"112.8\" rx=\"2\" fill=\"#cfe0f5\"><title>26/6 売上高 1,246億円</title></rect><text x=\"170.0\" y=\"144\" font-size=\"8.5\" fill=\"#a99a76\" text-anchor=\"middle\">26/6</text><text x=\"303\" y=\"25.2\" font-size=\"8\" fill=\"#7ba0cc\">1,246億</text><text x=\"303\" y=\"132\" font-size=\"8\" fill=\"#7ba0cc\">売上</text><text x=\"4\" y=\"25.2\" font-size=\"8\" fill=\"#8a6f4d\">84億</text><text x=\"4\" y=\"132\" font-size=\"8\" fill=\"#8a6f4d\">利益</text></svg></div><div class=\"finlg\"><span><i style=\"background:#cfe0f5\"></i>売上高（右軸）</span></div><div class=\"finrow finhead\"><span class=\"fp\"></span><span class=\"fc\">売上高</span><span class=\"fc\">営業利益</span><span class=\"fc\">純利益</span></div><div class=\"finrow\"><span class=\"fp\">26/6</span><span class=\"fc\">1,246億円</span><span class=\"fc\">35億円</span><span class=\"fc\">84億円</span></div><div class=\"discnote\">グラフの棒・点にカーソルを合わせると数値が出ます。決算履歴は毎晩の実行で自動蓄積され、期間は時間とともに伸びていきます。</div><div class=\"nhead\">ファンダメンタル指標</div><div class=\"fact\"><span>PER</span><span class=\"num\">8.2倍</span></div><div class=\"fact\"><span>PBR</span><span class=\"num\">0.77倍</span></div><div class=\"fact\"><span>ROE</span><span class=\"num\">9.3%</span></div><div class=\"fact\"><span>配当利回り</span><span class=\"num\">2.40%</span></div><div class=\"fact\"><span>時価総額</span><span class=\"num\">691億円</span></div><div class=\"nhead\">アナリスト・コンセンサス（証券会社レーティング）</div><div class=\"discnote\">この銘柄は現時点で<b>カバレッジ対象外</b>です（証券会社アナリストによる平均評価・平均目標株価の公表データがありません）。レーティングは主に中大型株が対象で、小型株はカバーされないことが多くあります。データが取得でき次第、ここに自動で表示されます。</div><div class=\"nhead\">板・売買フローの推定（11/27の5分足・AI）</div><div class=\"fprof\"><div class=\"fpcol\"><div class=\"fpbar\" style=\"height:46px\"></div><span class=\"fplab\">9時</span></div><div class=\"fpcol\"><div class=\"fpbar\" style=\"height:14px\"></div><span class=\"fplab\"></span></div><div class=\"fpcol\"><div class=\"fpbar\" style=\"height:22px\"></div><span class=\"fplab\">10時</span></div><div class=\"fpcol\"><div class=\"fpbar\" style=\"height:10px\"></div><span class=\"fplab\"></span></div><div class=\"fpcol\"><div class=\"fpbar\" style=\"height:19px\"></div><span class=\"fplab\">11時</span></div><div class=\"fpcol\"><div class=\"fpbar\" style=\"height:44px\"></div><span class=\"fplab\">12時半</span></div><div class=\"fpcol\"><div class=\"fpbar\" style=\"height:15px\"></div><span class=\"fplab\"></span></div><div class=\"fpcol\"><div class=\"fpbar\" style=\"height:20px\"></div><span class=\"fplab\">13時半</span></div><div class=\"fpcol\"><div class=\"fpbar\" style=\"height:21px\"></div><span class=\"fplab\"></span></div><div class=\"fpcol\"><div class=\"fpbar\" style=\"height:14px\"></div><span class=\"fplab\">14時半</span></div><div class=\"fpcol\"><div class=\"fpbar\" style=\"height:34px\"></div><span class=\"fplab\">引け</span></div></div><div class=\"fplegend\">時間帯ごとの出来高（どの時間に売買が集中したか）</div><div class=\"fact\"><span>この日の値動き</span><span class=\"num\">+2.2%（値幅3.2%）</span></div><div class=\"fact\"><span>出来高（普段の日足平均との比）</span><span class=\"num\">0.3倍</span></div><div class=\"fact\"><span>終値とVWAP（1日の平均約定価格）の差</span><span class=\"num\">-0.03%</span></div><div class=\"fact\"><span>寄り30分／引け30分の出来高シェア</span><span class=\"num\">18% ／ 13%</span></div><div class=\"fsub\">裏にいそうな売買主体（機械推定・上位2件）</div><div class=\"discnote\">典型パターンとの一致が弱く、特定の主体色は薄い1日でした（様子見・閑散）。</div><div class=\"discnote\">リアルタイムの板（気配値・注文残）は取引所の有料データのため、場中の5分足の値動きと出来高の「形」から典型パターンとの一致度で推定しています。実際の注文主体を特定するものではありません。寄り集中＝個人の飛びつき、引け集中＋VWAP沿い＝機関の執行、出来高増なのに値幅が静か＝大口の仕込み、といった市場の経験則を採点式にしたものです。</div><div class=\"spwrap\"><div class=\"nhead\">値動きと長期支持帯<span class=\"spbtns\"><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, '1')\">1年</button><button type=\"button\" class=\"spbtn on\" onclick=\"spSwap(this, '3')\">3年</button><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, '10')\">10年</button></span></div><div class=\"spark spv\" data-sp=\"1\" style=\"display:none\"><svg viewBox=\"0 0 320 110\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:100%; height:auto; background:#fffdf6; border-radius:8px;\"><polyline points=\"4.0,97.2 7.9,90.3 11.8,85.6 15.7,90.3 19.6,89.4 23.5,80.5 27.4,81.1 31.3,83.6 35.2,85.5 39.1,87.6 43.0,88.5 46.9,80.9 50.8,76.3 54.7,76.4 58.6,84.5 62.5,88.9 66.4,81.1 70.3,82.7 74.2,81.7 78.1,87.0 82.0,87.6 85.9,84.4 89.8,87.6 93.7,95.8 97.6,95.1 101.5,94.9 105.4,92.0 109.3,95.2 113.2,96.2 117.1,92.1 121.0,44.4 124.9,42.1 128.8,44.8 132.7,53.5 136.6,57.7 140.5,54.2 144.4,65.3 148.3,52.4 152.2,57.7 156.1,58.5 160.0,57.5 163.9,38.9 167.8,12.8 171.7,15.0 175.6,26.4 179.5,25.7 183.4,33.2 187.3,45.0 191.2,43.8 195.1,47.2 199.0,45.5 202.9,27.2 206.8,32.7 210.7,29.8 214.6,46.3 218.5,44.9 222.4,41.0 226.3,32.2 230.2,20.1 234.1,22.4 238.0,16.5 241.9,17.9 245.8,15.7 249.7,21.1 253.6,16.5 257.5,20.1 261.4,16.6 265.3,29.5 269.2,35.4 273.1,31.1 277.0,30.7 280.9,42.1 284.8,54.2 288.7,68.3 292.6,50.4 296.5,51.1 300.4,67.2 304.3,71.0 308.2,75.2 312.1,81.3 316.0,77.0\" fill=\"none\" stroke=\"#1c1c1e\" stroke-width=\"1.6\"/><circle cx=\"316.0\" cy=\"77.0\" r=\"4\" fill=\"#1c1c1e\"/></svg></div><div class=\"spark spv\" data-sp=\"3\" style=\"display:\"><svg viewBox=\"0 0 320 110\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:100%; height:auto; background:#fffdf6; border-radius:8px;\"><polyline points