nd:#f2c4a8\"></div><div class=\"mpin\" style=\"left:61.5%\"></div></div><span class=\"mv num\">6.2%</span></div><div class=\"mrow\"><span class=\"ml\">HV(年率変動)</span><div class=\"mtrack\"><div class=\"mz\" style=\"left:0.0%; width:20.8%; background:#b9dcc0\"></div><div class=\"mz\" style=\"left:20.8%; width:12.5%; background:#eeeae0\"></div><div class=\"mz\" style=\"left:33.3%; width:16.7%; background:#f5e6b3\"></div><div class=\"mz\" style=\"left:50.0%; width:50.0%; background:#f2c4a8\"></div><div class=\"mpin\" style=\"left:38.9%\"></div></div><span class=\"mv num\">47%</span></div><div class=\"mrow\"><span class=\"ml\">OBV(20日)</span><div class=\"mtrack\"><div class=\"mz\" style=\"left:0.0%; width:40.0%; background:#f2c4a8\"></div><div class=\"mz\" style=\"left:40.0%; width:10.0%; background:#f5e6b3\"></div><div class=\"mz\" style=\"left:50.0%; width:10.0%; background:#eeeae0\"></div><div class=\"mz\" style=\"left:60.0%; width:40.0%; background:#b9dcc0\"></div><div class=\"mpin\" style=\"left:26.4%\"></div></div><span class=\"mv num\">-24%</span></div><div class=\"mrow\"><span class=\"ml\">自己資本比率</span><div class=\"mtrack\"><div class=\"mz\" style=\"left:0.0%; width:20.0%; background:#f2c4a8\"></div><div class=\"mz\" style=\"left:20.0%; width:15.0%; background:#f5e6b3\"></div><div class=\"mz\" style=\"left:35.0%; width:15.0%; background:#eeeae0\"></div><div class=\"mz\" style=\"left:50.0%; width:50.0%; background:#b9dcc0\"></div><div class=\"mpin\" style=\"left:37.9%\"></div></div><span class=\"mv num\">38%</span></div><div class=\"mrow\"><span class=\"ml\">営業利益率</span><div class=\"mtrack\"><div class=\"mz\" style=\"left:0.0%; width:25.0%; background:#f2c4a8\"></div><div class=\"mz\" style=\"left:25.0%; width:12.5%; background:#f5e6b3\"></div><div class=\"mz\" style=\"left:37.5%; width:12.5%; background:#eeeae0\"></div><div class=\"mz\" style=\"left:50.0%; width:50.0%; background:#b9dcc0\"></div><div class=\"mpin\" style=\"left:32.0%\"></div></div><span class=\"mv num\">2.8%</span></div><div class=\"mrow\"><span class=\"ml\">ROA</span><div class=\"mtrack\"><div class=\"mz\" style=\"left:0.0%; width:20.0%; background:#f2c4a8\"></div><div class=\"mz\" style=\"left:20.0%; width:8.0%; background:#f5e6b3\"></div><div class=\"mz\" style=\"left:28.0%; width:12.0%; background:#eeeae0\"></div><div class=\"mz\" style=\"left:40.0%; width:60.0%; background:#b9dcc0\"></div><div class=\"mpin\" style=\"left:34.0%\"></div></div><span class=\"mv num\">3.5%</span></div><div class=\"mrow\"><span class=\"ml\">配当性向</span><div class=\"mtrack\"><div class=\"mz\" style=\"left:0.0%; width:20.0%; background:#eeeae0\"></div><div class=\"mz\" style=\"left:20.0%; width:20.0%; background:#b9dcc0\"></div><div class=\"mz\" style=\"left:40.0%; width:26.7%; background:#f5e6b3\"></div><div class=\"mz\" style=\"left:66.7%; width:33.3%; background:#f2c4a8\"></div><div class=\"mpin\" style=\"left:13.1%\"></div></div><span class=\"mv num\">20%</span></div><div class=\"mrow\"><span class=\"ml\">PEG</span><div class=\"mtrack\"><div class=\"mz\" style=\"left:0.0%; width:20.0%; background:#c9dcf3\"></div><div class=\"mz\" style=\"left:20.0%; width:20.0%; background:#b9dcc0\"></div><div class=\"mz\" style=\"left:40.0%; width:20.0%; background:#f5e6b3\"></div><div class=\"mz\" style=\"left:60.0%; width:40.0%; background:#f2c4a8\"></div><div class=\"mpin\" style=\"left:2.0%\"></div></div><span class=\"mv num\">0.10</span></div></div><div class=\"discnote\">ピンが現在値。PER・PBRなど価値系は「標準」が最も安心、割安は魅力だが「割安の罠」の確認が必要。RSI・ボリンジャーなど行きすぎ系は売られすぎ側が押し目買いに有利。読み方は「指標の読み方」ページへ。</div><div class=\"nhead\">除外理由</div><div class=\"reason\">・下げ止まり未確認（前日から安値を切り下げ中）</div><div class=\"nhead\">減点方式: 全体80位（−8点）</div><div class=\"hit\"><span class=\"sev sevC\">軽い</span>下げ止まり未確認（前日から安値切り下げ）<span class=\"num hp\">−8</span></div><div class=\"nhead\">TOB素地スコア: 50点（全体916位）</div><div class=\"reason\">・PBR 0.74倍 ＝ 解散価値を大きく下回る（+16）</div><div class=\"reason\">・時価総額 671億円 ＝ TOB・MBOの主戦場サイズ（+15）</div><div class=\"reason\">・配当性向 20% ＝ 黒字なのに還元が渋い（+5）</div><div class=\"reason\">・株価は1年レンジの下位25%に放置（+6）</div><div class=\"reason\">・プライムでPBR1倍割れ ＝ 東証の改善要請が直撃（+4）</div><div class=\"reason\">・PER 8.0倍 ＝ 利益面でも割安（+4）</div><div class=\"discnote\">買収・非公開化されやすい「体質」の順位で、発生の予測ではありません。全体像と注意点は上部タブの「TOB素地」ページへ。</div><div class=\"nhead\">業績の推移（四半期開示の推移（累計ベース）・決算短信より）</div><div class=\"finchart\"><svg viewBox=\"0 0 340 150\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:100%; height:auto; background:#fffdf6; border-radius:8px;\"><rect x=\"153.0\" y=\"17.2\" width=\"34.0\" height=\"112.8\" rx=\"2\" fill=\"#cfe0f5\"><title>26/6 売上高 1,246億円</title></rect><text x=\"170.0\" y=\"144\" font-size=\"8.5\" fill=\"#a99a76\" text-anchor=\"middle\">26/6</text><text x=\"303\" y=\"25.2\" font-size=\"8\" fill=\"#7ba0cc\">1,246億</text><text x=\"303\" y=\"132\" font-size=\"8\" fill=\"#7ba0cc\">売上</text><text x=\"4\" y=\"25.2\" font-size=\"8\" fill=\"#8a6f4d\">84億</text><text x=\"4\" y=\"132\" font-size=\"8\" fill=\"#8a6f4d\">利益</text></svg></div><div class=\"finlg\"><span><i style=\"background:#cfe0f5\"></i>売上高（右軸）</span></div><div class=\"finrow finhead\"><span class=\"fp\"></span><span class=\"fc\">売上高</span><span class=\"fc\">営業利益</span><span class=\"fc\">純利益</span></div><div class=\"finrow\"><span class=\"fp\">26/6</span><span class=\"fc\">1,246億円</span><span class=\"fc\">35億円</span><span class=\"fc\">84億円</span></div><div class=\"discnote\">グラフの棒・点にカーソルを合わせると数値が出ます。決算履歴は毎晩の実行で自動蓄積され、期間は時間とともに伸びていきます。</div><div class=\"nhead\">ファンダメンタル指標</div><div class=\"fact\"><span>PER</span><span class=\"num\">8.0倍</span></div><div class=\"fact\"><span>PBR</span><span class=\"num\">0.74倍</span></div><div class=\"fact\"><span>ROE</span><span class=\"num\">9.3%</span></div><div class=\"fact\"><span>配当利回り</span><span class=\"num\">2.47%</span></div><div class=\"fact\"><span>時価総額</span><span class=\"num\">671億円</span></div><div class=\"nhead\">アナリスト・コンセンサス（証券会社レーティング）</div><div class=\"discnote\">この銘柄は現時点で<b>カバレッジ対象外</b>です（証券会社アナリストによる平均評価・平均目標株価の公表データがありません）。レーティングは主に中大型株が対象で、小型株はカバーされないことが多くあります。データが取得でき次第、ここに自動で表示されます。</div><div class=\"nhead\">板・売買フローの推定（AI）</div><div class=\"discnote\">この銘柄は本日の分析対象外です（今夜の厳選・出尽くしサイン・レーティング変化・注目開示などの注目銘柄のみ、毎晩の実行で場中の5分足を取得して分析します）。</div><div class=\"spwrap\"><div class=\"nhead\">値動きと長期支持帯<span class=\"spbtns\"><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, '1')\">1年</button><button type=\"button\" class=\"spbtn on\" onclick=\"spSwap(this, '3')\">3年</button><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, '10')\">10年</button></span></div><div class=\"spark spv\" data-sp=\"1\" style=\"display:none\"><svg viewBox=\"0 0 320 110\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:100%; height:auto; background:#fffdf6; border-radius:8px;\"><polyline points=\"4.0,97.2 8.0,90.3 12.0,85.6 16.0,90.3 20.0,89.4 24.0,80.5 28.0,81.1 32.0,83.6 36.0,85.5 40.0,87.6 44.0,88.5 48.0,80.9 52.0,76.3 56.0,76.4 60.0,84.5 64.0,88.9 68.0,81.1 72.0,82.7 76.0,81.7 80.0,87.0 84.0,87.6 88.0,84.4 92.0,87.6 96.0,95.8 100.0,95.1 104.0,94.9 108.0,92.0 112.0,95.2 116.0,96.2 120.0,92.1 124.0,44.4 128.0,42.1 132.0,44.8 136.0,53.5 140.0,57.7 144.0,54.2 148.0,65.3 152.0,52.4 156.0,57.7 160.0,58.5 164.0,57.5 168.0,38.9 172.0,12.8 176.0,15.0 180.0,26.4 184.0,25.7 188.0,33.2 192.0,45.0 196.0,43.8 200.0,47.2 204.0,45.5 208.0,27.2 212.0,32.7 216.0,29.8 220.0,46.3 224.0,44.9 228.0,41.0 232.0,32.2 236.0,20.1 240.0,22.4 244.0,16.5 248.0,17.9 252.0,15.7 256.0,21.1 260.0,16.5 264.0,20.1 268.0,16.6 272.0,29.5 276.0,35.4 280.0,31.1 284.0,30.7 288.0,42.1 292.0,54.2 296.0,68.3 300.0,50.4 304.0,51.1 308.0,67.2 312.0,71.0 316.0,82.6\" fill=\"none\" stroke=\"#1c1c1e\" stroke-width=\"1.6\"/><circle cx=\"316.0\" cy=\"82.6\" r=\"4\" fill=\"#1c1c1e\"/></svg></div><div class=\"spark spv\" data-sp=\"3\" style=\"display:\"><svg viewBox=\"0 0 320 110\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:100%; height:auto; background:#fffdf6; border-radius:8px;\"><polyline points=\