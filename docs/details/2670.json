ns\"><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, '1')\">1年</button><button type=\"button\" class=\"spbtn on\" onclick=\"spSwap(this, '3')\">3年</button><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, '10')\">10年</button><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, 'all')\">全期間(24年)</button></span></div><div class=\"spark spv\" data-sp=\"1\" style=\"display:none\"><svg viewBox=\"0 0 320 110\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:100%; height:auto; background:#fffdf6; border-radius:8px;\"><rect x=\"0\" y=\"81.2\" width=\"320\" height=\"16.0\" fill=\"#c62f2f\" opacity=\"0.12\"/><polyline points=\"4.0,12.8 9.1,20.6 14.2,30.7 19.3,32.9 24.5,57.9 29.6,56.8 34.7,50.9 39.8,64.2 44.9,67.7 50.0,63.5 55.1,66.0 60.3,58.0 65.4,58.6 70.5,61.0 75.6,55.8 80.7,59.6 85.8,59.1 91.0,60.5 96.1,61.1 101.2,80.8 106.3,83.0 111.4,86.5 116.5,84.9 121.6,70.6 126.8,64.8 131.9,69.0 137.0,67.8 142.1,83.4 147.2,75.2 152.3,75.8 157.4,83.5 162.6,79.4 167.7,74.5 172.8,59.9 177.9,43.0 183.0,32.9 188.1,47.1 193.2,61.5 198.4,56.9 203.5,58.3 208.6,64.3 213.7,67.4 218.8,77.1 223.9,55.5 229.0,52.9 234.2,55.9 239.3,51.2 244.4,45.2 249.5,31.6 254.6,67.3 259.7,63.8 264.9,66.1 270.0,39.4 275.1,54.4 280.2,42.5 285.3,47.1 290.4,46.1 295.5,48.2 300.7,61.9 305.8,56.3 310.9,58.2 316.0,59.5\" fill=\"none\" stroke=\"#1c1c1e\" stroke-width=\"1.6\"/><path d=\"M 4.0 24.8 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 4.0 24.8 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 4.0 24.8 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 116.5 96.9 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 147.2 87.2 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 218.8 89.1 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><circle cx=\"316.0\" cy=\"59.5\" r=\"4\" fill=\"#1c1c1e\"/></svg></div><div class=\"spark spv\" data-sp=\"3\" style=\"display:\"><svg viewBox=\"0 0 320 110\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:100%; height:auto; background:#fffdf6; border-radius:8px;\"