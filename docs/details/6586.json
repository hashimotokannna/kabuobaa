ーティング変化・注目開示などの注目銘柄のみ、毎晩の実行で場中の5分足を取得して分析します）。</div><div class=\"spwrap\"><div class=\"nhead\">値動きと長期支持帯<span class=\"spbtns\"><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, '1')\">1年</button><button type=\"button\" class=\"spbtn on\" onclick=\"spSwap(this, '3')\">3年</button><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, '10')\">10年</button><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, 'all')\">全期間(26年)</button></span></div><div class=\"spark spv\" data-sp=\"1\" style=\"display:none\"><svg viewBox=\"0 0 320 110\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:100%; height:auto; background:#fffdf6; border-radius:8px;\"><rect x=\"0\" y=\"59.4\" width=\"320\" height=\"17.6\" fill=\"#c62f2f\" opacity=\"0.12\"/><polyline points=\"4.0,69.4 9.1,72.2 14.2,74.4 19.3,68.0 24.5,72.8 29.6,67.8 34.7,70.4 39.8,85.2 44.9,87.2 50.0,89.0 55.1,97.2 60.3,86.9 65.4,93.0 70.5,82.3 75.6,68.3 80.7,75.2 85.8,76.8 91.0,73.5 96.1,64.2 101.2,63.8 106.3,70.6 111.4,79.7 116.5,36.0 121.6,17.4 126.8,18.7 131.9,17.3 137.0,12.8 142.1,30.6 147.2,38.7 152.3,47.1 157.4,52.9 162.6,59.4 167.7,49.2 172.8,36.2 177.9,32.7 183.0,37.8 188.1,45.7 193.2,24.8 198.4,25.6 203.5,30.6 208.6,31.6 213.7,37.7 218.8,45.5 223.9,42.4 229.0,26.8 234.2,20.4 239.3,24.3 244.4,25.8 249.5,27.8 254.6,34.6 259.7,32.8 264.9,22.1 270.0,54.5 275.1,40.6 280.2,41.9 285.3,59.4 290.4,48.4 295.5,48.9 300.7,51.4 305.8,54.7 310.9,48.9 316.0,44.3\" fill=\"none\" stroke=\"#1c1c1e\" stroke-width=\"1.6\"/><path d=\"M 4.0 81.4 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 4.0 81.4 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 162.6 71.4 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 270.0 66.5 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 285.3 71.4 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><circle cx=\"316.0\" cy=\"44.3\" r=\"4\" fill=\"#1c1c1e\"/></svg></div><div class=\"spark spv\" data-sp=\"3\" style=\"display:\"><svg viewBox=\"0 0 320 110\" xmlns=\"http://www.w3.org/2000/svg\" style=\"