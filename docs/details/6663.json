eft:36.8%\"></div></div><span class=\"mv num\">4.7%</span></div><div class=\"mrow\"><span class=\"ml\">ROA</span><div class=\"mtrack\"><div class=\"mz\" style=\"left:0.0%; width:20.0%; background:#f2c4a8\"></div><div class=\"mz\" style=\"left:20.0%; width:8.0%; background:#f5e6b3\"></div><div class=\"mz\" style=\"left:28.0%; width:12.0%; background:#eeeae0\"></div><div class=\"mz\" style=\"left:40.0%; width:60.0%; background:#b9dcc0\"></div><div class=\"mpin\" style=\"left:23.2%\"></div></div><span class=\"mv num\">0.8%</span></div><div class=\"mrow\"><span class=\"ml\">配当性向</span><div class=\"mtrack\"><div class=\"mz\" style=\"left:0.0%; width:20.0%; background:#eeeae0\"></div><div class=\"mz\" style=\"left:20.0%; width:20.0%; background:#b9dcc0\"></div><div class=\"mz\" style=\"left:40.0%; width:26.7%; background:#f5e6b3\"></div><div class=\"mz\" style=\"left:66.7%; width:33.3%; background:#f2c4a8\"></div><div class=\"mpin\" style=\"left:30.8%\"></div></div><span class=\"mv num\">46%</span></div><div class=\"mrow\"><span class=\"ml\">PEG</span><div class=\"mtrack\"><div class=\"mz\" style=\"left:0.0%; width:20.0%; background:#c9dcf3\"></div><div class=\"mz\" style=\"left:20.0%; width:20.0%; background:#b9dcc0\"></div><div class=\"mz\" style=\"left:40.0%; width:20.0%; background:#f5e6b3\"></div><div class=\"mz\" style=\"left:60.0%; width:40.0%; background:#f2c4a8\"></div><div class=\"mpin\" style=\"left:8.6%\"></div></div><span class=\"mv num\">0.43</span></div></div><div class=\"discnote\">ピンが現在値。PER・PBRなど価値系は「標準」が最も安心、割安は魅力だが「割安の罠」の確認が必要。RSI・ボリンジャーなど行きすぎ系は売られすぎ側が押し目買いに有利。読み方は「指標の読み方」ページへ。</div><div class=\"nhead\">対象外の理由</div><div class=\"reason\">・流動性不足</div><div class=\"nhead\">減点方式: 全体3,655位（−128点）</div><div class=\"hit\"><span class=\"sev sevB\">重い</span>ROE 1.4%と稼ぐ力が弱い<span class=\"num hp\">−12</span></div><div class=\"hit\"><span class=\"sev sevB\">重い</span>時価総額16億円と小型で値が飛びやすい<span class=\"num hp\">−10</span></div><div class=\"hit\"><span class=\"sev sevA\"