の5分足を取得して分析します）。</div><div class=\"spwrap\"><div class=\"nhead\">値動きと長期支持帯<span class=\"spbtns\"><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, '1')\">1年</button><button type=\"button\" class=\"spbtn on\" onclick=\"spSwap(this, '3')\">3年</button><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, '10')\">10年</button><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, 'all')\">全期間(21年)</button></span></div><div class=\"spark spv\" data-sp=\"1\" style=\"display:none\"><svg viewBox=\"0 0 320 110\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:100%; height:auto; background:#fffdf6; border-radius:8px;\"><rect x=\"0\" y=\"39.2\" width=\"320\" height=\"12.399999999999999\" fill=\"#c62f2f\" opacity=\"0.12\"/><polyline points=\"4.0,59.2 9.1,64.7 14.2,62.5 19.3,39.4 24.5,30.7 29.6,31.5 34.7,35.4 39.8,38.1 44.9,27.4 50.0,24.5 55.1,22.6 60.3,26.6 65.4,22.4 70.5,33.3 75.6,38.1 80.7,45.5 85.8,47.6 91.0,47.1 96.1,78.4 101.2,82.0 106.3,71.4 111.4,81.6 116.5,84.0 121.6,92.5 126.8,93.7 131.9,97.2 137.0,84.7 142.1,84.4 147.2,86.1 152.3,81.7 157.4,88.6 162.6,87.8 167.7,84.4 172.8,75.7 177.9,85.6 183.0,79.8 188.1,87.3 193.2,74.0 198.4,79.6 203.5,84.8 208.6,79.0 213.7,68.7 218.8,60.1 223.9,60.5 229.0,51.5 234.2,52.9 239.3,55.4 244.4,59.7 249.5,33.7 254.6,28.5 259.7,16.3 264.9,12.8 270.0,14.9 275.1,26.4 280.2,17.3 285.3,21.2 290.4,34.5 295.5,38.4 300.7,32.6 305.8,23.2 310.9,17.5 316.0,24.2\" fill=\"none\" stroke=\"#1c1c1e\" stroke-width=\"1.6\"/><path d=\"M 4.0 71.2 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 4.0 71.2 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 34.7 47.4 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 275.1 38.4 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 295.5 50.4 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><circle cx=\"316.0\" cy=\"24.2\" r=\"4\" fill=\"#1c1c1e\"/></svg></div><div class=\"spark spv\" data-sp=\"3\" style=\"display:\"><svg viewBox=\"0 0 320 110\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:100%; heigh