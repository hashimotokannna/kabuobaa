ckground:#eeeae0\"></div><div class=\"mz\" style=\"left:70.0%; width:10.0%; background:#f5e6b3\"></div><div class=\"mz\" style=\"left:80.0%; width:20.0%; background:#f2c4a8\"></div><div class=\"mpin\" style=\"left:86.4%\"></div></div><span class=\"mv num\">86</span></div><div class=\"mrow\"><span class=\"ml\">ADX(トレンド強さ)</span><div class=\"mtrack\"><div class=\"mz\" style=\"left:0.0%; width:33.3%; background:#eeeae0\"></div><div class=\"mz\" style=\"left:33.3%; width:8.3%; background:#f5e6b3\"></div><div class=\"mz\" style=\"left:41.7%; width:58.3%; background:#b9dcc0\"></div><div class=\"mpin\" style=\"left:43.8%\"></div></div><span class=\"mv num\">26↑</span></div><div class=\"mrow\"><span class=\"ml\">一目・雲</span><div class=\"mtrack\"><div class=\"mz\" style=\"left:0.0%; width:33.3%; background:#f2c4a8\"></div><div class=\"mz\" style=\"left:33.3%; width:33.3%; background:#f5e6b3\"></div><div class=\"mz\" style=\"left:66.7%; width:33.3%; background:#b9dcc0\"></div><div class=\"mpin\" style=\"left:83.3%\"></div></div><span class=\"mv num\">雲の上</span></div><div class=\"mrow\"><span class=\"ml\">ATR(日々の値幅)</span><div class=\"mtrack\"><div class=\"mz\" style=\"left:0.0%; width:20.0%; background:#b9dcc0\"></div><div class=\"mz\" style=\"left:20.0%; width:15.0%; background:#eeeae0\"></div><div class=\"mz\" style=\"left:35.0%; width:15.0%; background:#f5e6b3\"></div><div class=\"mz\" style=\"left:50.0%; width:50.0%; background:#f2c4a8\"></div><div class=\"mpin\" style=\"left:24.1%\"></div></div><span class=\"mv num\">2.4%</span></div><div class=\"mrow\"><span class=\"ml\">HV(年率変動)</span><div class=\"mtrack\"><div class=\"mz\" style=\"left:0.0%; width:20.8%; background:#b9dcc0\"></div><div class=\"mz\" style=\"left:20.8%; width:12.5%; background:#eeeae0\"></div><div class=\"mz\" style=\"left:33.3%; width:16.7%; background:#f5e6b3\"></div><div class=\"mz\" style=\"left:50.0%; width:50.0%; background:#f2c4a8\"></div><div class=\"mpin\" style=\"left:23.8%\"></div></div><span class=\"mv num\">28%</span></div><div class=\"mrow\"><span class=\"ml\">OBV(20日)</span><div class=\"mtrack\"><div class=\"mz\" style=\"left:0.0%; width:40.0%; background:#f2c4a8\"></div><div class=\"mz\" style=\"left:40.0%; width:10.0%; background:#f5e6b3\"></div><div class=\"mz\" style=\"left:50.0%; width:10.0%; background:#eeeae0\"></div><div class=\"mz\" style=\"left:60.0%; width:40.0%; background:#b9dcc0\"></div><div class=\"mpin\" style=\"left:53.6%\"></div></div><span class=\"mv num\">+4%</span></div></div><div class=\"discnote\">ピンが現在値。PER・PBRなど価値系は「標準」が最も安心、割安は魅力だが「割安の罠」の確認が必要。RSI・ボリンジャーなど行きすぎ系は売られすぎ側が押し目買いに有利。読み方は「指標の読み方」ページへ。</div><div class=\"nhead\">スコア 117点（候補圏外）</div><div class=\"reason\">・直近20日高値から −0.1%（安さの主基準 +1点・8%で頭打ち）</div><div class=\"reason\">・下げが複数日に分散した「じわ下げ」で、1日の急落で作られた安さではない（+15点）</div><div class=\"reason\">・日々の値動きが±1.8%と穏やかで読みやすい（+10点）</div><div class=\"reason\">・200日平均線より上での下げ＝上昇トレンド中の一時的な押し目（+20点）</div><div class=\"reason\">・1年高値からの下落 −0% で長期トレンド健全（+12点）</div><div class=\"reason\">・過去1年、同じ買い方で 4回 利確ライン（+5%）に到達（+20点）</div><div class=\"reason\">・利確まで平均 50営業日と資金拘束が長め。短期回転スタイルでは機会損失（−5点）</div><div class=\"reason\">・50日線が200日線の上（ゴールデンクロス継続中の長期上昇形 +10点）</div><div class=\"reason\">・W底（ダブルボトム）を形成しネックライン3,190円を上抜け（+8点）</div><div class=\"reason\">・直近に出来高急増+長い下ヒゲ（セリングクライマックス=投げ売り一巡の兆候 +6点）</div><div class=\"reason\">・MACDがシグナル線の上で上向き（+4点）</div><div class=\"reason\">・ADX 26・+DI優勢＝上昇トレンドに勢いがある中の押し目（+4点）</div><div class=\"reason\">・一目均衡表の雲の上（中期の地合いは良好 +4点）</div><div class=\"reason\">・ファンダ指標が本日取得できず中立扱い（加減点なし）</div><div class=\"reason\">・夜間ギャップ（翌朝の窓開け）平均±0.8%と小さく、夜に決めた指値が翌朝も有効に働きやすい（+8点）</div><div class=\"nhead\">減点方式: 全体1,295位（−27点）</div><div class=\"hit\"><span class=\"sev sevB\">重い</span>売買代金が1日1億円未満（約定しにくい）<span class=\"num hp\">−10</span></div><div class=\"hit\"><span class=\"sev sevC\">軽い</span>RSI 88 の買われすぎ<span class=\"num hp\">−6</span></div><div class=\"hit\"><span class=\"sev sevC\">軽い</span>ボリンジャー+2σ超（統計的な買われすぎ）<span class=\"num hp\">−6</span></div><div class=\"hit\"><span class=\"sev sevC\">軽い</span>利確まで平均50日と資金拘束が長い<span class=\"num hp\">−5</span></div><div class=\"nhead\">アナリスト・コンセンサス（証券会社レーティング）</div><div class=\"discnote\">この銘柄は現時点で<b>カバレッジ対象外</b>です（証券会社アナリストによる平均評価・平均目標株価の公表データがありません）。レーティングは主に中大型株が対象で、小型株はカバーされないことが多くあります。データが取得でき次第、ここに自動で表示されます。</div><div class=\"nhead\">板・売買フローの推定（AI）</div><div class=\"discnote\">この銘柄は本日の分析対象外です（今夜の厳選・出尽くしサイン・レーティング変化・注目開示などの注目銘柄のみ、毎晩の実行で場中の5分足を取得して分析します）。</div><div class=\"spwrap\"><div class=\"nhead\">値動きと長期支持帯<span class=\"spbtns\"><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, '1')\">1年</button><button type=\"button\" class=\"spbtn on\" onclick=\"spSwap(this, '3')\">3年</button><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, '10')\">10年</button><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, 'all')\">全期間(26年)</button></span></div><div class=\"spark spv\" data-sp=\"1\" style=\"display:none\"><svg viewBox=\"0 0 320 110\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:100%; height:auto; background:#fffdf6; border-radius:8px;\"><polyline points=\"4.0,71.7 9.1,65.9 14.2,74.2 19.3,74.3 24.5,66.4 29.6,64.4 34.7,49.8 39.8,47.8 44.9,49.9 50.0,47.4 55.1,51.0 60.3,51.6 65.4,57.8 70.5,61.3 75.6,52.4 80.7,48.9 85.8,47.4 91.0,53.5 96.1,47.4 101.2,47.8 106.3,40.6 111.4,41.3 116.5,50.4 121.6,52.7 126.8,61.2 131.9,66.2 137.0,54.8 142.1,60.3 147.2,61.4 152.3,69.8 157.4,69.7 162.6,83.4 167.7,81.6 172.8,78.6 177.9,80.2 183.0,78.5 188.1,83.4 193.2,92.0 198.4,97.2 203.5,92.8 208.6,92.5 213.7,95.7 218.8,88.6 223.9,82.4 229.0,79.5 234.2,79.2 239.3,74.8 244.4,58.4 249.5,59.7 254.6,49.6 259.7,57.5 264.9,53.5 270.0,52.2 275.1,50.0 280.2,56.7 285.3,53.6 290.4,44.2 295.5,47.1 300.7,51.4 305.8,46.4 310.9,30.5 316.0,12.8\" fill=\"none\" stroke=\"#1c1c1e\" stroke-width=\"1.6\"/><circle cx=\"316.0\" cy=\"12.8\" r=\"4\" fill=\"#1c1c1e\"/></svg></div><div class=\"spark spv\" data-sp=\"3\" style=\"display:\"><svg viewBox=\"0 0 320 110\" xmlns