（今夜の厳選・出尽くしサイン・レーティング変化・注目開示などの注目銘柄のみ、毎晩の実行で場中の5分足を取得して分析します）。</div><div class=\"spwrap\"><div class=\"nhead\">値動きと長期支持帯<span class=\"spbtns\"><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, '1')\">1年</button><button type=\"button\" class=\"spbtn on\" onclick=\"spSwap(this, '3')\">3年</button><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, '10')\">10年</button><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, 'all')\">全期間(23年)</button></span></div><div class=\"spark spv\" data-sp=\"1\" style=\"display:none\"><svg viewBox=\"0 0 320 110\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:100%; height:auto; background:#fffdf6; border-radius:8px;\"><rect x=\"0\" y=\"81.3\" width=\"320\" height=\"15.900000000000006\" fill=\"#c62f2f\" opacity=\"0.12\"/><polyline points=\"4.0,40.5 9.1,46.1 14.2,29.9 19.3,35.4 24.5,40.9 29.6,28.5 34.7,33.9 39.8,37.6 44.9,28.6 50.0,32.7 55.1,27.6 60.3,27.2 65.4,24.5 70.5,12.8 75.6,20.0 80.7,37.0 85.8,46.8 91.0,47.0 96.1,50.2 101.2,45.1 106.3,60.9 111.4,76.4 116.5,75.1 121.6,82.8 126.8,85.6 131.9,93.8 137.0,76.6 142.1,72.4 147.2,73.9 152.3,70.3 157.4,72.0 162.6,73.0 167.7,67.9 172.8,61.8 177.9,73.0 183.0,73.1 188.1,81.6 193.2,76.1 198.4,77.1 203.5,79.1 208.6,76.7 213.7,65.8 218.8,62.3 223.9,47.2 229.0,60.2 234.2,48.8 239.3,47.0 244.4,45.6 249.5,41.0 254.6,37.5 259.7,36.0 264.9,38.4 270.0,34.6 275.1,50.9 280.2,53.8 285.3,48.7 290.4,52.9 295.5,54.5 300.7,37.7 305.8,47.3 310.9,51.4 316.0,53.0\" fill=\"none\" stroke=\"#1c1c1e\" stroke-width=\"1.6\"/><path d=\"M 4.0 52.5 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 4.0 52.5 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 4.0 52.5 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 111.4 88.4 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 131.9 105.8 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 188.1 93.6 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><circle cx=\"316.0\" cy=\"53.0\" r=\"4\" fill=\"#1c1c1e\"/></svg></div><div class=\"spark spv\" data-sp=\"3\" style