>板・売買フローの推定（AI）</div><div class=\"discnote\">この銘柄は本日の分析対象外です（今夜の厳選・出尽くしサイン・レーティング変化・注目開示などの注目銘柄のみ、毎晩の実行で場中の5分足を取得して分析します）。</div><div class=\"spwrap\"><div class=\"nhead\">値動きと長期支持帯<span class=\"spbtns\"><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, '1')\">1年</button><button type=\"button\" class=\"spbtn on\" onclick=\"spSwap(this, '3')\">3年</button><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, '10')\">10年</button><button type=\"button\" class=\"spbtn\" onclick=\"spSwap(this, 'all')\">全期間(23年)</button></span></div><div class=\"spark spv\" data-sp=\"1\" style=\"display:none\"><svg viewBox=\"0 0 320 110\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:100%; height:auto; background:#fffdf6; border-radius:8px;\"><rect x=\"0\" y=\"87.2\" width=\"320\" height=\"10.0\" fill=\"#c62f2f\" opacity=\"0.12\"/><polyline points=\"4.0,12.8 9.1,20.5 14.2,52.3 19.3,54.5 24.5,67.7 29.6,61.7 34.7,55.2 39.8,58.6 44.9,60.0 50.0,57.0 55.1,56.8 60.3,62.1 65.4,59.7 70.5,56.7 75.6,49.0 80.7,53.1 85.8,49.6 91.0,45.7 96.1,56.0 101.2,60.4 106.3,65.5 111.4,68.3 116.5,66.8 121.6,65.5 126.8,87.5 131.9,84.3 137.0,86.2 142.1,89.0 147.2,93.3 152.3,88.8 157.4,77.8 162.6,83.1 167.7,79.6 172.8,81.2 177.9,79.3 183.0,76.4 188.1,77.6 193.2,79.7 198.4,81.3 203.5,81.1 208.6,87.0 213.7,84.7 218.8,86.1 223.9,85.1 229.0,76.7 234.2,74.3 239.3,78.7 244.4,67.1 249.5,76.0 254.6,66.3 259.7,72.3 264.9,63.3 270.0,63.1 275.1,56.4 280.2,60.6 285.3,65.0 290.4,60.9 295.5,65.0 300.7,67.5 305.8,71.1 310.9,72.7 316.0,70.2\" fill=\"none\" stroke=\"#1c1c1e\" stroke-width=\"1.6\"/><path d=\"M 4.0 24.8 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 4.0 24.8 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 4.0 24.8 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 126.8 99.5 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 152.3 100.8 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><path d=\"M 203.5 93.1 l 5 8 l -10 0 z\" fill=\"#c62f2f\"/><circle cx=\"316.0\" cy=\"70.2\" r=\"4\" fill=\"#1c1c1e\"/></svg></di